---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact"
  description="Neem contact op met Verkeersschool Pioneers in Breda — via WhatsApp, telefoon, e-mail of het contactformulier. 7 dagen per week bereikbaar."
>
  <!-- Page header -->
  <section class="hero-bg text-white py-16 md:py-20 relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="orb-drift absolute -top-32 right-0 w-[520px] h-[520px] rounded-full" style="filter:blur(90px); background: radial-gradient(circle, rgba(214,40,57,0.45) 0%, transparent 65%);"></div>
      <div class="orb-drift-slow absolute bottom-0 -left-20 w-[380px] h-[380px] rounded-full" style="filter:blur(90px); background: radial-gradient(circle, rgba(42,67,116,0.55) 0%, transparent 65%);"></div>
    </div>
    <div class="relative z-10 max-w-[1280px] mx-auto px-5 sm:px-8">
      <p class="text-pioneer-red font-semibold text-sm uppercase tracking-widest mb-3">Contact</p>
      <h1 class="font-display font-bold text-4xl md:text-5xl tracking-tight mb-4">
        Neem contact op
      </h1>
      <p class="text-white/65 text-lg max-w-lg">
        Vragen over een pakket? Of direct inschrijven? We staan voor je klaar — 7 dagen per week, ook 's avonds.
      </p>
    </div>
  </section>

  <section class="py-16 md:py-20">
    <div class="max-w-[1280px] mx-auto px-5 sm:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">

        <!-- Contact info -->
        <div>
          <h2 class="font-display font-bold text-2xl tracking-tight mb-6">Contactgegevens</h2>
          <ul class="space-y-5 mb-8">
            <li class="flex items-start gap-3">
              <div class="w-10 h-10 rounded-lg bg-pioneer-navy/8 flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-5 h-5 text-pioneer-red" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
              </div>
              <div>
                <p class="font-semibold text-pioneer-navy text-sm mb-0.5">Telefoon & WhatsApp</p>
                <a href="tel:+31643127001" class="text-asphalt hover:text-pioneer-red transition-colors">+31 (0)64 312 7001</a>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <div class="w-10 h-10 rounded-lg bg-pioneer-navy/8 flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-5 h-5 text-pioneer-red" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </div>
              <div>
                <p class="font-semibold text-pioneer-navy text-sm mb-0.5">E-mail</p>
                <a href="mailto:info@verkeersschoolpioneers.nl" class="text-asphalt hover:text-pioneer-red transition-colors">info@verkeersschoolpioneers.nl</a>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <div class="w-10 h-10 rounded-lg bg-pioneer-navy/8 flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-5 h-5 text-pioneer-red" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z"/>
                </svg>
              </div>
              <div>
                <p class="font-semibold text-pioneer-navy text-sm mb-0.5">Openingstijden (kantoor)</p>
                <p class="text-asphalt">Ma–vr: 08:00–17:00<br>Zaterdag: 08:00–13:00<br>Zondag: gesloten</p>
              </div>
            </li>
          </ul>

          <!-- WhatsApp prominent -->
          <a
            href="https://wa.me/31643127001?text=Hallo%20Verkeersschool%20Pioneers!%20Ik%20heb%20een%20vraag."
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2.5 w-full sm:w-auto justify-center px-6 py-3.5 rounded-lg bg-[#25D366] hover:bg-[#1ebe5d] text-white font-semibold transition-colors shadow-md mb-8"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
              <path d="M5.339 18.706A9.905 9.905 0 0 1 2 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10a9.934 9.934 0 0 1-5.127-1.417L2 22l2.339-3.294z"/>
            </svg>
            Direct chatten via WhatsApp
          </a>

          <!-- Google Maps -->
          <div class="rounded-2xl overflow-hidden aspect-video">
            <iframe
              src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2506047.5311974124!2d2.6459136955944182!3d52.165019841463284!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47c69f1402743c2f%3A0x25b3526874153b79!2sschool%20Pioneers!5e0!3m2!1snl!2snl!4v1782996631908!5m2!1snl!2snl"
              width="100%"
              height="100%"
              style="border:0;"
              allowfullscreen=""
              loading="lazy"
              referrerpolicy="strict-origin-when-cross-origin"
              title="Verkeersschool Pioneers op Google Maps"
            ></iframe>
          </div>
        </div>

        <!-- Contact form -->
        <div>
          <h2 class="font-display font-bold text-2xl tracking-tight mb-6">Stuur een bericht</h2>
          <form
            name="contact"
            method="POST"
            data-netlify="true"
            netlify-honeypot="bot-field"
            class="space-y-5"
          >
            <input type="hidden" name="form-name" value="contact" />
            <p class="hidden">
              <label>Laat dit veld leeg: <input name="bot-field" /></label>
            </p>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="voornaam" class="block text-xs font-semibold text-pioneer-navy uppercase tracking-wider mb-1.5">Voornaam *</label>
                <input
                  type="text"
                  id="voornaam"
                  name="voornaam"
                  required
                  class="w-full px-4 py-3 rounded-lg border border-asphalt-line bg-white text-pioneer-navy placeholder-asphalt/50 focus:outline-none focus:border-pioneer-navy transition-colors text-sm"
                  placeholder="Jouw voornaam"
                />
              </div>
              <div>
                <label for="achternaam" class="block text-xs font-semibold text-pioneer-navy uppercase tracking-wider mb-1.5">Achternaam</label>
                <input
                  type="text"
                  id="achternaam"
                  name="achternaam"
                  class="w-full px-4 py-3 rounded-lg border border-asphalt-line bg-white text-pioneer-navy placeholder-asphalt/50 focus:outline-none focus:border-pioneer-navy transition-colors text-sm"
                  placeholder="Jouw achternaam"
                />
              </div>
            </div>

            <div>
              <label for="email" class="block text-xs font-semibold text-pioneer-navy uppercase tracking-wider mb-1.5">E-mailadres *</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full px-4 py-3 rounded-lg border border-asphalt-line bg-white text-pioneer-navy placeholder-asphalt/50 focus:outline-none focus:border-pioneer-navy transition-colors text-sm"
                placeholder="jouw@email.nl"
              />
            </div>

            <div>
              <label for="telefoon" class="block text-xs font-semibold text-pioneer-navy uppercase tracking-wider mb-1.5">Telefoonnummer</label>
              <input
                type="tel"
                id="telefoon"
                name="telefoon"
                class="w-full px-4 py-3 rounded-lg border border-asphalt-line bg-white text-pioneer-navy placeholder-asphalt/50 focus:outline-none focus:border-pioneer-navy transition-colors text-sm"
                placeholder="06-00000000"
              />
            </div>

            <div>
              <label for="categorie" class="block text-xs font-semibold text-pioneer-navy uppercase tracking-wider mb-1.5">Ik wil rijles voor</label>
              <select
                id="categorie"
                name="categorie"
                class="w-full px-4 py-3 rounded-lg border border-asphalt-line bg-white text-pioneer-navy focus:outline-none focus:border-pioneer-navy transition-colors text-sm"
              >
                <option value="">Kies een categorie</option>
                <option>Auto — Handgeschakeld (B)</option>
                <option>Auto — Automaat (B)</option>
                <option>Motor (A1 / A2 / A)</option>
                <option>Scooter (AM)</option>
                <option>Vrachtwagen (C / CE)</option>
                <option>Taxi (chauffeurskaart)</option>
                <option>Gratis proefles plannen</option>
                <option>Anders / Weet ik nog niet</option>
              </select>
            </div>

            <div>
              <label for="bericht" class="block text-xs font-semibold text-pioneer-navy uppercase tracking-wider mb-1.5">Jouw bericht *</label>
              <textarea
                id="bericht"
                name="bericht"
                required
                rows="5"
                class="w-full px-4 py-3 rounded-lg border border-asphalt-line bg-white text-pioneer-navy placeholder-asphalt/50 focus:outline-none focus:border-pioneer-navy transition-colors text-sm resize-none"
                placeholder="Stel gerust je vraag of schrijf je direct in…"
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full py-3.5 rounded-lg bg-pioneer-red hover:bg-pioneer-red-dark text-white font-semibold transition-colors"
            >
              Verstuur bericht
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>

  <!-- Google Reviews teaser (§2.5 briefeis: ook op contactpagina) -->
  <section class="py-14 bg-white border-t border-asphalt-line">
    <div class="max-w-[1280px] mx-auto px-5 sm:px-8">
      <div class="reveal-item flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6 mb-8">
        <div>
          <p class="text-pioneer-red font-semibold text-xs uppercase tracking-[0.18em] mb-2 flex items-center gap-2">
            <span class="w-5 h-px bg-pioneer-red inline-block"></span>Wat anderen zeggen
          </p>
          <h2 class="font-display font-bold text-2xl tracking-tight">4,7 ★ op Google</h2>
        </div>
        <a
          href="#"
          data-todo="google-business-profile-link"
          target="_blank"
          rel="noopener noreferrer"
          class="flex-shrink-0 inline-flex items-center gap-2 px-5 py-2.5 rounded-lg border border-asphalt-line hover:border-pioneer-navy bg-white text-pioneer-navy text-sm font-semibold transition-colors"
        >
          <svg class="w-4 h-4 text-pioneer-red" fill="currentColor" viewBox="0 0 24 24">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z"/>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z"/>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z"/>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z"/>
          </svg>
          Alle reviews op Google
        </a>
      </div>

      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
        {[
          { name: 'Emma van Dijk', rating: 5, text: 'Mahmood is een geweldige instructeur — geduldig, duidelijk en echt betrokken. Na mijn eerste pakket slaagde ik direct. Aanrader voor iedereen!' },
          { name: 'Eddie Janssen', rating: 5, text: 'Super fijne rijschool. Les in het Engels was geen enkel probleem. De app werkt makkelijk en alles is goed geregeld.' },
          { name: 'Mike S.', rating: 5, text: 'Na twee mislukte pogingen bij andere rijscholen in één keer geslaagd. De aanpak hier is echt anders — persoonlijker en effectiever.' },
        ].map(({ name, rating, text }, i) => (
          <div class={`reveal-item bg-off-white rounded-2xl border border-asphalt-line p-6`} data-delay={String(i + 1)}>
            <div class="flex items-center gap-1 mb-3">
              {Array.from({ length: rating }).map(() => (
                <svg class="w-4 h-4 text-[#FBBC04]" fill="currentColor" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
              ))}
            </div>
            <p class="text-asphalt text-sm leading-relaxed mb-4">"{text}"</p>
            <p class="font-semibold text-pioneer-navy text-sm">{name}</p>
          </div>
        ))}
      </div>
    </div>
  </section>
</Layout>
