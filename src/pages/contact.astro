---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Contact"
  description="Neem contact op met Verkeersschool Pioneers in Breda — via WhatsApp, telefoon, e-mail of het contactformulier."
>
  <!-- Page header -->
  <section class="bg-pioneer-navy text-white py-16 md:py-20">
    <div class="max-w-[1280px] mx-auto px-5 sm:px-8">
      <p class="text-pioneer-red font-semibold text-sm uppercase tracking-widest mb-3">Contact</p>
      <h1 class="font-display font-bold text-4xl md:text-5xl tracking-tight mb-4">
        Neem contact op
      </h1>
      <p class="text-white/65 text-lg max-w-lg">
        Vragen over een pakket? Of direct inschrijven? We staan voor je klaar.
      </p>
    </div>
  </section>

  <section class="py-16 md:py-20">
    <div class="max-w-[1280px] mx-auto px-5 sm:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">

        <!-- Contact info -->
        <div>
          <h2 class="font-display font-bold text-2xl tracking-tight mb-6">Contactgegevens</h2>
          <ul class="space-y-5 mb-8">
            <li class="flex items-start gap-3">
              <div class="w-10 h-10 rounded-lg bg-pioneer-navy/8 flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-5 h-5 text-pioneer-red" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 5a2 2 0 012-2h3.28a1 1 0 01.948.684l1.498 4.493a1 1 0 01-.502 1.21l-2.257 1.13a11.042 11.042 0 005.516 5.516l1.13-2.257a1 1 0 011.21-.502l4.493 1.498a1 1 0 01.684.949V19a2 2 0 01-2 2h-1C9.716 21 3 14.284 3 6V5z"/>
                </svg>
              </div>
              <div>
                <p class="font-semibold text-pioneer-navy text-sm mb-0.5">Telefoon</p>
                <!-- data-todo="phone-number-pending" -->
                <a href="tel:+31000000000" class="text-asphalt hover:text-pioneer-red transition-colors">+31 (0)00 000 0000</a>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <div class="w-10 h-10 rounded-lg bg-pioneer-navy/8 flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-5 h-5 text-pioneer-red" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M3 8l7.89 5.26a2 2 0 002.22 0L21 8M5 19h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z"/>
                </svg>
              </div>
              <div>
                <p class="font-semibold text-pioneer-navy text-sm mb-0.5">E-mail</p>
                <!-- data-todo="email-pending" -->
                <a href="mailto:info@verkeersschoolpioneers.nl" class="text-asphalt hover:text-pioneer-red transition-colors">info@verkeersschoolpioneers.nl</a>
              </div>
            </li>
            <li class="flex items-start gap-3">
              <div class="w-10 h-10 rounded-lg bg-pioneer-navy/8 flex items-center justify-center flex-shrink-0 mt-0.5">
                <svg class="w-5 h-5 text-pioneer-red" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"/>
                  <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"/>
                </svg>
              </div>
              <div>
                <p class="font-semibold text-pioneer-navy text-sm mb-0.5">Adres</p>
                <!-- data-todo="address-pending" -->
                <p class="text-asphalt">Breda en omgeving</p>
              </div>
            </li>
          </ul>

          <!-- WhatsApp prominent -->
          <a
            href="https://wa.me/31000000000"
            data-todo="whatsapp-number-pending"
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2.5 w-full sm:w-auto justify-center px-6 py-3.5 rounded-lg bg-[#25D366] hover:bg-[#1ebe5d] text-white font-semibold transition-colors shadow-md mb-8"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
              <path d="M5.339 18.706A9.905 9.905 0 0 1 2 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10a9.934 9.934 0 0 1-5.127-1.417L2 22l2.339-3.294z"/>
            </svg>
            Direct chatten via WhatsApp
          </a>

          <!-- Map placeholder -->
          <!-- data-todo="map-embed-pending — Google Maps embed bij definitief adres" -->
          <div class="bg-asphalt-line rounded-2xl aspect-video flex items-center justify-center text-asphalt/40 text-sm">
            🗺️ Kaart volgt — Google Maps embed
          </div>
        </div>

        <!-- Contact form -->
        <div>
          <h2 class="font-display font-bold text-2xl tracking-tight mb-6">Stuur een bericht</h2>
          <form
            name="contact"
            method="POST"
            data-netlify="true"
            netlify-honeypot="bot-field"
            class="space-y-5"
          >
            <input type="hidden" name="form-name" value="contact" />
            <p class="hidden">
              <label>Laat dit veld leeg: <input name="bot-field" /></label>
            </p>

            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
              <div>
                <label for="voornaam" class="block text-xs font-semibold text-pioneer-navy uppercase tracking-wider mb-1.5">Voornaam *</label>
                <input
                  type="text"
                  id="voornaam"
                  name="voornaam"
                  required
                  class="w-full px-4 py-3 rounded-lg border border-asphalt-line bg-white text-pioneer-navy placeholder-asphalt/50 focus:outline-none focus:border-pioneer-navy transition-colors text-sm"
                  placeholder="Jouw voornaam"
                />
              </div>
              <div>
                <label for="achternaam" class="block text-xs font-semibold text-pioneer-navy uppercase tracking-wider mb-1.5">Achternaam</label>
                <input
                  type="text"
                  id="achternaam"
                  name="achternaam"
                  class="w-full px-4 py-3 rounded-lg border border-asphalt-line bg-white text-pioneer-navy placeholder-asphalt/50 focus:outline-none focus:border-pioneer-navy transition-colors text-sm"
                  placeholder="Jouw achternaam"
                />
              </div>
            </div>

            <div>
              <label for="email" class="block text-xs font-semibold text-pioneer-navy uppercase tracking-wider mb-1.5">E-mailadres *</label>
              <input
                type="email"
                id="email"
                name="email"
                required
                class="w-full px-4 py-3 rounded-lg border border-asphalt-line bg-white text-pioneer-navy placeholder-asphalt/50 focus:outline-none focus:border-pioneer-navy transition-colors text-sm"
                placeholder="jouw@email.nl"
              />
            </div>

            <div>
              <label for="telefoon" class="block text-xs font-semibold text-pioneer-navy uppercase tracking-wider mb-1.5">Telefoonnummer</label>
              <input
                type="tel"
                id="telefoon"
                name="telefoon"
                class="w-full px-4 py-3 rounded-lg border border-asphalt-line bg-white text-pioneer-navy placeholder-asphalt/50 focus:outline-none focus:border-pioneer-navy transition-colors text-sm"
                placeholder="06-00000000"
              />
            </div>

            <div>
              <label for="categorie" class="block text-xs font-semibold text-pioneer-navy uppercase tracking-wider mb-1.5">Ik wil mijn rijbewijs halen voor</label>
              <select
                id="categorie"
                name="categorie"
                class="w-full px-4 py-3 rounded-lg border border-asphalt-line bg-white text-pioneer-navy focus:outline-none focus:border-pioneer-navy transition-colors text-sm"
              >
                <option value="">Kies een categorie</option>
                <option>Auto (B)</option>
                <option>Motor (A)</option>
                <option>Scooter (AM)</option>
                <option>Vrachtwagen (C)</option>
                <option>Taxi</option>
                <option>Anders / Weet ik nog niet</option>
              </select>
            </div>

            <div>
              <label for="bericht" class="block text-xs font-semibold text-pioneer-navy uppercase tracking-wider mb-1.5">Jouw bericht *</label>
              <textarea
                id="bericht"
                name="bericht"
                required
                rows="5"
                class="w-full px-4 py-3 rounded-lg border border-asphalt-line bg-white text-pioneer-navy placeholder-asphalt/50 focus:outline-none focus:border-pioneer-navy transition-colors text-sm resize-none"
                placeholder="Stel gerust je vraag of schrijf je direct in…"
              ></textarea>
            </div>

            <button
              type="submit"
              class="w-full py-3.5 rounded-lg bg-pioneer-red hover:bg-pioneer-red-dark text-white font-semibold transition-colors"
            >
              Verstuur bericht
            </button>
          </form>
        </div>
      </div>
    </div>
  </section>
</Layout>
