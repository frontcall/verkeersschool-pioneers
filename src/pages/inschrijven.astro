---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Inschrijven"
  description="Schrijf je in bij Verkeersschool Pioneers. Vul het formulier in en wij nemen snel contact met je op om alles te regelen."
>

  <!-- ══ HERO ══ -->
  <section class="hero-bg text-white py-14 md:py-20 relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="orb-drift absolute -top-32 right-0 w-[520px] h-[520px] rounded-full" style="filter:blur(90px); background: radial-gradient(circle, rgba(214,40,57,0.45) 0%, transparent 65%);"></div>
      <div class="orb-drift-slow absolute bottom-0 -left-20 w-[380px] h-[380px] rounded-full" style="filter:blur(90px); background: radial-gradient(circle, rgba(42,67,116,0.55) 0%, transparent 65%);"></div>
    </div>
    <div class="relative z-10 max-w-[1280px] mx-auto px-5 sm:px-8">
      <p class="hero-item text-pioneer-red font-semibold text-xs uppercase tracking-[0.18em] mb-4 flex items-center gap-2" data-delay="1">
        <span class="w-5 h-px bg-pioneer-red inline-block"></span>Inschrijven
      </p>
      <h1 class="hero-item font-display font-bold text-4xl md:text-5xl tracking-tight mb-3" data-delay="2">
        Start jouw rijlessen
      </h1>
      <p class="hero-item text-white/65 text-lg max-w-lg" data-delay="3">
        Vul het formulier in — wij nemen binnen één werkdag contact op om alles te regelen.
      </p>
    </div>
  </section>

  <!-- ══ FORM + SIDEBAR ══ -->
  <section class="py-12 md:py-16 dot-grid-bg">
    <div class="max-w-[1280px] mx-auto px-5 sm:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-3 gap-10 lg:gap-14 items-start">

        <!-- ── FORM ── -->
        <div class="lg:col-span-2">
          <div class="bg-white rounded-2xl border border-asphalt-line shadow-sm p-6 sm:p-8 md:p-10">
            <form
              id="inschrijf-form"
              name="inschrijving"
              method="POST"
              action="/bedankt"
              data-netlify="true"
              netlify-honeypot="bot-field"
              class="space-y-20"
            >
              <input type="hidden" name="form-name" value="inschrijving" />
              <p class="hidden"><label>Laat dit veld leeg: <input name="bot-field" /></label></p>

              <!-- ─ Stap 1: Persoonsgegevens ─ -->
              <div>
                <div class="flex items-center gap-3 mb-8 pb-5 border-b border-asphalt-line">
                  <span class="flex-shrink-0 w-7 h-7 rounded-full bg-pioneer-red text-white text-xs font-bold flex items-center justify-center select-none">1</span>
                  <h2 class="font-display font-bold text-lg text-pioneer-navy">Persoonsgegevens</h2>
                </div>
                <div class="space-y-6">
                  <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <div>
                      <label for="voornaam" class="field-label">Voornaam *</label>
                      <input type="text" id="voornaam" name="voornaam" required autocomplete="given-name"
                        class="form-field" placeholder="Jouw voornaam" />
                    </div>
                    <div>
                      <label for="achternaam" class="field-label">Achternaam *</label>
                      <input type="text" id="achternaam" name="achternaam" required autocomplete="family-name"
                        class="form-field" placeholder="Jouw achternaam" />
                    </div>
                  </div>
                  <div>
                    <label for="geboortedatum" class="field-label">Geboortedatum *</label>
                    <input type="date" id="geboortedatum" name="geboortedatum" required autocomplete="bday"
                      class="form-field" />
                  </div>
                  <div>
                    <label for="email" class="field-label">E-mailadres *</label>
                    <input type="email" id="email" name="email" required autocomplete="email"
                      class="form-field" placeholder="jouw@email.nl" />
                  </div>
                  <div>
                    <label for="telefoon" class="field-label">Telefoonnummer *</label>
                    <input type="tel" id="telefoon" name="telefoon" required autocomplete="tel"
                      class="form-field" placeholder="06-00000000" />
                  </div>
                </div>
              </div>

              <!-- ─ Stap 2: Rijles ─ -->
              <div>
                <div class="flex items-center gap-3 mb-8 pb-5 border-b border-asphalt-line">
                  <span class="flex-shrink-0 w-7 h-7 rounded-full bg-pioneer-red text-white text-xs font-bold flex items-center justify-center select-none">2</span>
                  <h2 class="font-display font-bold text-lg text-pioneer-navy">Rijles</h2>
                </div>
                <div class="space-y-6">
                  <!-- Categorie -->
                  <div>
                    <label for="categorie" class="field-label">Waarvoor wil je rijles? *</label>
                    <div class="relative">
                      <select id="categorie" name="categorie" required class="form-field appearance-none pr-10">
                        <option value="">Kies een categorie…</option>
                        <option value="Handgeschakeld (B)">Auto — Handgeschakeld (B)</option>
                        <option value="Automaat (B)">Auto — Automaat (B)</option>
                        <option value="Motor (A1/A2/A)">Motor (A1 / A2 / A)</option>
                        <option value="Scooter (AM)">Scooter (AM)</option>
                        <option value="Vrachtwagen (C/CE)">Vrachtwagen (C / CE)</option>
                        <option value="Taxi">Taxi (chauffeurskaart)</option>
                      </select>
                      <svg class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 w-4 h-4 text-asphalt/50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                      </svg>
                    </div>
                  </div>

                  <!-- Pakket (dynamisch getoond) -->
                  <div id="pakket-wrap" class="pakket-hidden">
                    <label for="pakket" class="field-label">Welk pakket? *</label>
                    <div class="relative">
                      <select id="pakket" name="pakket" class="form-field appearance-none pr-10">
                        <option value="">Kies een pakket…</option>
                      </select>
                      <svg class="pointer-events-none absolute right-3 top-1/2 -translate-y-1/2 w-4 h-4 text-asphalt/50" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
                      </svg>
                    </div>
                  </div>

                  <!-- Rijervaring -->
                  <div>
                    <p class="field-label">Heb je al rijervaring?</p>
                    <div class="flex flex-wrap gap-2.5 mt-2">
                      {[
                        { v: 'Geen rijervaring', l: 'Geen rijervaring' },
                        { v: 'Wat rijervaring', l: 'Wat ervaring' },
                        { v: 'Veel rijervaring', l: 'Veel ervaring' },
                      ].map(({ v, l }) => (
                        <label class="pill-option">
                          <input type="radio" name="rijervaring" value={v} />
                          <span>{l}</span>
                        </label>
                      ))}
                    </div>
                  </div>

                  <!-- Theorie -->
                  <div>
                    <p class="field-label">Theorie-examen gedaan?</p>
                    <div class="flex flex-wrap gap-2.5 mt-2">
                      {[
                        { v: 'Nee, nog niet', l: 'Nee, nog niet' },
                        { v: 'Bezig met theorie', l: 'Bezig ermee' },
                        { v: 'Ja, geslaagd', l: 'Ja, geslaagd' },
                      ].map(({ v, l }) => (
                        <label class="pill-option">
                          <input type="radio" name="theorie" value={v} />
                          <span>{l}</span>
                        </label>
                      ))}
                    </div>
                  </div>
                </div>
              </div>

              <!-- ─ Stap 3: Extra info ─ -->
              <div>
                <div class="flex items-center gap-3 mb-8 pb-5 border-b border-asphalt-line">
                  <span class="flex-shrink-0 w-7 h-7 rounded-full bg-pioneer-red text-white text-xs font-bold flex items-center justify-center select-none">3</span>
                  <h2 class="font-display font-bold text-lg text-pioneer-navy">Extra informatie</h2>
                </div>
                <div class="space-y-6">
                  <!-- Taalvoorkeur -->
                  <div>
                    <p class="field-label">Voorkeurstaal voor de les</p>
                    <div class="flex flex-wrap gap-2.5 mt-2">
                      {[
                        { v: 'Nederlands', l: 'Nederlands' },
                        { v: 'Engels', l: 'English' },
                        { v: 'Arabisch', l: 'العربية' },
                      ].map(({ v, l }) => (
                        <label class="pill-option">
                          <input type="radio" name="taal" value={v} />
                          <span>{l}</span>
                        </label>
                      ))}
                    </div>
                  </div>

                  <!-- Betaalvoorkeur -->
                  <div>
                    <p class="field-label">Betaalvoorkeur</p>
                    <div class="flex flex-wrap gap-2.5 mt-2">
                      {[
                        { v: 'Vooraf (volledig)', l: 'Vooraf' },
                        { v: 'Maandelijks', l: 'Maandelijks' },
                        { v: 'Per les', l: 'Per les' },
                        { v: 'Weet ik nog niet', l: 'Weet nog niet' },
                      ].map(({ v, l }) => (
                        <label class="pill-option">
                          <input type="radio" name="betaal" value={v} />
                          <span>{l}</span>
                        </label>
                      ))}
                    </div>
                  </div>

                  <!-- Opmerkingen -->
                  <div>
                    <label for="opmerkingen" class="field-label">Opmerkingen of vragen</label>
                    <textarea id="opmerkingen" name="opmerkingen" rows="4" class="form-field resize-none"
                      placeholder="Stel gerust een vraag of geef extra info mee…"></textarea>
                  </div>
                </div>
              </div>

              <!-- ─ Privacy ─ -->
              <div class="bg-off-white rounded-xl border border-asphalt-line p-4 flex items-start gap-3">
                <input
                  type="checkbox"
                  id="akkoord"
                  name="akkoord"
                  required
                  class="mt-0.5 w-4 h-4 accent-pioneer-red cursor-pointer flex-shrink-0"
                />
                <label for="akkoord" class="text-sm text-asphalt cursor-pointer leading-relaxed">
                  Ik ga akkoord met de verwerking van mijn persoonsgegevens door Verkeersschool Pioneers voor de verwerking van deze inschrijving. Mijn gegevens worden niet gedeeld met derden.
                </label>
              </div>

              <!-- ─ Submit ─ -->
              <div>
                <button
                  type="submit"
                  class="w-full py-4 rounded-xl bg-pioneer-red hover:bg-pioneer-red-dark text-white font-semibold text-base transition-all duration-200 hover:shadow-lg hover:shadow-[rgba(214,40,57,0.28)] hover:-translate-y-0.5 flex items-center justify-center gap-2.5 cursor-pointer"
                >
                  <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 19l9 2-9-18-9 18 9-2zm0 0v-8"/>
                  </svg>
                  Verstuur inschrijving
                </button>
                <p class="text-center text-xs text-asphalt/50 mt-3">Wij nemen binnen één werkdag contact met je op.</p>
              </div>
            </form>
          </div>
        </div>

        <!-- ── SIDEBAR ── -->
        <div class="space-y-5 lg:sticky lg:top-28">

          <!-- Wat regelen wij -->
          <div class="bg-pioneer-navy rounded-2xl p-6 text-white">
            <h2 class="font-display font-bold text-base mb-5">Wat regelen wij voor jou?</h2>
            <ul class="space-y-3.5">
              {[
                'Persoonlijk rijschema op maat',
                'Aanmelding bij het CBR',
                'Theoriepakket & begeleiding',
                'Alle administratie & inschrijving',
                'Flexibele lesmomenten',
                'Ondersteuning tot je slaagt',
              ].map(item => (
                <li class="flex items-center gap-2.5 text-sm text-white/80">
                  <svg class="w-4 h-4 text-pioneer-red flex-shrink-0" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
                  </svg>
                  {item}
                </li>
              ))}
            </ul>
          </div>

          <!-- Hoe gaat het verder -->
          <div class="bg-white rounded-2xl border border-asphalt-line p-6">
            <h2 class="font-display font-bold text-base mb-5 text-pioneer-navy">Hoe gaat het verder?</h2>
            <ol class="space-y-4">
              {[
                { n: '1', t: 'Inschrijving ontvangen', d: 'Je ontvangt een bevestiging per e-mail.' },
                { n: '2', t: 'Wij nemen contact op', d: 'We bellen of appen je voor een korte intake.' },
                { n: '3', t: 'Eerste les plannen', d: 'Jij kiest wanneer je start — wij regelen de rest.' },
              ].map(({ n, t, d }) => (
                <li class="flex gap-3.5">
                  <span class="flex-shrink-0 w-6 h-6 rounded-full bg-pioneer-red/10 text-pioneer-red text-xs font-bold flex items-center justify-center mt-0.5">{n}</span>
                  <div>
                    <p class="font-semibold text-pioneer-navy text-sm">{t}</p>
                    <p class="text-asphalt text-xs leading-relaxed mt-0.5">{d}</p>
                  </div>
                </li>
              ))}
            </ol>
          </div>

          <!-- WhatsApp -->
          <a
            href="https://wa.me/31643127001?text=Hallo!%20Ik%20heb%20een%20vraag%20over%20de%20inschrijving."
            target="_blank"
            rel="noopener noreferrer"
            class="flex items-center gap-4 bg-white border border-asphalt-line hover:border-[#25D366]/40 hover:bg-[#25D366]/5 rounded-2xl p-5 transition-all duration-200 group"
          >
            <div class="w-11 h-11 rounded-xl bg-[#25D366]/10 flex items-center justify-center flex-shrink-0 group-hover:bg-[#25D366]/20 transition-colors">
              <svg class="w-6 h-6 text-[#25D366]" viewBox="0 0 24 24" fill="currentColor">
                <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
                <path d="M5.339 18.706A9.905 9.905 0 0 1 2 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10a9.934 9.934 0 0 1-5.127-1.417L2 22l2.339-3.294z"/>
              </svg>
            </div>
            <div>
              <p class="font-semibold text-pioneer-navy text-sm">Vragen over de inschrijving?</p>
              <p class="text-asphalt text-xs mt-0.5">App ons — we antwoorden snel</p>
            </div>
          </a>

        </div>
      </div>
    </div>
  </section>

</Layout>

<style>
  .field-label {
    display: block;
    font-size: 0.7rem;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--color-pioneer-navy);
    margin-bottom: 0.375rem;
  }

  .form-field {
    display: block;
    width: 100%;
    padding: 0.75rem 1rem;
    border-radius: 0.5rem;
    border: 1.5px solid var(--color-asphalt-line);
    background-color: #fff;
    color: var(--color-pioneer-navy);
    font-size: 0.875rem;
    line-height: 1.5;
    font-family: var(--font-sans);
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .form-field::placeholder {
    color: rgba(75, 79, 88, 0.4);
  }
  .form-field:focus {
    outline: none;
    border-color: var(--color-pioneer-navy);
    box-shadow: 0 0 0 3px rgba(22, 35, 63, 0.08);
  }

  /* Pill radio buttons */
  .pill-option {
    cursor: pointer;
  }
  .pill-option input[type="radio"] {
    position: absolute;
    opacity: 0;
    width: 0;
    height: 0;
  }
  .pill-option span {
    display: inline-flex;
    align-items: center;
    padding: 0.45rem 1rem;
    border: 1.5px solid var(--color-asphalt-line);
    border-radius: 999px;
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--color-asphalt);
    background: #fff;
    user-select: none;
    white-space: nowrap;
    transition: border-color 0.15s ease, background-color 0.15s ease, color 0.15s ease;
  }
  .pill-option:hover span {
    border-color: var(--color-pioneer-navy);
    color: var(--color-pioneer-navy);
  }
  .pill-option input[type="radio"]:checked + span {
    background-color: var(--color-pioneer-navy);
    border-color: var(--color-pioneer-navy);
    color: #fff;
  }
  .pill-option input[type="radio"]:focus-visible + span {
    outline: 2px solid var(--color-pioneer-red);
    outline-offset: 2px;
  }

  .pakket-hidden {
    display: none;
  }
  .pakket-hidden.is-visible {
    display: block;
  }
</style>

<script>
  const catSelect = document.getElementById('categorie') as HTMLSelectElement | null;
  const pakketWrap = document.getElementById('pakket-wrap');
  const pakketSelect = document.getElementById('pakket') as HTMLSelectElement | null;

  const pakkettenMap: Record<string, string[]> = {
    'Handgeschakeld (B)': [
      'Start Pakket — € 1.049 (11 lessen)',
      'Studenten Pakket — € 1.499 (20 lessen)',
      'Spoed Pakket — € 2.099 (30 lessen)',
    ],
    'Automaat (B)': [
      'Automaat Pakket — € 1.750 (24 lessen)',
      'Losse rijles — € 60 per les',
    ],
    'Motor (A1/A2/A)': [
      'A1 — Lichte motor (tot 125cc)',
      'A2 — Middencategorie (tot 35 kW)',
      'A — Onbeperkt',
    ],
    'Scooter (AM)': ['AM-pakket'],
    'Vrachtwagen (C/CE)': ['C — Vrachtwagen', 'CE — Met aanhanger'],
    'Taxi': ['Taxi Pakket (inclusief chauffeurskaart)'],
  };

  function updatePakket(catValue: string, preselect?: string) {
    if (!pakketWrap || !pakketSelect) return;
    const opties = pakkettenMap[catValue] || [];
    if (opties.length) {
      pakketSelect.innerHTML =
        '<option value="">Kies een pakket…</option>' +
        opties.map(o => `<option value="${o}">${o}</option>`).join('');
      if (preselect) {
        const match = opties.find(o => o.toLowerCase().includes(preselect.toLowerCase()));
        if (match) pakketSelect.value = match;
      }
      pakketSelect.required = true;
      pakketWrap.classList.add('is-visible');
    } else {
      pakketWrap.classList.remove('is-visible');
      pakketSelect.required = false;
    }
  }

  catSelect?.addEventListener('change', () => {
    updatePakket(catSelect.value);
  });

  // Pre-fill from URL params
  const params = new URLSearchParams(window.location.search);
  const catParam = params.get('cat');
  const pakketParam = params.get('pakket');

  if (catParam && catSelect) {
    const match = Array.from(catSelect.options).find(
      o => o.value.toLowerCase().startsWith(catParam.toLowerCase())
    );
    if (match) {
      catSelect.value = match.value;
      updatePakket(match.value, pakketParam || undefined);
    }
  }
</script>
