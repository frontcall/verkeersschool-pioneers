---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Verkeersschool Nummer CBR"
  description="Machtig Verkeersschool Pioneers via MijnCBR met code 1160G5. Log in met je DigiD om je theorie- of praktijkexamen in te plannen."
>
  <section class="hero-bg text-white py-16 md:py-20 relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="orb-drift absolute -top-32 right-0 w-[520px] h-[520px] rounded-full" style="filter:blur(90px); background: radial-gradient(circle, rgba(214,40,57,0.45) 0%, transparent 65%);"></div>
      <div class="orb-drift-slow absolute bottom-0 -left-20 w-[380px] h-[380px] rounded-full" style="filter:blur(90px); background: radial-gradient(circle, rgba(42,67,116,0.55) 0%, transparent 65%);"></div>
    </div>
    <div class="relative z-10 max-w-[1280px] mx-auto px-5 sm:px-8">
      <p class="text-pioneer-red font-semibold text-xs uppercase tracking-[0.18em] mb-3">Verkeersschool Nummer CBR</p>
      <h1 class="font-display font-bold text-4xl md:text-5xl tracking-tight">Machtig ons via MijnCBR</h1>
    </div>
  </section>

  <section class="py-16 md:py-20 bg-off-white">
    <div class="max-w-5xl mx-auto px-5 sm:px-8">

      <!-- Grid: CBR nummer links, stappen rechts -->
      <div class="reveal-item grid grid-cols-1 lg:grid-cols-[1fr_1.6fr] gap-6 mb-6">

        <!-- CBR nummer -->
        <div class="bg-pioneer-navy rounded-2xl p-8 flex flex-col justify-center">
          <span class="text-white/70 text-base font-bold mb-3 leading-snug">CBR-nummer Verkeersschool Pioneers</span>
          <span class="font-display font-black text-6xl md:text-7xl tracking-tight text-white leading-none">1160G5</span>
        </div>

        <!-- Stappen -->
        <div class="bg-white rounded-2xl border border-asphalt-line p-8">
        <h2 class="font-display font-bold text-2xl tracking-tight mb-6">Hoe machtig je ons?</h2>

        <ol class="space-y-5">
          <li class="flex gap-4">
            <span class="flex-shrink-0 w-8 h-8 rounded-full bg-pioneer-navy text-white font-bold text-sm flex items-center justify-center">1</span>
            <div>
              <p class="font-semibold text-pioneer-navy mb-0.5">Ga naar www.mijncbr.nl</p>
              <p class="text-asphalt text-sm leading-relaxed">Machtig ons via <a href="https://www.mijncbr.nl" target="_blank" rel="noopener noreferrer" class="text-pioneer-navy underline underline-offset-2 hover:text-pioneer-red transition-colors">www.mijncbr.nl</a> — selecteer optie <strong>(5)</strong> voor het machtigen van een rijschool.</p>
            </div>
          </li>
          <li class="flex gap-4">
            <span class="flex-shrink-0 w-8 h-8 rounded-full bg-pioneer-navy text-white font-bold text-sm flex items-center justify-center">2</span>
            <div>
              <p class="font-semibold text-pioneer-navy mb-0.5">Log in met je DigiD</p>
              <p class="text-asphalt text-sm leading-relaxed">
                Nog géén DigiD? Vraag deze dan per direct aan via
                <a href="https://www.digid.nl" target="_blank" rel="noopener noreferrer" class="text-pioneer-navy underline underline-offset-2 hover:text-pioneer-red transition-colors">www.digid.nl</a>.
              </p>
            </div>
          </li>
          <li class="flex gap-4">
            <span class="flex-shrink-0 w-8 h-8 rounded-full bg-pioneer-red text-white font-bold text-sm flex items-center justify-center">!</span>
            <div>
              <p class="font-semibold text-pioneer-red mb-0.5">Zonder DigiD geen examen</p>
              <p class="text-asphalt text-sm leading-relaxed">Zonder DigiD kan er <strong>géén</strong> theorie- of praktijkexamen worden ingepland. Regel dit zo snel mogelijk.</p>
            </div>
          </li>
          <li class="flex gap-4">
            <span class="flex-shrink-0 w-8 h-8 rounded-full bg-pioneer-navy text-white font-bold text-sm flex items-center justify-center">3</span>
            <div>
              <p class="font-semibold text-pioneer-navy mb-0.5">Vul onze code in: <span class="text-pioneer-red">1160G5</span></p>
              <p class="text-asphalt text-sm leading-relaxed">Machtig ons via www.mijncbr.nl met de code <strong>1160G5</strong>. Daarna kan jouw theorie-examen worden ingepland.</p>
            </div>
          </li>
          <li class="flex gap-4">
            <span class="flex-shrink-0 w-8 h-8 rounded-full bg-[#25D366] text-white font-bold text-sm flex items-center justify-center">✓</span>
            <div>
              <p class="font-semibold text-pioneer-navy mb-0.5">Klaar — veel succes!</p>
              <p class="text-asphalt text-sm leading-relaxed">Zodra de machtiging is geregeld nemen wij contact op om je examen in te plannen. Veel succes!</p>
            </div>
          </li>
        </ol>
        </div><!-- einde stappen kaart -->
      </div><!-- einde grid -->

      <!-- Vragen -->
      <div class="reveal-item">
        <a
          href="https://wa.me/31643127001?text=Hallo%20Verkeersschool%20Pioneers!%20Ik%20heb%20een%20vraag%20over%20machtigen."
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2.5 px-6 py-3.5 rounded-xl bg-[#25D366] hover:bg-[#1ebe5d] text-white font-semibold transition-all duration-200 hover:-translate-y-0.5"
        >
          <svg class="w-5 h-5" viewBox="0 0 448 512" fill="currentColor">
            <path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/>
          </svg>
          Stel je vraag via WhatsApp
        </a>
      </div>
    </div>
  </section>
</Layout>
