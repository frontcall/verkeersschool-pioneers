---
export const prerender = false;

import Layout from '../../../layouts/Layout.astro';
import PostGrid from '../../../components/PostGrid.astro';
import Pagination from '../../../components/Pagination.astro';
import { getPublishedPosts, paginate, pageHref, parsePageParam } from '../../../lib/blog.js';

const requested = parsePageParam(Astro.params.page);

// /blog/page/1 duplicates /blog — send it to the canonical URL. Anything that
// isn't a clean integer is not a real page either.
if (requested === null || requested === 1) {
  return Astro.redirect('/blog', 301);
}

const posts = await getPublishedPosts();
const { items, current, totalPages } = paginate(posts, requested);

// Past the last page there is nothing to show.
if (requested > totalPages) {
  return Astro.redirect('/blog', 302);
}

const site = Astro.site || 'https://verkeersschoolpioneers.nl';
const prevUrl = new URL(pageHref(current - 1), site).href;
const nextUrl = current < totalPages ? new URL(pageHref(current + 1), site).href : null;
---

<Layout
  title={`Blog — pagina ${current}`}
  description={`Artikelen van Verkeersschool Pioneers — pagina ${current} van ${totalPages}.`}
>
  <Fragment slot="head">
    <link rel="prev" href={prevUrl} />
    {nextUrl && <link rel="next" href={nextUrl} />}
  </Fragment>

  <!-- ══ HERO ══ -->
  <section class="hero-bg text-white py-14 md:py-18 relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="orb-drift absolute -top-32 right-0 w-[480px] h-[480px] rounded-full" style="filter:blur(90px); background: radial-gradient(circle, rgba(214,40,57,0.40) 0%, transparent 65%);"></div>
      <div class="orb-drift-slow absolute bottom-0 -left-20 w-[340px] h-[340px] rounded-full" style="filter:blur(90px); background: radial-gradient(circle, rgba(42,67,116,0.50) 0%, transparent 65%);"></div>
    </div>
    <div class="relative z-10 max-w-[1280px] mx-auto px-5 sm:px-8">
      <p class="hero-item eyebrow mb-4" data-delay="1">Verkeersschool Pioneers</p>
      <h1 class="hero-item font-display font-bold text-4xl md:text-5xl tracking-tight mb-3" data-delay="2">
        Blog
      </h1>
      <p class="hero-item text-white/60 text-lg max-w-lg" data-delay="3">
        Pagina {current} van {totalPages}.
      </p>
    </div>
  </section>

  <!-- ══ POSTS GRID ══ -->
  <section class="py-16 md:py-20">
    <div class="max-w-[1280px] mx-auto px-5 sm:px-8">
      <PostGrid posts={items} />
      <Pagination current={current} totalPages={totalPages} />
    </div>
  </section>
</Layout>
