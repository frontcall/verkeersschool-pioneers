---
export const prerender = false;

import Layout from '../../layouts/Layout.astro';
import { getStore } from '@netlify/blobs';

const context = Astro.locals.netlify?.context;

let posts = [];
try {
  const store = getStore({ name: 'posts', ...(context ? { context } : {}) });
  const raw = await store.get('_index', { type: 'json' });
  if (Array.isArray(raw)) {
    posts = raw.filter(p => p.status === 'published');
  }
} catch {
  // Blobs not yet available or empty — show empty state
}

function formatDate(iso) {
  if (!iso) return '';
  return new Date(iso).toLocaleDateString('nl-NL', {
    day: 'numeric', month: 'long', year: 'numeric',
  });
}
---

<Layout
  title="Blog"
  description="Lees de laatste artikelen van Verkeersschool Pioneers — tips voor het rijexamen, theorie en meer."
>

  <!-- ══ HERO ══ -->
  <section class="hero-bg text-white py-14 md:py-18 relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="orb-drift absolute -top-32 right-0 w-[480px] h-[480px] rounded-full" style="filter:blur(90px); background: radial-gradient(circle, rgba(214,40,57,0.40) 0%, transparent 65%);"></div>
      <div class="orb-drift-slow absolute bottom-0 -left-20 w-[340px] h-[340px] rounded-full" style="filter:blur(90px); background: radial-gradient(circle, rgba(42,67,116,0.50) 0%, transparent 65%);"></div>
    </div>
    <div class="relative z-10 max-w-[1280px] mx-auto px-5 sm:px-8">
      <p class="hero-item eyebrow mb-4" data-delay="1">Verkeersschool Pioneers</p>
      <h1 class="hero-item font-display font-bold text-4xl md:text-5xl tracking-tight mb-3" data-delay="2">
        Blog
      </h1>
      <p class="hero-item text-white/60 text-lg max-w-lg" data-delay="3">
        Rijexamen tips, theorie-hulp en het laatste nieuws van Verkeersschool Pioneers.
      </p>
    </div>
  </section>

  <!-- ══ POSTS GRID ══ -->
  <section class="py-16 md:py-20">
    <div class="max-w-[1280px] mx-auto px-5 sm:px-8">

      {posts.length === 0 ? (
        <div class="text-center py-24">
          <p class="text-asphalt text-lg">Er zijn nog geen artikelen gepubliceerd.</p>
          <p class="text-asphalt/60 text-sm mt-2">Kom binnenkort terug.</p>
        </div>
      ) : (
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          {posts.map((post, i) => (
            <a
              href={`/blog/${post.slug}`}
              class="card-lift group block bg-white rounded-2xl border border-asphalt-line overflow-hidden"
            >
              {post.featured_image_url ? (
                <div class="aspect-[16/9] overflow-hidden bg-asphalt-line">
                  <img
                    src={post.featured_image_url}
                    alt={post.title}
                    class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-105"
                    loading={i < 3 ? 'eager' : 'lazy'}
                  />
                </div>
              ) : (
                <div class="aspect-[16/9] bg-gradient-to-br from-pioneer-navy/10 to-pioneer-red/10 flex items-center justify-center">
                  <svg class="w-10 h-10 text-pioneer-navy/20" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M19.5 14.25v-2.625a3.375 3.375 0 00-3.375-3.375h-1.5A1.125 1.125 0 0113.5 7.125v-1.5a3.375 3.375 0 00-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 00-9-9z"/>
                  </svg>
                </div>
              )}
              <div class="p-6">
                <p class="text-asphalt/60 text-xs font-medium mb-2">{formatDate(post.published_at)}</p>
                <h2 class="font-display font-bold text-pioneer-navy text-lg leading-snug mb-3 group-hover:text-pioneer-red transition-colors line-clamp-2">
                  {post.title}
                </h2>
                {post.excerpt && (
                  <p class="text-asphalt text-sm leading-relaxed line-clamp-3">{post.excerpt}</p>
                )}
                <span class="inline-flex items-center gap-1.5 mt-4 text-pioneer-red text-sm font-semibold group-hover:gap-2.5 transition-all duration-200">
                  Lees meer
                  <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
                  </svg>
                </span>
              </div>
            </a>
          ))}
        </div>
      )}
    </div>
  </section>

</Layout>
