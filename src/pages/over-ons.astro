---
import Layout from '../layouts/Layout.astro';
import SectionDivider from '../components/SectionDivider.astro';
---

<Layout
  title="Over ons"
  description="Leer Verkeersschool Pioneers kennen — onze missie, lesgebied en aanpak. Rijles in Breda en omgeving, 7 dagen per week, in het Nederlands en Engels."
>
  <!-- Page header -->
  <section class="hero-bg text-white py-16 md:py-20 relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="orb-drift absolute -top-32 right-0 w-[520px] h-[520px] rounded-full" style="filter:blur(90px); background: radial-gradient(circle, rgba(214,40,57,0.45) 0%, transparent 65%);"></div>
      <div class="orb-drift-slow absolute bottom-0 -left-20 w-[380px] h-[380px] rounded-full" style="filter:blur(90px); background: radial-gradient(circle, rgba(42,67,116,0.55) 0%, transparent 65%);"></div>
    </div>
    <div class="relative z-10 max-w-[1280px] mx-auto px-5 sm:px-8">
      <p class="hero-item eyebrow mb-4" data-delay="1">Over ons</p>
      <h1 class="hero-item font-display font-bold text-4xl md:text-5xl tracking-tight mb-4" data-delay="2">
        Wij zijn Verkeersschool Pioneers
      </h1>
      <p class="hero-item text-white/65 text-lg max-w-xl" data-delay="3">
        Wij geven onze leerlingen iets waardevols mee waar zij de rest van hun leven profijt van zullen hebben.
      </p>
    </div>
  </section>

  <!-- Missie / Verhaal -->
  <section class="py-16 md:py-20">
    <div class="max-w-[1280px] mx-auto px-5 sm:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
        <div class="reveal-item">
          <p class="eyebrow mb-3">Onze missie</p>
          <h2 class="font-display font-bold text-3xl md:text-4xl tracking-tight mb-6">
            Meer dan een rijbewijs halen
          </h2>
          <div class="space-y-4 text-asphalt leading-relaxed">
            <p>
              Verkeersschool Pioneers is al lang actief in Breda en de omliggende gemeenten en geeft rijles voor elke categorie — 7 dagen per week beschikbaar.
            </p>
            <p>
              Of je nu voor het eerst achter het stuur kruipt of een specifieke categorie wilt halen — bij ons vind je de juiste begeleiding.
            </p>
          </div>
        </div>

        <!-- Kernwaarden met echte SVG iconen -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {[
            {
              title: '7 dagen per week',
              body: "Beschikbaar van maandag t/m zondag, overdag én 's avonds.",
              icon: 'M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z',
              delay: '1',
            },
            {
              title: 'NL / EN',
              body: 'Rijles in het Nederlands en Engels. Jij kiest.',
              icon: 'M3 5h12M9 3v2m1.048 9.5A18.022 18.022 0 016.412 9m6.088 9h7M11 21l5-10 5 10M12.751 5C11.783 10.77 8.07 15.61 3 18.129',
              delay: '2',
            },
            {
              title: 'Theorie vanaf 16',
              body: 'Begin al op je 16e met theorie-instructie, praktijk vanaf 16,5.',
              icon: 'M12 14l9-5-9-5-9 5 9 5zm0 0l6.16-3.422a12.083 12.083 0 01.665 6.479A11.952 11.952 0 0012 20.055a11.952 11.952 0 00-6.824-2.998 12.078 12.078 0 01.665-6.479L12 14z',
              delay: '3',
            },
            {
              title: 'Flexibel betalen',
              body: 'Vooraf, in termijnen of per les — jij bepaalt. Geen verborgen kosten.',
              icon: 'M3 10h18M7 15h1m4 0h1m-7 4h12a3 3 0 003-3V8a3 3 0 00-3-3H6a3 3 0 00-3 3v8a3 3 0 003 3z',
              delay: '4',
            },
            {
              title: 'Moderne leswagens',
              body: 'Jonge, goed uitgeruste voertuigen voor elke les. Veilig en comfortabel.',
              icon: 'M19 9l1-5H4L5 9m14 0H5m14 0l2 8H3l2-8M9 18h.01M15 18h.01',
              delay: '5',
            },
            {
              title: 'De meesten slagen',
              body: 'De meeste leerlingen slagen in één keer voor hun CBR-examen.',
              icon: 'M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z',
              delay: '6',
            },
          ].map(({ title, body, icon, delay }) => (
            <div class="reveal-item card-lift bg-white rounded-xl border border-asphalt-line p-5" data-delay={delay}>
              <div class="w-10 h-10 rounded-lg bg-pioneer-red/8 flex items-center justify-center mb-3">
                <svg class="w-5 h-5 text-pioneer-red" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                  <path stroke-linecap="round" stroke-linejoin="round" d={icon}/>
                </svg>
              </div>
              <h3 class="font-display font-bold text-base mb-1">{title}</h3>
              <p class="text-asphalt text-xs leading-relaxed">{body}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- Leerlingen aan het woord -->
  <section class="py-16 md:py-20 bg-off-white">
    <div class="max-w-[1280px] mx-auto px-5 sm:px-8">
      <div class="reveal-item mb-10">
        <p class="eyebrow mb-3">Google Reviews</p>
        <h2 class="font-display font-bold text-3xl md:text-4xl tracking-tight">Wat onze leerlingen zeggen</h2>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-6">
        {[
          {
            naam: 'Koen Janssen',
            tekst: 'Yes! In één keer geslaagd. Had ik natuurlijk niet kunnen doen zonder Mahmood. Hij is een erg geduldige en respectvolle leraar. Ook kan ik altijd met hem lachen en zorgt hij ervoor dat je altijd op je gemak in de auto zit.',
            foto: 'koen-janssen.jpg',
          },
          {
            naam: 'Loreen Ahmed',
            tekst: 'Ik heb sinds vorige zomer rijles gehad bij PIONEERS. In het begin was het soms wat moeilijk om lessen op korte termijn in te plannen omdat het er druk was, maar dit zou nu geen probleem meer moeten zijn omdat er nieuw personeel is.',
            foto: 'loreen-ahmed.jpg',
          },
          {
            naam: 'Cailey Biermann',
            tekst: 'Vandaag in een keer geslaagd voor mijn auto rijbewijs! Fijne periode aan rijlessen gehad, Mahmood altijd aardig. Qua rijlessen en examens probeert hij zo goed mogelijk flexibel te zijn, zodat je het makkelijker kunt combineren met werk en school.',
            foto: 'cailey-biermann.jpg',
          },
        ].map(({ naam, tekst, foto }) => (
          <div class="reveal-item card-lift bg-white rounded-2xl overflow-hidden border border-asphalt-line flex flex-col">
            <div class="aspect-[4/3] overflow-hidden">
              <img
                src={`/images/reviews/${foto}`}
                alt={`${naam} geslaagd bij Verkeersschool Pioneers`}
                class="w-full h-full object-cover"
                loading="lazy"
              />
            </div>
            <div class="p-6 flex flex-col flex-1">
              <div class="flex gap-0.5 mb-4">
                {Array.from({ length: 5 }).map(() => (
                  <svg class="w-4 h-4 text-[#FBBC04] fill-current" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                  </svg>
                ))}
              </div>
              <p class="text-asphalt text-sm leading-relaxed flex-1 mb-5">"{tekst}"</p>
              <div class="border-t border-asphalt-line/60 pt-4 flex items-center justify-between">
                <p class="font-semibold text-pioneer-navy text-sm">{naam}</p>
                <svg class="w-4 h-4 opacity-35 flex-shrink-0" viewBox="0 0 24 24" fill="currentColor">
                  <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                  <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                  <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                  <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                </svg>
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- Lesgebied -->
  <section class="py-16 md:py-20">
    <div class="max-w-[1280px] mx-auto px-5 sm:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
        <div class="reveal-item">
          <p class="eyebrow mb-3">Lesgebied</p>
          <h2 class="font-display font-bold text-3xl md:text-4xl tracking-tight mb-4">Rijles bij jou in de buurt</h2>
          <p class="text-asphalt leading-relaxed mb-6">
            We geven rijlessen in Breda en de omliggende gemeenten. Twijfel je of we bij jou in de buurt rijden? Neem even contact op — we kijken graag mee.
          </p>
          <div class="flex flex-wrap gap-2 mb-8">
            {['Breda', 'Etten-Leur', 'Roosendaal', 'Oosterhout', 'Rijsbergen', 'Zevenbergen', 'Chaam', 'Terheijden', 'Oudenbosch', 'Rijen'].map(plaats => (
              <span class="bg-white border border-asphalt-line text-pioneer-navy text-sm font-medium px-3.5 py-1.5 rounded-full">
                {plaats}
              </span>
            ))}
          </div>
          <a
            href="/contact"
            class="inline-flex items-center gap-2 px-5 py-3 rounded-lg bg-pioneer-navy hover:bg-pioneer-navy-light text-white font-semibold text-sm transition-colors"
          >
            Neem contact op
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
        </div>

        <!-- Google Maps -->
        <div class="reveal-item rounded-2xl overflow-hidden aspect-video" data-delay="2">
          <iframe
            src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d2506047.5311974124!2d2.6459136955944182!3d52.165019841463284!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x47c69f1402743c2f%3A0x25b3526874153b79!2sschool%20Pioneers!5e0!3m2!1snl!2snl!4v1782996631908!5m2!1snl!2snl"
            width="100%"
            height="100%"
            style="border:0;"
            allowfullscreen=""
            loading="lazy"
            referrerpolicy="strict-origin-when-cross-origin"
            title="Verkeersschool Pioneers op Google Maps"
          ></iframe>
        </div>
      </div>
    </div>
  </section>

  <!-- Afsluitende CTA -->
  <section class="hero-bg text-white py-14 relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="orb-drift absolute -top-20 right-1/4 w-[450px] h-[450px] rounded-full" style="filter:blur(90px); background: radial-gradient(circle, rgba(214,40,57,0.45) 0%, transparent 65%);"></div>
      <div class="orb-drift-slow absolute bottom-0 left-1/4 w-[350px] h-[350px] rounded-full" style="filter:blur(90px); background: radial-gradient(circle, rgba(42,67,116,0.55) 0%, transparent 65%);"></div>
    </div>
    <div class="relative z-10 max-w-[1280px] mx-auto px-5 sm:px-8 text-center">
      <div class="reveal-item">
        <h2 class="font-display font-bold text-2xl md:text-3xl tracking-tight mb-3">
          Klaar om te starten?
        </h2>
        <p class="text-white/55 mb-7 max-w-md mx-auto">Plan een gratis vrijblijvende proefles of schrijf je direct in — we antwoorden 7 dagen per week.</p>
        <div class="flex flex-wrap items-center justify-center gap-4">
          <a
            href="https://wa.me/31643127001?text=Hallo!%20Ik%20wil%20graag%20een%20gratis%20proefles%20plannen."
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center gap-2.5 px-7 py-3.5 rounded-xl bg-pioneer-red hover:bg-pioneer-red-dark text-white font-semibold transition-all duration-200 hover:shadow-lg hover:shadow-pioneer-red/25 hover:-translate-y-0.5"
          >
            <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
              <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
              <path d="M5.339 18.706A9.905 9.905 0 0 1 2 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10a9.934 9.934 0 0 1-5.127-1.417L2 22l2.339-3.294z"/>
            </svg>
            Gratis proefles plannen
          </a>
          <a
            href="/pakketten"
            class="inline-flex items-center gap-2 px-7 py-3.5 rounded-xl border border-white/20 hover:border-white/40 bg-white/5 hover:bg-white/10 text-white font-semibold transition-all duration-200"
          >
            Bekijk pakketten
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
