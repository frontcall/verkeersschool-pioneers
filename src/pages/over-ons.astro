---
import Layout from '../layouts/Layout.astro';
import SectionDivider from '../components/SectionDivider.astro';
---

<Layout
  title="Over ons"
  description="Leer Verkeersschool Pioneers kennen — onze missie, lesgebied en aanpak. Rijles in Breda en omgeving, 7 dagen per week, in het Nederlands, Engels en Arabisch."
>
  <!-- Page header -->
  <section class="bg-pioneer-navy text-white py-16 md:py-20">
    <div class="max-w-[1280px] mx-auto px-5 sm:px-8">
      <p class="text-pioneer-red font-semibold text-sm uppercase tracking-widest mb-3">Over ons</p>
      <h1 class="font-display font-bold text-4xl md:text-5xl tracking-tight mb-4">
        Wij zijn Verkeersschool Pioneers
      </h1>
      <p class="text-white/65 text-lg max-w-xl">
        Wij geven onze leerlingen iets waardevols mee waar zij de rest van hun leven profijt van zullen hebben.
      </p>
    </div>
  </section>

  <!-- Missie / Verhaal -->
  <section class="py-16 md:py-20">
    <div class="max-w-[1280px] mx-auto px-5 sm:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
        <div>
          <h2 class="font-display font-bold text-3xl md:text-4xl tracking-tight mb-6">
            Onze missie
          </h2>
          <div class="space-y-4 text-asphalt leading-relaxed">
            <p>
              Verkeersschool Pioneers is opgericht met één doel: leerlingen niet alleen hun rijbewijs laten halen, maar ze ook echt klaar maken voor het verkeer. Veilig, zelfverzekerd en verantwoordelijk rijden — dat is onze missie.
            </p>
            <p>
              We zijn actief in Breda en de omliggende gemeenten. Of je nu voor het eerst achter het stuur kruipt, snel wilt slagen met het Spoed Pakket of theorie-instructie wilt vanaf je 16e — bij ons vind je het juiste pakket en de juiste begeleiding.
            </p>
            <p>
              Onze instructeurs zijn geduldig, ervaren en beschikbaar van maandag tot zondag, ook in de avonden. Rijles in het Nederlands, Engels of Arabisch — jij kiest wat werkt.
            </p>
          </div>
        </div>

        <!-- Kernwaarden -->
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          {[
            { icon: '📅', title: '7 dagen per week', body: "Beschikbaar van maandag t/m zondag, overdag én 's avonds." },
            { icon: '🌍', title: 'NL / EN / AR', body: 'Rijles in het Nederlands, Engels of Arabisch.' },
            { icon: '🎓', title: 'Theorie vanaf 16', body: 'Begin al op je 16e met theorie-instructie, praktijk vanaf 16,5.' },
            { icon: '💳', title: 'Flexibel betalen', body: 'Vooraf, maandelijks of per les — jij bepaalt.' },
            { icon: '🚗', title: 'Moderne wagens', body: 'Jonge, goed uitgeruste voertuigen voor elke les.' },
            { icon: '🏆', title: 'De meesten slagen', body: 'De meeste leerlingen slagen in één keer voor hun examen.' },
          ].map(({ icon, title, body }) => (
            <div class="bg-white rounded-xl border border-asphalt-line p-5">
              <div class="text-2xl mb-2">{icon}</div>
              <h3 class="font-display font-bold text-base mb-1">{title}</h3>
              <p class="text-asphalt text-xs leading-relaxed">{body}</p>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- Instructeurs -->
  <section class="py-16 md:py-20 bg-white">
    <div class="max-w-[1280px] mx-auto px-5 sm:px-8">
      <h2 class="font-display font-bold text-3xl md:text-4xl tracking-tight mb-3">Onze instructeurs</h2>
      <p class="text-asphalt mb-10 max-w-lg">Ervaren instructeurs — beschikbaar 7 dagen per week, ook 's avonds. Altijd persoonlijk betrokken.</p>

      <div class="bg-off-white rounded-2xl border border-asphalt-line p-8 max-w-xl">
        <div class="flex items-start gap-4">
          <div class="w-12 h-12 rounded-full bg-pioneer-navy/10 flex items-center justify-center text-pioneer-navy font-bold text-xl flex-shrink-0">
            M
          </div>
          <div>
            <h3 class="font-display font-bold text-lg mb-1">Mahmood</h3>
            <p class="text-pioneer-red text-sm font-semibold mb-3">Rijinstructeur &amp; oprichter</p>
            <p class="text-asphalt text-sm leading-relaxed">
              Meer dan 10 jaar ervaring in het rijonderwijs. Geeft les in het Nederlands, Engels en Arabisch. Bekendstaat om zijn geduld en persoonlijke aanpak.
            </p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- Lesgebied -->
  <section class="py-16 md:py-20">
    <div class="max-w-[1280px] mx-auto px-5 sm:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
        <div>
          <h2 class="font-display font-bold text-3xl md:text-4xl tracking-tight mb-5">Lesgebied</h2>
          <p class="text-asphalt leading-relaxed mb-7">
            We geven rijlessen in Breda en de omliggende gemeenten. Twijfel je of we bij jou in de buurt rijden? Neem even contact op — we kijken graag mee.
          </p>
          <div class="flex flex-wrap gap-2 mb-8">
            {['Breda', 'Etten-Leur', 'Roosendaal', 'Oosterhout', 'Rijsbergen', 'Zevenbergen', 'Chaam', 'Terheijden', 'Oudenbosch', 'Rijen'].map(plaats => (
              <span class="bg-white border border-asphalt-line text-pioneer-navy text-sm font-medium px-3.5 py-1.5 rounded-full">
                {plaats}
              </span>
            ))}
          </div>
          <a
            href="/contact"
            class="inline-flex items-center gap-2 px-5 py-3 rounded-lg bg-pioneer-navy hover:bg-pioneer-navy-light text-white font-semibold text-sm transition-colors"
          >
            Neem contact op
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
        </div>

        <!-- Map placeholder -->
        <div class="bg-asphalt-line rounded-2xl aspect-video flex items-center justify-center text-asphalt/40 text-sm">
          🗺️ Kaart volgt — Google Maps embed
        </div>
      </div>
    </div>
  </section>
</Layout>
