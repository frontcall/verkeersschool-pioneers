---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Vacatures"
  description="Werk mee bij Verkeersschool Pioneers. Bekijk onze vacatures en solliciteer direct."
>
  <!-- ══ HERO ══ -->
  <section class="hero-bg text-white py-16 md:py-20 relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="orb-drift absolute -top-32 right-0 w-[520px] h-[520px] rounded-full" style="filter:blur(90px); background: radial-gradient(circle, rgba(214,40,57,0.45) 0%, transparent 65%);"></div>
      <div class="orb-drift-slow absolute bottom-0 -left-20 w-[380px] h-[380px] rounded-full" style="filter:blur(90px); background: radial-gradient(circle, rgba(42,67,116,0.55) 0%, transparent 65%);"></div>
    </div>
    <div class="relative z-10 max-w-[1280px] mx-auto px-5 sm:px-8">
      <p class="hero-item text-pioneer-red font-semibold text-xs uppercase tracking-[0.18em] mb-4 flex items-center gap-2" data-delay="1">
        <span class="w-5 h-px bg-pioneer-red inline-block"></span>Werken bij Pioneers
      </p>
      <h1 class="hero-item font-display font-bold text-4xl md:text-5xl tracking-tight mb-4" data-delay="2">
        Vacatures
      </h1>
      <p class="hero-item text-white/65 text-lg max-w-lg" data-delay="3">
        Wil jij onderdeel worden van Verkeersschool Pioneers? We zijn altijd op zoek naar gemotiveerde mensen.
      </p>
    </div>
  </section>

  <!-- ══ INTRO ══ -->
  <section class="py-14 md:py-20 bg-white">
    <div class="max-w-[1280px] mx-auto px-5 sm:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
        <div class="reveal-item">
          <p class="text-pioneer-red font-semibold text-xs uppercase tracking-[0.18em] mb-3 flex items-center gap-2">
            <span class="w-5 h-px bg-pioneer-red inline-block"></span>Waarom Pioneers?
          </p>
          <h2 class="font-display font-bold text-3xl md:text-4xl tracking-tight mb-6">
            Maak het verschil
          </h2>
          <div class="space-y-4 text-asphalt leading-relaxed">
            <p>
              Bij Verkeersschool Pioneers geloven we dat goed rijonderwijs verder gaat dan een rijbewijs halen. We geven leerlingen iets waardevols mee voor de rest van hun leven.
            </p>
            <p>
              Als collega bij Pioneers werk je in een hecht team, met flexibele werktijden en ruimte voor jouw eigen aanpak.
            </p>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-8">
            {[
              { title: 'Flexibele werktijden', body: '7 dagen per week, ook avonden — jij bepaalt mee.' },
              { title: 'Persoonlijke aanpak', body: 'Klein team, korte lijnen en echte betrokkenheid.' },
              { title: 'Meerdere categorieën', body: 'Van B tot C en Taxi — brede mogelijkheden.' },
              { title: 'Regio Breda', body: 'Werkzaam in Breda en de wijde omgeving.' },
            ].map(({ title, body }) => (
              <div class="bg-off-white rounded-xl border border-asphalt-line p-4">
                <h3 class="font-display font-semibold text-pioneer-navy text-sm mb-1">{title}</h3>
                <p class="text-asphalt text-xs leading-relaxed">{body}</p>
              </div>
            ))}
          </div>
        </div>

        <div class="reveal-item" data-delay="2">
          <div class="bg-off-white rounded-2xl border border-asphalt-line p-8">
            <h2 class="font-display font-bold text-2xl tracking-tight mb-2 text-pioneer-navy">Open sollicitatie</h2>
            <p class="text-asphalt text-sm mb-6 leading-relaxed">
              Zie je geen specifieke vacature die past, maar wil je toch bij ons werken? Stuur een open sollicitatie — we lezen elke brief.
            </p>

            <form
              name="sollicitatie"
              method="POST"
              data-netlify="true"
              netlify-honeypot="bot-field"
              action="/bedankt"
              class="space-y-5"
            >
              <input type="hidden" name="form-name" value="sollicitatie" />
              <p class="hidden">
                <label>Laat dit veld leeg: <input name="bot-field" /></label>
              </p>

              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="sol-naam" class="block text-xs font-semibold text-pioneer-navy uppercase tracking-wider mb-1.5">Naam *</label>
                  <input
                    type="text"
                    id="sol-naam"
                    name="naam"
                    required
                    class="w-full px-4 py-3 rounded-lg border border-asphalt-line bg-white text-pioneer-navy placeholder-asphalt/50 focus:outline-none focus:border-pioneer-navy transition-colors text-sm"
                    placeholder="Jouw volledige naam"
                  />
                </div>
                <div>
                  <label for="sol-telefoon" class="block text-xs font-semibold text-pioneer-navy uppercase tracking-wider mb-1.5">Telefoon</label>
                  <input
                    type="tel"
                    id="sol-telefoon"
                    name="telefoon"
                    class="w-full px-4 py-3 rounded-lg border border-asphalt-line bg-white text-pioneer-navy placeholder-asphalt/50 focus:outline-none focus:border-pioneer-navy transition-colors text-sm"
                    placeholder="06-00000000"
                  />
                </div>
              </div>

              <div>
                <label for="sol-email" class="block text-xs font-semibold text-pioneer-navy uppercase tracking-wider mb-1.5">E-mailadres *</label>
                <input
                  type="email"
                  id="sol-email"
                  name="email"
                  required
                  class="w-full px-4 py-3 rounded-lg border border-asphalt-line bg-white text-pioneer-navy placeholder-asphalt/50 focus:outline-none focus:border-pioneer-navy transition-colors text-sm"
                  placeholder="jouw@email.nl"
                />
              </div>

              <div>
                <label for="sol-motivatie" class="block text-xs font-semibold text-pioneer-navy uppercase tracking-wider mb-1.5">Motivatie / bericht *</label>
                <textarea
                  id="sol-motivatie"
                  name="motivatie"
                  required
                  rows="5"
                  class="w-full px-4 py-3 rounded-lg border border-asphalt-line bg-white text-pioneer-navy placeholder-asphalt/50 focus:outline-none focus:border-pioneer-navy transition-colors text-sm resize-none"
                  placeholder="Vertel waarom jij bij Verkeersschool Pioneers wilt werken…"
                ></textarea>
              </div>

              <div>
                <label for="sol-cv" class="block text-xs font-semibold text-pioneer-navy uppercase tracking-wider mb-1.5">CV (optioneel)</label>
                <input
                  type="file"
                  id="sol-cv"
                  name="cv"
                  accept=".pdf,.doc,.docx"
                  class="w-full text-sm text-asphalt file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-pioneer-navy file:text-white hover:file:bg-pioneer-navy-light transition-colors"
                />
                <p class="text-xs text-asphalt/55 mt-1">PDF, Word — max. 5 MB</p>
              </div>

              <button
                type="submit"
                class="w-full py-3.5 rounded-lg bg-pioneer-red hover:bg-pioneer-red-dark text-white font-semibold transition-colors"
              >
                Sollicitatie versturen
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ BOTTOM CTA ══ -->
  <section class="hero-bg text-white py-14 relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="orb-drift absolute -top-20 right-1/4 w-[450px] h-[450px] rounded-full" style="filter:blur(90px); background: radial-gradient(circle, rgba(214,40,57,0.45) 0%, transparent 65%);"></div>
      <div class="orb-drift-slow absolute bottom-0 left-1/4 w-[350px] h-[350px] rounded-full" style="filter:blur(90px); background: radial-gradient(circle, rgba(42,67,116,0.55) 0%, transparent 65%);"></div>
    </div>
    <div class="relative z-10 max-w-[1280px] mx-auto px-5 sm:px-8 text-center">
      <div class="reveal-item">
        <h2 class="font-display font-bold text-2xl md:text-3xl tracking-tight mb-3">Liever direct contact?</h2>
        <p class="text-white/55 mb-7 max-w-md mx-auto">App ons via WhatsApp — we reageren snel.</p>
        <a
          href="https://wa.me/31643127001?text=Hallo%20Verkeersschool%20Pioneers!%20Ik%20wil%20graag%20solliciteren."
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2.5 px-7 py-3.5 rounded-xl bg-[#25D366] hover:bg-[#1ebe5d] text-white font-semibold transition-all duration-200 hover:shadow-lg hover:shadow-[#25D366]/25 hover:-translate-y-0.5"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
            <path d="M5.339 18.706A9.905 9.905 0 0 1 2 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10a9.934 9.934 0 0 1-5.127-1.417L2 22l2.339-3.294z"/>
          </svg>
          App ons via WhatsApp
        </a>
      </div>
    </div>
  </section>
</Layout>
