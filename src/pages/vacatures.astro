---
import Layout from '../layouts/Layout.astro';

// ─────────────────────────────────────────────
// Plak hier jouw Google Sheet ID
// (de lange code uit de URL van jouw sheet)
const SHEET_ID = 'JOUW_SHEET_ID_HIER';
// ─────────────────────────────────────────────

const categorieInfo = [
  { key: 'A',    label: 'Categorie A — Motor',       omschrijving: 'We zoeken een gecertificeerde rij-instructeur voor motorlessen (categorie A) in de regio Breda.' },
  { key: 'B',    label: 'Categorie B — Auto',         omschrijving: 'We zoeken een gediplomeerde rij-instructeur voor autolessen (categorie B) in de regio Breda.' },
  { key: 'C',    label: 'Categorie C — Vrachtwagen',  omschrijving: 'We zoeken een rij-instructeur voor vrachtwagenrijles (categorie C) in de regio Breda.' },
  { key: 'Taxi', label: 'Taxi-instructeur',            omschrijving: 'We zoeken een rij-instructeur voor taxirijles in de regio Breda.' },
];
---

<Layout
  title="Vacatures"
  description="Werk mee bij Verkeersschool Pioneers. Bekijk onze vacatures en solliciteer direct."
>
  <!-- ══ HERO ══ -->
  <section class="hero-bg text-white py-16 md:py-20 relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="orb-drift absolute -top-32 right-0 w-[520px] h-[520px] rounded-full" style="filter:blur(90px); background: radial-gradient(circle, rgba(214,40,57,0.45) 0%, transparent 65%);"></div>
      <div class="orb-drift-slow absolute bottom-0 -left-20 w-[380px] h-[380px] rounded-full" style="filter:blur(90px); background: radial-gradient(circle, rgba(42,67,116,0.55) 0%, transparent 65%);"></div>
    </div>
    <div class="relative z-10 max-w-[1280px] mx-auto px-5 sm:px-8">
      <p class="hero-item eyebrow mb-4" data-delay="1">Werken bij Pioneers</p>
      <h1 class="hero-item font-display font-bold text-4xl md:text-5xl tracking-tight mb-4" data-delay="2">Vacatures</h1>
      <p class="hero-item text-white/65 text-lg max-w-lg" data-delay="3">
        Wil jij onderdeel worden van Verkeersschool Pioneers? We zijn altijd op zoek naar gemotiveerde mensen.
      </p>
    </div>
  </section>

  <!-- ══ OPEN VACATURES ══ -->
  <section class="py-14 md:py-20 bg-off-white">
    <div class="max-w-[1280px] mx-auto px-5 sm:px-8">
      <div class="reveal-item mb-10">
        <p class="eyebrow mb-3">Openstaande vacatures</p>
        <h2 class="font-display font-bold text-3xl md:text-4xl tracking-tight">Instructeurs gezocht</h2>
      </div>

      <!-- Laadstatus -->
      <div id="vacatures-loading" class="text-asphalt/50 text-sm mb-6">Vacatures laden…</div>

      <!-- Kaarten (initieel verborgen, JS maakt ze zichtbaar) -->
      <div id="vacatures-grid" class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-5 hidden">
        {categorieInfo.map(({ key, label, omschrijving }) => (
          <div
            class="vacature-card bg-white rounded-2xl border border-asphalt-line p-7 flex flex-col hidden"
            data-categorie={key}
          >
            <span class="inline-block self-start px-3 py-1 rounded-full bg-pioneer-red/10 text-pioneer-red text-xs font-bold uppercase tracking-wider mb-4">
              Open
            </span>
            <h3 class="font-display font-bold text-xl tracking-tight text-pioneer-navy mb-3">{label}</h3>
            <p class="text-asphalt text-sm leading-relaxed flex-1 mb-6">{omschrijving}</p>
            <a
              href={`https://wa.me/31643127001?text=Hallo!%20Ik%20wil%20graag%20solliciteren%20als%20instructeur%20categorie%20${key}.`}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2 px-5 py-3 rounded-xl bg-pioneer-navy hover:bg-pioneer-navy/90 text-white font-semibold text-sm transition-all duration-200 hover:-translate-y-0.5"
            >
              Solliciteer via WhatsApp
            </a>
          </div>
        ))}
      </div>

      <!-- Geen vacatures bericht -->
      <div id="vacatures-leeg" class="hidden bg-white rounded-2xl border border-asphalt-line p-10 text-center max-w-lg mx-auto">
        <p class="text-asphalt/60 text-sm mb-2">Momenteel geen openstaande vacatures.</p>
        <p class="text-asphalt text-sm">Stuur gerust een open sollicitatie — we bewaren je gegevens voor toekomstige vacatures.</p>
      </div>
    </div>
  </section>

  <!-- ══ WAAROM + OPEN SOLLICITATIE ══ -->
  <section class="py-14 md:py-20 bg-white">
    <div class="max-w-[1280px] mx-auto px-5 sm:px-8">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12 items-start">
        <div class="reveal-item">
          <p class="eyebrow mb-3">Waarom Pioneers?</p>
          <h2 class="font-display font-bold text-3xl md:text-4xl tracking-tight mb-6">Maak het verschil</h2>
          <div class="space-y-4 text-asphalt leading-relaxed">
            <p>Bij Verkeersschool Pioneers geloven we dat goed rijonderwijs verder gaat dan een rijbewijs halen. We geven leerlingen iets waardevols mee voor de rest van hun leven.</p>
            <p>Als collega bij Pioneers werk je in een hecht team, met flexibele werktijden en ruimte voor jouw eigen aanpak.</p>
          </div>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-4 mt-8">
            {[
              { title: 'Flexibele werktijden', body: '7 dagen per week, ook avonden — jij bepaalt mee.' },
              { title: 'Persoonlijke aanpak',  body: 'Klein team, korte lijnen en echte betrokkenheid.' },
              { title: 'Meerdere categorieën', body: 'Van B tot C en Taxi — brede mogelijkheden.' },
              { title: 'Regio Breda',          body: 'Werkzaam in Breda en de wijde omgeving.' },
            ].map(({ title, body }) => (
              <div class="bg-off-white rounded-xl border border-asphalt-line p-4">
                <h3 class="font-display font-semibold text-pioneer-navy text-sm mb-1">{title}</h3>
                <p class="text-asphalt text-xs leading-relaxed">{body}</p>
              </div>
            ))}
          </div>
        </div>

        <div class="reveal-item" data-delay="2">
          <div class="bg-off-white rounded-2xl border border-asphalt-line p-8">
            <h2 class="font-display font-bold text-2xl tracking-tight mb-2 text-pioneer-navy">Open sollicitatie</h2>
            <p class="text-asphalt text-sm mb-6 leading-relaxed">
              Zie je geen specifieke vacature die past, maar wil je toch bij ons werken? Stuur een open sollicitatie — we lezen elke brief.
            </p>
            <form name="sollicitatie" method="POST" data-netlify="true" netlify-honeypot="bot-field" action="/bedankt" class="space-y-5">
              <input type="hidden" name="form-name" value="sollicitatie" />
              <p class="hidden"><label>Laat dit veld leeg: <input name="bot-field" /></label></p>
              <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <div>
                  <label for="sol-naam" class="block text-xs font-semibold text-pioneer-navy uppercase tracking-wider mb-1.5">Naam *</label>
                  <input type="text" id="sol-naam" name="naam" required class="w-full px-4 py-3 rounded-lg border border-asphalt-line bg-white text-pioneer-navy placeholder-asphalt/50 focus:outline-none focus:border-pioneer-navy transition-colors text-sm" placeholder="Jouw volledige naam" />
                </div>
                <div>
                  <label for="sol-telefoon" class="block text-xs font-semibold text-pioneer-navy uppercase tracking-wider mb-1.5">Telefoon</label>
                  <input type="tel" id="sol-telefoon" name="telefoon" class="w-full px-4 py-3 rounded-lg border border-asphalt-line bg-white text-pioneer-navy placeholder-asphalt/50 focus:outline-none focus:border-pioneer-navy transition-colors text-sm" placeholder="06-00000000" />
                </div>
              </div>
              <div>
                <label for="sol-email" class="block text-xs font-semibold text-pioneer-navy uppercase tracking-wider mb-1.5">E-mailadres *</label>
                <input type="email" id="sol-email" name="email" required class="w-full px-4 py-3 rounded-lg border border-asphalt-line bg-white text-pioneer-navy placeholder-asphalt/50 focus:outline-none focus:border-pioneer-navy transition-colors text-sm" placeholder="jouw@email.nl" />
              </div>
              <div>
                <label for="sol-motivatie" class="block text-xs font-semibold text-pioneer-navy uppercase tracking-wider mb-1.5">Motivatie / bericht *</label>
                <textarea id="sol-motivatie" name="motivatie" required rows="5" class="w-full px-4 py-3 rounded-lg border border-asphalt-line bg-white text-pioneer-navy placeholder-asphalt/50 focus:outline-none focus:border-pioneer-navy transition-colors text-sm resize-none" placeholder="Vertel waarom jij bij Verkeersschool Pioneers wilt werken…"></textarea>
              </div>
              <div>
                <label for="sol-cv" class="block text-xs font-semibold text-pioneer-navy uppercase tracking-wider mb-1.5">CV (optioneel)</label>
                <input type="file" id="sol-cv" name="cv" accept=".pdf,.doc,.docx" class="w-full text-sm text-asphalt file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:text-xs file:font-semibold file:bg-pioneer-navy file:text-white hover:file:bg-pioneer-navy-light transition-colors" />
                <p class="text-xs text-asphalt/55 mt-1">PDF, Word — max. 5 MB</p>
              </div>
              <button type="submit" class="w-full py-3.5 rounded-lg bg-pioneer-red hover:bg-pioneer-red-dark text-white font-semibold transition-colors">
                Sollicitatie versturen
              </button>
            </form>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ BOTTOM CTA ══ -->
  <section class="hero-bg text-white py-14 relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="orb-drift absolute -top-20 right-1/4 w-[450px] h-[450px] rounded-full" style="filter:blur(90px); background: radial-gradient(circle, rgba(214,40,57,0.45) 0%, transparent 65%);"></div>
      <div class="orb-drift-slow absolute bottom-0 left-1/4 w-[350px] h-[350px] rounded-full" style="filter:blur(90px); background: radial-gradient(circle, rgba(42,67,116,0.55) 0%, transparent 65%);"></div>
    </div>
    <div class="relative z-10 max-w-[1280px] mx-auto px-5 sm:px-8 text-center">
      <div class="reveal-item">
        <h2 class="font-display font-bold text-2xl md:text-3xl tracking-tight mb-3">Liever direct contact?</h2>
        <p class="text-white/55 mb-7 max-w-md mx-auto">App ons via WhatsApp — we reageren snel.</p>
        <a href="https://wa.me/31643127001?text=Hallo%20Verkeersschool%20Pioneers!%20Ik%20wil%20graag%20solliciteren." target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2.5 px-7 py-3.5 rounded-xl bg-[#25D366] hover:bg-[#1ebe5d] text-white font-semibold transition-all duration-200 hover:shadow-lg hover:shadow-[#25D366]/25 hover:-translate-y-0.5">
          <svg class="w-5 h-5" viewBox="0 0 448 512" fill="currentColor">
            <path d="M380.9 97.1C339 55.1 283.2 32 223.9 32c-122.4 0-222 99.6-222 222 0 39.1 10.2 77.3 29.6 111L0 480l117.7-30.9c32.4 17.7 68.9 27 106.1 27h.1c122.3 0 224.1-99.6 224.1-222 0-59.3-25.2-115-67.1-157zm-157 341.6c-33.2 0-65.7-8.9-94-25.7l-6.7-4-69.8 18.3L72 359.2l-4.4-7c-18.5-29.4-28.2-63.3-28.2-98.2 0-101.7 82.8-184.5 184.6-184.5 49.3 0 95.6 19.2 130.4 54.1 34.8 34.9 56.2 81.2 56.1 130.5 0 101.8-84.9 184.6-186.6 184.6zm101.2-138.2c-5.5-2.8-32.8-16.2-37.9-18-5.1-1.9-8.8-2.8-12.5 2.8-3.7 5.6-14.3 18-17.6 21.8-3.2 3.7-6.5 4.2-12 1.4-32.6-16.3-54-29.1-75.5-66-5.7-9.8 5.7-9.1 16.3-30.3 1.8-3.7.9-6.9-.5-9.7-1.4-2.8-12.5-30.1-17.1-41.2-4.5-10.8-9.1-9.3-12.5-9.5-3.2-.2-6.9-.2-10.6-.2-3.7 0-9.7 1.4-14.8 6.9-5.1 5.6-19.4 19-19.4 46.3 0 27.3 19.9 53.7 22.6 57.4 2.8 3.7 39.1 59.7 94.8 83.8 35.2 15.2 49 16.5 66.6 13.9 10.7-1.6 32.8-13.4 37.4-26.4 4.6-13 4.6-24.1 3.2-26.4-1.3-2.5-5-3.9-10.5-6.6z"/>
          </svg>
          App ons via WhatsApp
        </a>
      </div>
    </div>
  </section>
</Layout>

<script define:vars={{ SHEET_ID }}>
  const CSV_URL = `https://docs.google.com/spreadsheets/d/${SHEET_ID}/export?format=csv`;

  async function laadVacatures() {
    const loading = document.getElementById('vacatures-loading');
    const grid    = document.getElementById('vacatures-grid');
    const leeg    = document.getElementById('vacatures-leeg');
    const kaarten = document.querySelectorAll('.vacature-card');

    try {
      const res  = await fetch(CSV_URL);
      const tekst = await res.text();

      // CSV parsen: sla eerste rij (header) over
      const regels = tekst.trim().split('\n').slice(1);
      const openSet = new Set();

      for (const regel of regels) {
        const [categorie, open] = regel.split(',').map(s => s.trim().replace(/"/g, ''));
        if (open.toUpperCase() === 'TRUE') openSet.add(categorie);
      }

      let aantalOpen = 0;
      kaarten.forEach(kaart => {
        const cat = kaart.getAttribute('data-categorie');
        if (openSet.has(cat)) {
          kaart.classList.remove('hidden');
          aantalOpen++;
        }
      });

      loading.classList.add('hidden');

      if (aantalOpen > 0) {
        grid.classList.remove('hidden');
      } else {
        leeg.classList.remove('hidden');
      }
    } catch {
      loading.textContent = '';
      leeg.classList.remove('hidden');
    }
  }

  laadVacatures();
</script>
