---
import Layout from '../layouts/Layout.astro';
import SectionDivider from '../components/SectionDivider.astro';
---

<Layout
  title="Home"
  description="Verkeersschool Pioneers in Breda — rijlessen voor auto, motor, scooter, vrachtwagen en taxi. Professioneel, persoonlijk en slagingsgericht."
>
  <!-- HERO -->
  <section class="bg-pioneer-navy text-white">
    <div class="max-w-[1280px] mx-auto px-5 sm:px-8 py-20 md:py-28 lg:py-36">
      <div class="max-w-2xl">
        <p class="text-pioneer-red font-semibold text-sm uppercase tracking-widest mb-4">
          Rijschool in Breda &amp; omgeving
        </p>
        <h1 class="font-display font-bold text-4xl sm:text-5xl lg:text-6xl leading-[1.08] tracking-tight mb-6">
          Jouw route naar<br />
          <span class="text-pioneer-red">je rijbewijs</span>
        </h1>
        <p class="text-white/70 text-lg leading-relaxed mb-8 max-w-xl">
          Voor auto, motor, scooter, vrachtwagen en taxi. Persoonlijk contact, professionele instructeurs en een heldere prijs — zo werkt het bij Verkeersschool Pioneers.
        </p>
        <div class="flex flex-wrap gap-4">
          <a
            href="/pakketten"
            class="inline-flex items-center gap-2 px-6 py-3.5 rounded-lg bg-pioneer-red hover:bg-pioneer-red-dark text-white font-semibold transition-colors"
          >
            Bekijk pakketten
            <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
              <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
            </svg>
          </a>
          <a
            href="/contact"
            class="inline-flex items-center gap-2 px-6 py-3.5 rounded-lg border border-white/25 hover:border-white/50 text-white font-semibold transition-colors hover:bg-white/5"
          >
            Plan een proefles
          </a>
        </div>
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- INTRO -->
  <section class="py-16 md:py-20">
    <div class="max-w-[1280px] mx-auto px-5 sm:px-8">
      <div class="max-w-xl mb-12">
        <h2 class="font-display font-bold text-3xl md:text-4xl tracking-tight mb-4">
          Waarom kiezen voor <span class="text-pioneer-red">Pioneers</span>?
        </h2>
        <p class="text-asphalt text-lg leading-relaxed">
          Een rijbewijs haal je maar één keer. Wij zorgen dat jij goed voorbereid achter het stuur zit.
        </p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
        {[
          { icon: '🎯', title: 'Gericht op slagen', body: 'We bereiden je stap voor stap voor op je praktijkexamen, zodat je zeker en zelfverzekerd rijdt.' },
          { icon: '👤', title: 'Persoonlijke aanpak', body: 'Elke leerling is anders. We passen het lesritme en de aanpak aan jouw tempo aan.' },
          { icon: '📋', title: 'Transparante prijs', body: 'Geen verrassingen achteraf. Je ziet vooraf exact wat je pakket inhoudt en wat het kost.' },
        ].map(({ icon, title, body }) => (
          <div class="bg-white rounded-2xl border border-asphalt-line p-6 hover:shadow-md transition-shadow">
            <div class="text-3xl mb-3">{icon}</div>
            <h3 class="font-display font-bold text-lg mb-2">{title}</h3>
            <p class="text-asphalt text-sm leading-relaxed">{body}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- PAKKETTEN TEASER -->
  <section class="py-16 md:py-20 bg-white">
    <div class="max-w-[1280px] mx-auto px-5 sm:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10">
        <div>
          <p class="text-pioneer-red font-semibold text-sm uppercase tracking-widest mb-2">Rijbewijscategorieën</p>
          <h2 class="font-display font-bold text-3xl md:text-4xl tracking-tight">
            Welk rijbewijs wil jij halen?
          </h2>
        </div>
        <a href="/pakketten" class="text-pioneer-navy font-semibold text-sm hover:text-pioneer-red transition-colors flex items-center gap-1 whitespace-nowrap">
          Alle pakketten &amp; prijzen
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
      <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4">
        {[
          { slug: 'auto', label: 'Auto', icon: '🚗', sub: 'B-rijbewijs' },
          { slug: 'motor', label: 'Motor', icon: '🏍️', sub: 'A-rijbewijs' },
          { slug: 'scooter', label: 'Scooter', icon: '🛵', sub: 'AM-rijbewijs' },
          { slug: 'vrachtwagen', label: 'Vrachtwagen', icon: '🚛', sub: 'C-rijbewijs' },
          { slug: 'taxi', label: 'Taxi', icon: '🚕', sub: 'Taxipas' },
        ].map(({ slug, label, icon, sub }) => (
          <a
            href={`/pakketten#${slug}`}
            class="group flex flex-col items-center text-center bg-off-white hover:bg-pioneer-navy rounded-2xl border border-asphalt-line hover:border-pioneer-navy p-5 transition-all duration-200 hover:shadow-lg"
          >
            <span class="text-3xl mb-3">{icon}</span>
            <span class="font-display font-bold text-pioneer-navy group-hover:text-white transition-colors">{label}</span>
            <span class="text-xs text-asphalt group-hover:text-white/60 mt-1 transition-colors">{sub}</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- REVIEWS TEASER -->
  <section class="py-16 md:py-20">
    <div class="max-w-[1280px] mx-auto px-5 sm:px-8">
      <div class="flex flex-col sm:flex-row sm:items-end justify-between gap-4 mb-10">
        <div>
          <p class="text-pioneer-red font-semibold text-sm uppercase tracking-widest mb-2">Google Reviews</p>
          <h2 class="font-display font-bold text-3xl md:text-4xl tracking-tight">
            Wat onze leerlingen zeggen
          </h2>
        </div>
        <a href="/reviews" class="text-pioneer-navy font-semibold text-sm hover:text-pioneer-red transition-colors flex items-center gap-1 whitespace-nowrap">
          Alle reviews
          <svg class="w-4 h-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7"/>
          </svg>
        </a>
      </div>
      <!-- Placeholder reviews — VERVANG MET ECHTE GOOGLE REVIEWS VOOR LAUNCH -->
      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        {[
          { name: 'Fatima A.', rating: 5, text: 'Geweldige rijschool! De instructeur had heel veel geduld en ik ben in één keer geslaagd. Echt een aanrader voor iedereen in Breda.' },
          { name: 'Daan V.', rating: 5, text: 'Duidelijke uitleg, fijne sfeer en een eerlijke prijs. Het pakket was precies wat ik nodig had. Na mijn examen meteen geslaagd!' },
          { name: 'Yassine M.', rating: 5, text: 'Professionele rijschool met persoonlijke aandacht. Je merkt dat ze echt willen dat je slaagt.' },
        ].map(({ name, rating, text }) => (
          <div class="bg-white rounded-2xl border border-asphalt-line p-6">
            <div class="flex items-center gap-1 mb-3">
              {Array.from({ length: rating }).map(() => (
                <svg class="w-4 h-4 text-yellow-400 fill-current" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
              ))}
            </div>
            <p class="text-asphalt text-sm leading-relaxed mb-4">"{text}"</p>
            <p class="font-semibold text-pioneer-navy text-sm">{name}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <SectionDivider />

  <!-- CTA BAND -->
  <section class="bg-pioneer-navy text-white py-14 md:py-20">
    <div class="max-w-[1280px] mx-auto px-5 sm:px-8 text-center">
      <h2 class="font-display font-bold text-3xl md:text-4xl tracking-tight mb-4">
        Klaar om te beginnen?
      </h2>
      <p class="text-white/65 text-lg mb-8 max-w-lg mx-auto">
        Neem contact op via WhatsApp — we antwoorden snel en helpen je graag verder.
      </p>
      <div class="flex flex-wrap items-center justify-center gap-4">
        <a
          href="https://wa.me/31000000000"
          data-todo="whatsapp-number-pending"
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2.5 px-6 py-3.5 rounded-lg bg-[#25D366] hover:bg-[#1ebe5d] text-white font-semibold transition-colors shadow-lg"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
            <path d="M5.339 18.706A9.905 9.905 0 0 1 2 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10a9.934 9.934 0 0 1-5.127-1.417L2 22l2.339-3.294z"/>
          </svg>
          Chat via WhatsApp
        </a>
        <a
          href="/contact"
          class="inline-flex items-center gap-2 px-6 py-3.5 rounded-lg border border-white/25 hover:border-white/50 text-white font-semibold transition-colors hover:bg-white/5"
        >
          Of stuur een bericht
        </a>
      </div>
    </div>
  </section>
</Layout>
