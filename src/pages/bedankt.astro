---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Bedankt voor je inschrijving"
  description="Je inschrijving bij Verkeersschool Pioneers is ontvangen. Wij nemen snel contact met je op."
>
  <section class="hero-bg text-white py-14 relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="orb-drift absolute -top-32 right-0 w-[520px] h-[520px] rounded-full" style="filter:blur(90px); background: radial-gradient(circle, rgba(214,40,57,0.45) 0%, transparent 65%);"></div>
      <div class="orb-drift-slow absolute bottom-0 -left-20 w-[380px] h-[380px] rounded-full" style="filter:blur(90px); background: radial-gradient(circle, rgba(42,67,116,0.55) 0%, transparent 65%);"></div>
    </div>
    <div class="relative z-10 max-w-[1280px] mx-auto px-5 sm:px-8">
      <p class="hero-item text-pioneer-red font-semibold text-xs uppercase tracking-[0.18em] mb-4 flex items-center gap-2" data-delay="1">
        <span class="w-5 h-px bg-pioneer-red inline-block"></span>Inschrijving ontvangen
      </p>
      <h1 class="hero-item font-display font-bold text-4xl md:text-5xl tracking-tight mb-3" data-delay="2">
        Bedankt!
      </h1>
      <p class="hero-item text-white/65 text-lg max-w-lg" data-delay="3">
        Je inschrijving is succesvol verstuurd.
      </p>
    </div>
  </section>

  <section class="py-20 dot-grid-bg">
    <div class="max-w-[560px] mx-auto px-5 sm:px-8 text-center">

      <!-- Check icon -->
      <div class="reveal-item w-20 h-20 rounded-full bg-success-soft/10 border-2 border-success-soft/30 flex items-center justify-center mx-auto mb-8">
        <svg class="w-10 h-10 text-success-soft" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
          <path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/>
        </svg>
      </div>

      <div class="reveal-item bg-white rounded-2xl border border-asphalt-line p-8 mb-6 text-left">
        <h2 class="font-display font-bold text-xl text-pioneer-navy mb-4">Wat gebeurt er nu?</h2>
        <ol class="space-y-4">
          {[
            { n: '1', t: 'Bevestiging per e-mail', d: 'Je ontvangt een kopie van je inschrijving in je inbox.' },
            { n: '2', t: 'Wij nemen contact op', d: 'Binnen één werkdag bellen of appen we je voor een korte intake.' },
            { n: '3', t: 'Eerste les plannen', d: 'Samen kiezen we een startmoment dat voor jou werkt.' },
          ].map(({ n, t, d }) => (
            <li class="flex gap-3.5">
              <span class="flex-shrink-0 w-6 h-6 rounded-full bg-pioneer-red/10 text-pioneer-red text-xs font-bold flex items-center justify-center mt-0.5">{n}</span>
              <div>
                <p class="font-semibold text-pioneer-navy text-sm">{t}</p>
                <p class="text-asphalt text-xs leading-relaxed mt-0.5">{d}</p>
              </div>
            </li>
          ))}
        </ol>
      </div>

      <div class="reveal-item flex flex-col sm:flex-row gap-3 justify-center">
        <a
          href="/"
          class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl border-2 border-pioneer-navy text-pioneer-navy font-semibold text-sm hover:bg-pioneer-navy hover:text-white transition-all duration-200"
        >
          Terug naar home
        </a>
        <a
          href="https://wa.me/31643127001?text=Hallo!%20Ik%20heb%20net%20een%20inschrijving%20ingestuurd."
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 px-6 py-3 rounded-xl bg-[#25D366] hover:bg-[#1fbd59] text-white font-semibold text-sm transition-all duration-200"
        >
          <svg class="w-4 h-4" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
            <path d="M5.339 18.706A9.905 9.905 0 0 1 2 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10a9.934 9.934 0 0 1-5.127-1.417L2 22l2.339-3.294z"/>
          </svg>
          App ons
        </a>
      </div>
    </div>
  </section>
</Layout>
