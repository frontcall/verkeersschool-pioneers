---
import Layout from '../layouts/Layout.astro';

// Placeholder reviews — VERVANG MET ECHTE GOOGLE REVIEWS VOOR LAUNCH
// data-todo="google-reviews-pending — Google Bedrijfsprofiel link aanleveren"
const placeholderReviews = [
  { name: 'Fatima A.', rating: 5, date: 'Juni 2025', text: 'Geweldige rijschool! De instructeur had heel veel geduld en ik ben in één keer geslaagd. De lessen waren duidelijk en professioneel. Echt een aanrader voor iedereen die wil leren rijden in Breda.' },
  { name: 'Daan V.', rating: 5, date: 'Mei 2025', text: 'Duidelijke uitleg, fijne sfeer en een eerlijke prijs. Het pakket was precies wat ik nodig had. Na mijn rij-examen meteen geslaagd!' },
  { name: 'Yassine M.', rating: 5, date: 'April 2025', text: 'Professionele rijschool met persoonlijke aandacht. Je merkt dat ze echt willen dat je slaagt, niet alleen de uren vol maken.' },
  { name: 'Lisa de B.', rating: 5, date: 'Maart 2025', text: 'Ik had faalangst voor het examen, maar door de goede begeleiding voelde ik me zeker. In één keer geslaagd!' },
  { name: 'Rachid E.', rating: 5, date: 'Februari 2025', text: 'Fijn contact, soepele planning en goede instructeurs. Het motorrijbewijs heb ik hier gehaald en ik zou ze zeker aanraden.' },
  { name: 'Sophie H.', rating: 4, date: 'Januari 2025', text: 'Goede ervaring. De lessen waren gestructureerd en de instructeur had altijd nuttige feedback. Prima rijschool.' },
];
---

<Layout
  title="Reviews"
  description="Lees wat leerlingen van Verkeersschool Pioneers vinden — eerlijke Google Reviews van mensen die hier hun rijbewijs hebben gehaald."
>
  <!-- Page header -->
  <section class="bg-pioneer-navy text-white py-16 md:py-20">
    <div class="max-w-[1280px] mx-auto px-5 sm:px-8">
      <p class="text-pioneer-red font-semibold text-sm uppercase tracking-widest mb-3">Reviews</p>
      <h1 class="font-display font-bold text-4xl md:text-5xl tracking-tight mb-4">
        Wat onze leerlingen zeggen
      </h1>
      <!-- Gemiddelde score placeholder -->
      <div class="flex items-center gap-3 mt-6">
        <div class="flex items-center gap-1">
          {Array.from({ length: 5 }).map(() => (
            <svg class="w-6 h-6 text-yellow-400 fill-current" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
          ))}
        </div>
        <span class="font-display font-bold text-3xl">5.0</span>
        <span class="text-white/50 text-sm">op Google</span>
      </div>
    </div>
  </section>

  <!-- Reviews grid -->
  <section class="py-16 md:py-20">
    <div class="max-w-[1280px] mx-auto px-5 sm:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 mb-10">
        {placeholderReviews.map(({ name, rating, date, text }) => (
          <div class="bg-white rounded-2xl border border-asphalt-line p-6 flex flex-col">
            <div class="flex items-center justify-between mb-3">
              <div class="flex items-center gap-1">
                {Array.from({ length: rating }).map(() => (
                  <svg class="w-4 h-4 text-yellow-400 fill-current" viewBox="0 0 20 20">
                    <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                  </svg>
                ))}
              </div>
              <span class="text-xs text-asphalt">{date}</span>
            </div>
            <p class="text-asphalt text-sm leading-relaxed flex-1 mb-4">"{text}"</p>
            <div class="flex items-center gap-2">
              <div class="w-7 h-7 rounded-full bg-pioneer-navy/10 flex items-center justify-center text-pioneer-navy font-bold text-xs">
                {name[0]}
              </div>
              <p class="font-semibold text-pioneer-navy text-sm">{name}</p>
            </div>
          </div>
        ))}
      </div>

      <!-- Google Reviews CTA -->
      <!-- data-todo="google-profile-link-pending" -->
      <div class="text-center">
        <a
          href="#"
          data-todo="google-profile-link-pending"
          class="inline-flex items-center gap-2 px-6 py-3 rounded-lg border border-asphalt-line hover:border-pioneer-navy text-pioneer-navy font-semibold text-sm transition-colors hover:bg-white"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
          </svg>
          Bekijk alle reviews op Google
        </a>
      </div>
    </div>
  </section>
</Layout>
