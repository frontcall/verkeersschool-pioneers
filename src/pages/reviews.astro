---
import Layout from '../layouts/Layout.astro';

const reviews = [
  {
    name: 'Emma',
    rating: 5,
    text: 'Dankzij de juiste leermethode ben ik in één keer geslaagd. Heel erg tevreden met de aanpak van de instructeur. Absoluut een aanrader!',
  },
  {
    name: 'Eddie',
    rating: 5,
    text: 'Uitstekende rijschool en een geweldige aanpak. De instructeur legt alles goed uit en heeft veel geduld. Echt aanbevolen!',
  },
  {
    name: 'Mike',
    rating: 5,
    text: 'Geweldige lessen en geslaagd voor mijn examen. Verkeersschool Pioneers weet hoe ze leerlingen goed voorbereiden.',
  },
  {
    name: 'Eugenie',
    rating: 5,
    text: 'Vriendelijke instructeur, uitstekende leermethode en een fijne, welkome sfeer. Ik zou hier zeker opnieuw rijlessen nemen!',
  },
];
---

<Layout
  title="Reviews"
  description="Lees wat leerlingen van Verkeersschool Pioneers vinden — 4,7 sterren op Google. Eerlijke ervaringen van mensen die hier hun rijbewijs hebben gehaald."
>
  <!-- Page header -->
  <section class="bg-pioneer-navy text-white py-16 md:py-20">
    <div class="max-w-[1280px] mx-auto px-5 sm:px-8">
      <p class="text-pioneer-red font-semibold text-sm uppercase tracking-widest mb-3">Reviews</p>
      <h1 class="font-display font-bold text-4xl md:text-5xl tracking-tight mb-4">
        Wat onze leerlingen zeggen
      </h1>
      <div class="flex items-center gap-3 mt-6">
        <div class="flex items-center gap-1">
          {Array.from({ length: 5 }).map(() => (
            <svg class="w-6 h-6 text-yellow-400 fill-current" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
          ))}
        </div>
        <span class="font-display font-bold text-3xl">4,7</span>
        <span class="text-white/50 text-sm">op Google</span>
      </div>
    </div>
  </section>

  <!-- Reviews grid -->
  <section class="py-16 md:py-20">
    <div class="max-w-[1280px] mx-auto px-5 sm:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-10 max-w-3xl">
        {reviews.map(({ name, rating, text }) => (
          <div class="bg-white rounded-2xl border border-asphalt-line p-6 flex flex-col">
            <div class="flex items-center gap-1 mb-4">
              {Array.from({ length: rating }).map(() => (
                <svg class="w-4 h-4 text-yellow-400 fill-current" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
              ))}
            </div>
            <p class="text-asphalt text-sm leading-relaxed flex-1 mb-4">"{text}"</p>
            <div class="flex items-center gap-2">
              <div class="w-8 h-8 rounded-full bg-pioneer-navy/10 flex items-center justify-center text-pioneer-navy font-bold text-sm">
                {name[0]}
              </div>
              <p class="font-semibold text-pioneer-navy text-sm">{name}</p>
            </div>
          </div>
        ))}
      </div>

      <!-- Google Reviews CTA -->
      <div class="bg-off-white rounded-2xl border border-asphalt-line p-8 max-w-md">
        <h3 class="font-display font-bold text-lg mb-2">Meer reviews lezen?</h3>
        <p class="text-asphalt text-sm mb-5">Bekijk alle beoordelingen op ons Google Bedrijfsprofiel.</p>
        <a
          href="#"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg border border-asphalt-line bg-white hover:border-pioneer-navy text-pioneer-navy font-semibold text-sm transition-colors"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
          </svg>
          Bekijk alle reviews op Google
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="bg-pioneer-navy text-white py-14">
    <div class="max-w-[1280px] mx-auto px-5 sm:px-8 text-center">
      <h2 class="font-display font-bold text-2xl md:text-3xl tracking-tight mb-3">
        Jij kunt de volgende zijn
      </h2>
      <p class="text-white/60 mb-7 max-w-md mx-auto">De meeste leerlingen slagen in één keer. Plan je gratis proefles via WhatsApp.</p>
      <a
        href="https://wa.me/31643127001?text=Hallo!%20Ik%20wil%20graag%20een%20gratis%20proefles%20plannen."
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2.5 px-7 py-3.5 rounded-lg bg-pioneer-red hover:bg-pioneer-red-dark text-white font-semibold transition-colors"
      >
        Plan een gratis proefles
      </a>
    </div>
  </section>
</Layout>
