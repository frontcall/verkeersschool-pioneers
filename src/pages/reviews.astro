---
import Layout from '../layouts/Layout.astro';

const reviews = [
  {
    name: 'Emma van Dijk',
    initial: 'E',
    rating: 5,
    text: 'Dankzij de juiste leermethode ben ik in één keer geslaagd. Heel erg tevreden met de aanpak van de instructeur — geduldig, duidelijk en echt betrokken. Absoluut een aanrader voor iedereen die zijn rijbewijs wil halen!',
    detail: 'B-rijbewijs, geslaagd in 1x',
    delay: '1',
  },
  {
    name: 'Eddie Janssen',
    initial: 'E',
    rating: 5,
    text: 'Uitstekende rijschool en een geweldige aanpak. De instructeur legt alles goed uit en heeft veel geduld. Les in het Engels was geen enkel probleem — alles werd helder uitgelegd. Echt aanbevolen!',
    detail: 'B-rijbewijs (in het Engels)',
    delay: '2',
  },
  {
    name: 'Mike S.',
    initial: 'M',
    rating: 5,
    text: 'Na twee mislukte pogingen bij andere rijscholen ben ik hier in één keer geslaagd. De aanpak is echt anders — persoonlijker, effectiever en zonder dat je je gehaast voelt. Verkeersschool Pioneers weet hoe ze leerlingen goed voorbereiden.',
    detail: 'B-rijbewijs, geslaagd na eerdere pogingen',
    delay: '3',
  },
  {
    name: 'Eugenie B.',
    initial: 'E',
    rating: 5,
    text: 'Vriendelijke instructeur, uitstekende leermethode en een fijne, welkome sfeer. Ik voelde me altijd op mijn gemak achter het stuur. Ik zou hier zeker opnieuw rijlessen nemen!',
    detail: 'B-rijbewijs automaat',
    delay: '4',
  },
];
---

<Layout
  title="Reviews"
  description="Lees wat leerlingen van Verkeersschool Pioneers vinden — 4,7 sterren op Google. Eerlijke ervaringen van mensen die hier hun rijbewijs hebben gehaald."
>
  <!-- Page header -->
  <section class="hero-bg text-white py-16 md:py-24 relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="orb-drift absolute -top-32 right-0 w-[520px] h-[520px] rounded-full" style="filter:blur(90px); background: radial-gradient(circle, rgba(214,40,57,0.45) 0%, transparent 65%);"></div>
      <div class="orb-drift-slow absolute bottom-0 -left-20 w-[380px] h-[380px] rounded-full" style="filter:blur(90px); background: radial-gradient(circle, rgba(42,67,116,0.55) 0%, transparent 65%);"></div>
    </div>
    <div class="relative z-10 max-w-[1280px] mx-auto px-5 sm:px-8">
      <p class="hero-item eyebrow mb-4" data-delay="1">Google Reviews</p>
      <h1 class="hero-item font-display font-bold text-4xl md:text-5xl tracking-tight mb-4" data-delay="2">
        Wat onze leerlingen zeggen
      </h1>
      <div class="hero-item flex items-center gap-3" data-delay="3">
        <div class="flex items-center gap-1">
          {Array.from({ length: 5 }).map(() => (
            <svg class="w-6 h-6 text-[#FBBC04] fill-current" viewBox="0 0 20 20">
              <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
            </svg>
          ))}
        </div>
        <span class="font-display font-bold text-3xl">4,7</span>
        <span class="text-white/50">op Google</span>
      </div>
    </div>
  </section>

  <!-- Stats strip -->
  <div class="bg-white border-b border-asphalt-line">
    <div class="max-w-[1280px] mx-auto px-5 sm:px-8">
      <div class="grid grid-cols-3 divide-x divide-asphalt-line">
        {[
          { value: '4,7★', label: 'Gemiddelde score' },
          { value: '100%', label: 'Slaagt uiteindelijk' },
          { value: '10+', label: 'Jaar ervaring' },
        ].map(({ value, label }) => (
          <div class="flex flex-col items-center text-center py-6 px-4">
            <span class="font-display font-bold text-2xl sm:text-3xl text-pioneer-red leading-none mb-1">{value}</span>
            <span class="text-asphalt text-xs sm:text-sm mt-1">{label}</span>
          </div>
        ))}
      </div>
    </div>
  </div>

  <!-- Reviews grid -->
  <section class="py-16 md:py-24 dot-grid-bg">
    <div class="max-w-[1280px] mx-auto px-5 sm:px-8">
      <div class="grid grid-cols-1 md:grid-cols-2 gap-6 mb-12">
        {reviews.map(({ name, initial, rating, text, detail, delay }) => (
          <div class="reveal-item card-lift relative bg-white rounded-2xl border border-asphalt-line p-7 flex flex-col overflow-hidden" data-delay={delay}>
            <!-- Decorative quote mark -->
            <span class="absolute -top-3 -right-1 text-[7rem] leading-none font-serif text-pioneer-navy/[0.04] select-none pointer-events-none" aria-hidden="true">"</span>

            <!-- Stars -->
            <div class="flex items-center gap-0.5 mb-5 relative">
              {Array.from({ length: rating }).map(() => (
                <svg class="w-5 h-5 text-[#FBBC04] fill-current" viewBox="0 0 20 20">
                  <path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.69h3.462c.969 0 1.371 1.24.588 1.81l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.69l1.07-3.292z"/>
                </svg>
              ))}
            </div>

            <p class="text-asphalt text-sm leading-relaxed flex-1 mb-6 relative">"{text}"</p>

            <div class="flex items-center justify-between border-t border-asphalt-line/60 pt-4">
              <div class="flex items-center gap-3">
                <div class="w-10 h-10 rounded-full bg-gradient-to-br from-pioneer-navy to-pioneer-navy-light flex items-center justify-center text-white font-bold text-base flex-shrink-0">
                  {initial}
                </div>
                <div>
                  <p class="font-semibold text-pioneer-navy text-sm">{name}</p>
                  <p class="text-asphalt/60 text-xs">{detail}</p>
                </div>
              </div>
              <!-- Google G logo -->
              <svg class="w-5 h-5 flex-shrink-0 opacity-40" viewBox="0 0 24 24" fill="currentColor">
                <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
                <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
              </svg>
            </div>
          </div>
        ))}
      </div>

      <!-- Google Reviews CTA -->
      <div class="reveal-item bg-white rounded-2xl border border-asphalt-line p-8 flex flex-col sm:flex-row items-start sm:items-center justify-between gap-6">
        <div>
          <h3 class="font-display font-bold text-lg mb-1">Meer reviews lezen?</h3>
          <p class="text-asphalt text-sm">Bekijk alle beoordelingen op ons Google Bedrijfsprofiel — onze leerlingen vertellen het zelf.</p>
        </div>
        <a
          href="https://maps.app.goo.gl/spQwx86mzZrjgfwP6"
          target="_blank"
          rel="noopener noreferrer"
          class="flex-shrink-0 inline-flex items-center gap-2.5 px-5 py-3 rounded-lg border border-asphalt-line bg-white hover:border-pioneer-navy hover:shadow-sm text-pioneer-navy font-semibold text-sm transition-all duration-150"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92c-.26 1.37-1.04 2.53-2.21 3.31v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.09z" fill="#4285F4"/>
            <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
            <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
            <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
          </svg>
          Bekijk alle reviews
        </a>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="hero-bg text-white py-14 relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="orb-drift absolute -top-20 right-1/4 w-[450px] h-[450px] rounded-full" style="filter:blur(90px); background: radial-gradient(circle, rgba(214,40,57,0.45) 0%, transparent 65%);"></div>
      <div class="orb-drift-slow absolute bottom-0 left-1/4 w-[350px] h-[350px] rounded-full" style="filter:blur(90px); background: radial-gradient(circle, rgba(42,67,116,0.55) 0%, transparent 65%);"></div>
    </div>
    <div class="relative z-10 max-w-[1280px] mx-auto px-5 sm:px-8 text-center">
      <div class="reveal-item">
        <h2 class="font-display font-bold text-2xl md:text-3xl tracking-tight mb-3">
          Jij kunt de volgende zijn
        </h2>
        <p class="text-white/55 mb-7 max-w-md mx-auto">De meeste leerlingen slagen in één keer. Plan je gratis vrijblijvende proefles via WhatsApp — gratis bij inschrijving.</p>
        <a
          href="https://wa.me/31643127001?text=Hallo!%20Ik%20wil%20graag%20een%20gratis%20proefles%20plannen."
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2.5 px-7 py-3.5 rounded-xl bg-pioneer-red hover:bg-pioneer-red-dark text-white font-semibold transition-all duration-200 hover:shadow-lg hover:shadow-pioneer-red/25 hover:-translate-y-0.5"
        >
          <svg class="w-5 h-5" viewBox="0 0 24 24" fill="currentColor">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347z"/>
            <path d="M5.339 18.706A9.905 9.905 0 0 1 2 12C2 6.477 6.477 2 12 2s10 4.477 10 10-4.477 10-10 10a9.934 9.934 0 0 1-5.127-1.417L2 22l2.339-3.294z"/>
          </svg>
          Plan een gratis proefles
        </a>
      </div>
    </div>
  </section>
</Layout>
