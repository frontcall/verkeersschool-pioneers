  .cat-card.is-active .text-asphalt { color: rgba(255,255,255,0.55); }
  .cat-card.is-active svg { color: rgba(255,255,255,0.75); }

  /* ── Sub-category buttons ── */
  .sub-card {
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
    padding: 0.625rem 1.375rem;
    border-radius: 9999px;
    border: 2px solid #E8E9EC;
    background: white;
    font-size: 0.9375rem;
    font-weight: 600;
    color: #4B4F58;
    cursor: pointer;
    transition: border-color 0.18s ease, color 0.18s ease, background 0.18s ease, box-shadow 0.18s ease;
    white-space: nowrap;
  }
  .sub-card:hover {
    border-color: #16233F;
    color: #16233F;
    box-shadow: 0 2px 8px rgba(22,35,63,0.10);
  }
  .sub-card.is-active {
    background: #16233F;
    border-color: #16233F;
    color: white;
  }
  .sub-card strong { font-weight: 700; }

  /* ── Sub-groups (inside sub-picker) ── */
  .sub-group { display: none; }
  .sub-group.is-active { display: block; }

  /* ── Content sections ── */
  .cat-section,
  .sub-section { display: none; }

  .cat-section.is-active,
  .sub-section.is-active {
    display: block;
    animation: catFadeIn 0.32s cubic-bezier(0.16, 1, 0.3, 1) both;
  }

  @keyframes catFadeIn {
    from { opacity: 0; transform: translateY(10px); }
    to   { opacity: 1; transform: translateY(0); }
  }
  @media (prefers-reduced-motion: reduce) {
    .cat-section.is-active,
    .sub-section.is-active { animation: none; }
  }
</style>

<script>
  (function () {
    const catCards   = document.querySelectorAll<HTMLElement>('.cat-card');
    const subPicker  = document.getElementById('sub-picker') as HTMLElement;
    const subGroups  = document.querySelectorAll<HTMLElement>('.sub-group');
    const subCards   = document.querySelectorAll<HTMLElement>('.sub-card');
    const subSections = document.querySelectorAll<HTMLElement>('.sub-section');
    const catSections = document.querySelectorAll<HTMLElement>('.cat-section');
    const catContent  = document.getElementById('cat-content')!;

    const NO_SUB = ['am', 'taxi'];

    function scrollTo(el: HTMLElement) {
      const y = el.getBoundingClientRect().top + window.scrollY - 96;
      window.scrollTo({ top: y, behavior: 'smooth' });
    }

    function hideAllContent() {
      subSections.forEach(s => s.classList.remove('is-active'));
      catSections.forEach(s => s.classList.remove('is-active'));
    }

    function selectSub(subId: string, scroll: boolean) {
      subCards.forEach(c => c.classList.toggle('is-active', c.dataset.sub === subId));
      hideAllContent();
      document.querySelector<HTMLElement>(`.sub-section[data-sub="${subId}"]`)?.classList.add('is-active');
      if (scroll) scrollTo(catContent);
    }

    function selectCat(catId: string, scroll: boolean) {
      catCards.forEach(c => {
        const active = c.dataset.cat === catId;
        c.classList.toggle('is-active', active);
        c.setAttribute('aria-pressed', active ? 'true' : 'false');
      });

      subCards.forEach(c => c.classList.remove('is-active'));
      hideAllContent();

      if (NO_SUB.includes(catId)) {
        subPicker.hidden = true;
        document.querySelector<HTMLElement>(`.cat-section[data-section="${catId}"]`)?.classList.add('is-active');
        if (scroll) scrollTo(catContent);
      } else {
        subPicker.hidden = false;
        subGroups.forEach(g => {
          const active = g.dataset.group === catId;
          g.classList.toggle('is-active', active);
        });
        // Auto-select first sub-card of this category
        const firstSub = document.querySelector<HTMLElement>(`.sub-card[data-sub^="${catId}-"]`);
        if (firstSub) selectSub(firstSub.dataset.sub!, false);
        if (scroll) scrollTo(subPicker);
      }
    }

    catCards.forEach(card => {
      card.addEventListener('click', () => selectCat(card.dataset.cat!, true));
      card.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); selectCat(card.dataset.cat!, true); }
      });
    });

    subCards.forEach(card => {
      card.addEventListener('click', () => selectSub(card.dataset.sub!, true));
      card.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); selectSub(card.dataset.sub!, true); }
      });
    });

    // Default: B → Handgeschakeld
    selectCat('b', false);
  })();
</script>
