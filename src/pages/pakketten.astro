<script>
  (function () {
    const catCards   = document.querySelectorAll<HTMLElement>('.cat-card');
    const subPicker  = document.getElementById('sub-picker') as HTMLElement;
    const subGroups  = document.querySelectorAll<HTMLElement>('.sub-group');
    const subCards   = document.querySelectorAll<HTMLElement>('.sub-card');
    const subSections = document.querySelectorAll<HTMLElement>('.sub-section');
    const catSections = document.querySelectorAll<HTMLElement>('.cat-section');
    const catContent  = document.getElementById('cat-content')!;

    const NO_SUB = ['am', 'taxi'];

    function scrollTo(el: HTMLElement) {
      const y = el.getBoundingClientRect().top + window.scrollY - 96;
      window.scrollTo({ top: y, behavior: 'smooth' });
    }

    function hideAllContent() {
      subSections.forEach(s => s.classList.remove('is-active'));
      catSections.forEach(s => s.classList.remove('is-active'));
    }

    function selectSub(subId: string, scroll: boolean) {
      subCards.forEach(c => c.classList.toggle('is-active', c.dataset.sub === subId));
      hideAllContent();
      document.querySelector<HTMLElement>(`.sub-section[data-sub="${subId}"]`)?.classList.add('is-active');
      if (scroll) scrollTo(catContent);
    }

    function selectCat(catId: string, scroll: boolean) {
      catCards.forEach(c => {
        const active = c.dataset.cat === catId;
        c.classList.toggle('is-active', active);
        c.setAttribute('aria-pressed', active ? 'true' : 'false');
      });

      subCards.forEach(c => c.classList.remove('is-active'));
      hideAllContent();

      if (NO_SUB.includes(catId)) {
        subPicker.hidden = true;
        document.querySelector<HTMLElement>(`.cat-section[data-section="${catId}"]`)?.classList.add('is-active');
        if (scroll) scrollTo(catContent);
      } else {
        subPicker.hidden = false;
        subGroups.forEach(g => {
          const active = g.dataset.group === catId;
          g.classList.toggle('is-active', active);
        });
        // Auto-select first sub-card of this category
        const firstSub = document.querySelector<HTMLElement>(`.sub-card[data-sub^="${catId}-"]`);
        if (firstSub) selectSub(firstSub.dataset.sub!, false);
        if (scroll) scrollTo(subPicker);
      }
    }

    catCards.forEach(card => {
      card.addEventListener('click', () => selectCat(card.dataset.cat!, true));
      card.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); selectCat(card.dataset.cat!, true); }
      });
    });

    subCards.forEach(card => {
      card.addEventListener('click', () => selectSub(card.dataset.sub!, true));
      card.addEventListener('keydown', (e: KeyboardEvent) => {
        if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); selectSub(card.dataset.sub!, true); }
      });
    });

    // Default: B → Handgeschakeld
    selectCat('b', false);
  })();
</script>

<script>
  // ── Google Sheets prijskoppeling ──
  // Kolommen verwacht: pakket, prijs, prijs_van, actief
  const PRICING_URL = import.meta.env.PUBLIC_PRICING_SHEET_URL as string;
  const CACHE_KEY   = 'pioneers_pricing_v1';
  const CACHE_TTL   = 5 * 60 * 1000;

  function getCache(): string | null {
    try {
      const raw = sessionStorage.getItem(CACHE_KEY);
      if (!raw) return null;
      const { ts, data } = JSON.parse(raw) as { ts: number; data: string };
      if (Date.now() - ts > CACHE_TTL) { sessionStorage.removeItem(CACHE_KEY); return null; }
      return data;
    } catch { return null; }
  }

  function setCache(data: string) {
    try { sessionStorage.setItem(CACHE_KEY, JSON.stringify({ ts: Date.now(), data })); } catch {}
  }

  function parseCsvRow(line: string): string[] {
    const cols: string[] = [];
    let cur = '', inQ = false;
    for (const ch of line) {
      if (ch === '"') { inQ = !inQ; }
      else if (ch === ',' && !inQ) { cols.push(cur.trim()); cur = ''; }
      else { cur += ch; }
    }
    cols.push(cur.trim());
    return cols;
  }

  interface PakketInfo { prijs: string; prijsVan: string; actief: boolean }

  function parsePricing(csv: string): Record<string, PakketInfo> {
    const lines  = csv.trim().split('\n');
    const headers = parseCsvRow(lines[0]).map(h => h.toLowerCase().replace(/"/g, ''));
    const iNaam   = headers.indexOf('pakket');
    const iPrijs  = headers.indexOf('prijs');
    const iVan    = headers.indexOf('prijs_van');
    const iActief = headers.indexOf('actief');
    const result: Record<string, PakketInfo> = {};
    for (let i = 1; i < lines.length; i++) {
      const cols = parseCsvRow(lines[i]).map(s => s.replace(/"/g, ''));
      const naam = cols[iNaam]?.trim();
      if (!naam) continue;
      result[naam] = {
        prijs:   iActief >= 0 && cols[iPrijs]  ? cols[iPrijs]  : '',
        prijsVan: iVan   >= 0 && cols[iVan]   ? cols[iVan]   : '',
        actief:  iActief < 0 || (cols[iActief] || 'ja').toLowerCase() !== 'nee',
      };
    }
    return result;
  }

  function applyPricing(data: Record<string, PakketInfo>) {
    document.querySelectorAll<HTMLElement>('[data-pakket]').forEach(card => {
      const naam = card.dataset.pakket!;
      const info = data[naam];
      if (!info) return;

      if (!info.actief) { card.hidden = true; return; }

      const prijsEl    = card.querySelector<HTMLElement>('[data-prijs]');
      const prijsVanEl = card.querySelector<HTMLElement>('[data-prijs-van]');

      if (info.prijs && prijsEl) {
        prijsEl.textContent = `€ ${info.prijs}`;
      }
      if (prijsVanEl) {
        if (info.prijsVan) {
          prijsVanEl.textContent = `€ ${info.prijsVan}`;
          prijsVanEl.classList.remove('hidden');
        } else {
          prijsVanEl.classList.add('hidden');
        }
      }
    });

    // Update 'Vanaf' preview in cat-card
    document.querySelectorAll<HTMLElement>('[data-pakket-preview]').forEach(el => {
      const naam = el.dataset.pakketPreview!;
      const info = data[naam];
      if (info?.actief && info.prijs) {
        el.textContent = `Vanaf € ${info.prijs}`;
      }
    });
  }

  async function laadPrijzen() {
    if (!PRICING_URL) return;
    try {
      let csv = getCache();
      if (!csv) {
        const res = await fetch(PRICING_URL);
        if (!res.ok) throw new Error('fetch failed');
        csv = await res.text();
        setCache(csv);
      }
      applyPricing(parsePricing(csv));
    } catch {
      // Sheet niet bereikbaar — statische fallback-prijzen blijven staan
    }
  }

  laadPrijzen();
</script>
