---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Pakketten & Prijzen"
  description="Rijlessen voor auto, motor, scooter, vrachtwagen en taxi bij Verkeersschool Pioneers. Transparante prijzen, geen verborgen kosten."
>

  <!-- ══ HERO ══ -->
  <section class="hero-bg text-white py-14 md:py-18 relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="orb-drift absolute -top-32 right-0 w-[520px] h-[520px] rounded-full" style="filter:blur(90px); background: radial-gradient(circle, rgba(214,40,57,0.45) 0%, transparent 65%);"></div>
      <div class="orb-drift-slow absolute bottom-0 -left-20 w-[380px] h-[380px] rounded-full" style="filter:blur(90px); background: radial-gradient(circle, rgba(42,67,116,0.55) 0%, transparent 65%);"></div>
    </div>
    <div class="relative z-10 max-w-[1280px] mx-auto px-5 sm:px-8">
      <p class="hero-item text-pioneer-red font-semibold text-xs uppercase tracking-[0.18em] mb-4 flex items-center gap-2" data-delay="1">
        <span class="w-5 h-px bg-pioneer-red inline-block"></span>Pakketten & Prijzen
      </p>
      <h1 class="hero-item font-display font-bold text-4xl md:text-5xl tracking-tight mb-3" data-delay="2">
        Kies jouw rijbewijs
      </h1>
      <p class="hero-item text-white/60 text-lg max-w-lg" data-delay="3">
        Transparante prijzen, geen verborgen kosten. Selecteer hieronder waarvoor je rijles wilt.
      </p>
    </div>
  </section>

  <!-- ══ STAP 1: CATEGORIE KIEZER ══ -->
  <section id="cat-picker" class="py-10 md:py-14 bg-white border-b border-asphalt-line">
    <div class="max-w-[1280px] mx-auto px-5 sm:px-8">

      <div class="reveal-item text-center mb-8">
        <p class="text-pioneer-red font-semibold text-xs uppercase tracking-[0.18em] mb-2 flex items-center justify-center gap-2">
          <span class="w-5 h-px bg-pioneer-red inline-block"></span>Stap 1
        </p>
        <h2 class="font-display font-bold text-2xl md:text-3xl tracking-tight">Waarvoor wil jij rijles?</h2>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-5 gap-4">

        <!-- B -->
        <button type="button" class="cat-card group relative flex flex-col items-center text-center bg-off-white border-2 border-asphalt-line rounded-xl sm:rounded-2xl p-3.5 sm:p-5 md:p-6 cursor-pointer transition-all duration-200 hover:border-pioneer-navy hover:shadow-lg hover:-translate-y-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-pioneer-red" data-cat="b" aria-pressed="false">
          <div class="w-full max-w-[100px] sm:max-w-[140px] md:max-w-[160px] mx-auto mb-3 sm:mb-4 text-pioneer-navy/70 group-[.is-active]:text-white/80">
            <svg viewBox="0 0 180 100" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full">
              <ellipse cx="90" cy="90" rx="70" ry="5" fill="currentColor" fill-opacity="0.07"/>
              <path d="M8 70 L8 55 C8 51 11 48 16 46 L44 36 C52 27 63 22 80 22 L108 22 C122 22 132 27 140 36 L160 46 C165 48 170 51 170 55 L170 70 Z" fill="currentColor" fill-opacity="0.08" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/>
              <path d="M50 36 L58 23 L122 23 L143 36 L137 48 L56 48 Z" fill="currentColor" fill-opacity="0.18" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
              <line x1="96" y1="48" x2="96" y2="70" stroke="currentColor" stroke-width="1.5" stroke-opacity="0.3"/>
              <circle cx="42" cy="70" r="16" fill="currentColor" fill-opacity="0.07" stroke="currentColor" stroke-width="2.5"/>
              <circle cx="42" cy="70" r="7" fill="currentColor" fill-opacity="0.2"/>
              <circle cx="142" cy="70" r="16" fill="currentColor" fill-opacity="0.07" stroke="currentColor" stroke-width="2.5"/>
              <circle cx="142" cy="70" r="7" fill="currentColor" fill-opacity="0.2"/>
              <path d="M10 55 L17 49" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
              <rect x="165" y="50" width="6" height="10" rx="2" fill="currentColor" fill-opacity="0.6"/>
              <g transform="translate(150, 24)" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
                <line x1="4" y1="2" x2="4" y2="10"/>
                <line x1="10" y1="2" x2="10" y2="10"/>
                <line x1="4" y1="6" x2="10" y2="6"/>
              </g>
            </svg>
          </div>
          <div class="absolute top-3.5 right-3.5 opacity-0 group-[.is-active]:opacity-100 transition-opacity">
            <svg class="w-5 h-5 text-pioneer-red" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          </div>
          <p class="text-[10px] font-bold uppercase tracking-widest text-pioneer-red/80 group-[.is-active]:text-pioneer-red mb-1">B-rijbewijs</p>
          <p class="font-display font-bold text-base md:text-lg text-pioneer-navy group-[.is-active]:text-white leading-tight mb-1">Categorie B</p>
          <p class="text-asphalt text-xs group-[.is-active]:text-white/60">Schakel, Automaat &amp; Be</p>
          <p class="mt-2.5 text-pioneer-navy font-semibold text-sm group-[.is-active]:text-white/80">Vanaf &euro;&nbsp;1.049</p>
        </button>

        <!-- A -->
        <button type="button" class="cat-card group relative flex flex-col items-center text-center bg-off-white border-2 border-asphalt-line rounded-xl sm:rounded-2xl p-3.5 sm:p-5 md:p-6 cursor-pointer transition-all duration-200 hover:border-pioneer-navy hover:shadow-lg hover:-translate-y-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-pioneer-red" data-cat="a" aria-pressed="false">
          <div class="w-full max-w-[100px] sm:max-w-[140px] md:max-w-[160px] mx-auto mb-3 sm:mb-4 text-pioneer-navy/70 group-[.is-active]:text-white/80">
            <svg viewBox="0 0 180 100" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full">
              <ellipse cx="90" cy="92" rx="68" ry="4" fill="currentColor" fill-opacity="0.06"/>
              <circle cx="38" cy="72" r="20" fill="currentColor" fill-opacity="0.07" stroke="currentColor" stroke-width="2.5"/>
              <circle cx="38" cy="72" r="10" fill="currentColor" fill-opacity="0.18"/>
              <circle cx="150" cy="72" r="20" fill="currentColor" fill-opacity="0.07" stroke="currentColor" stroke-width="2.5"/>
              <circle cx="150" cy="72" r="10" fill="currentColor" fill-opacity="0.18"/>
              <path d="M58 72 L78 58 L108 54" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M78 58 L88 40 L118 38" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M88 40 L100 56" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
              <path d="M130 72 L128 48" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
              <path d="M150 72 L138 48" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-opacity="0.5"/>
              <rect x="88" y="54" width="32" height="20" rx="4" fill="currentColor" fill-opacity="0.14" stroke="currentColor" stroke-width="2"/>
              <path d="M88 40 C96 32 112 30 124 36 L124 44 C112 42 96 44 88 52 Z" fill="currentColor" fill-opacity="0.16" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
              <path d="M88 38 L108 35 L122 38" stroke="currentColor" stroke-width="3.5" stroke-linecap="round"/>
              <path d="M128 46 L126 36 M126 36 L120 34 M126 36 L132 33" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              <path d="M90 72 L70 74 L52 72" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-opacity="0.4"/>
              <circle cx="148" cy="52" r="5" fill="currentColor" fill-opacity="0.3" stroke="currentColor" stroke-width="1.5"/>
            </svg>
          </div>
          <div class="absolute top-3.5 right-3.5 opacity-0 group-[.is-active]:opacity-100 transition-opacity">
            <svg class="w-5 h-5 text-pioneer-red" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          </div>
          <p class="text-[10px] font-bold uppercase tracking-widest text-pioneer-red/80 group-[.is-active]:text-pioneer-red mb-1">A-rijbewijs</p>
          <p class="font-display font-bold text-base md:text-lg text-pioneer-navy group-[.is-active]:text-white leading-tight mb-1">Categorie A</p>
          <p class="text-asphalt text-xs group-[.is-active]:text-white/60">A1, A2 &amp; A</p>
          <p class="mt-2.5 text-pioneer-navy font-semibold text-sm group-[.is-active]:text-white/80">Prijs op aanvraag</p>
        </button>

        <!-- Am -->
        <button type="button" class="cat-card group relative flex flex-col items-center text-center bg-off-white border-2 border-asphalt-line rounded-xl sm:rounded-2xl p-3.5 sm:p-5 md:p-6 cursor-pointer transition-all duration-200 hover:border-pioneer-navy hover:shadow-lg hover:-translate-y-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-pioneer-red" data-cat="am" aria-pressed="false">
          <div class="w-full max-w-[100px] sm:max-w-[140px] md:max-w-[160px] mx-auto mb-3 sm:mb-4 text-pioneer-navy/70 group-[.is-active]:text-white/80">
            <svg viewBox="0 0 180 100" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full">
              <ellipse cx="90" cy="92" rx="65" ry="4" fill="currentColor" fill-opacity="0.06"/>
              <circle cx="36" cy="74" r="17" fill="currentColor" fill-opacity="0.07" stroke="currentColor" stroke-width="2.5"/>
              <circle cx="36" cy="74" r="8" fill="currentColor" fill-opacity="0.18"/>
              <circle cx="148" cy="74" r="17" fill="currentColor" fill-opacity="0.07" stroke="currentColor" stroke-width="2.5"/>
              <circle cx="148" cy="74" r="8" fill="currentColor" fill-opacity="0.18"/>
              <path d="M58 62 C58 62 62 44 80 40 L116 38 L136 50 L148 56 L148 64 L58 64 Z" fill="currentColor" fill-opacity="0.1" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/>
              <path d="M136 47 C146 44 160 50 162 60 L148 64 L134 60 Z" fill="currentColor" fill-opacity="0.14" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
              <rect x="58" y="64" width="70" height="9" rx="3" fill="currentColor" fill-opacity="0.09" stroke="currentColor" stroke-width="1.5"/>
              <path d="M58 62 L50 64 L40 72" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
              <path d="M80 40 L98 35 L118 35 L124 40" stroke="currentColor" stroke-width="3.5" stroke-linecap="round"/>
              <path d="M140 49 L138 36 M138 36 L132 34 M138 36 L145 33" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              <circle cx="158" cy="52" r="6" fill="currentColor" fill-opacity="0.25" stroke="currentColor" stroke-width="1.5"/>
            </svg>
          </div>
          <div class="absolute top-3.5 right-3.5 opacity-0 group-[.is-active]:opacity-100 transition-opacity">
            <svg class="w-5 h-5 text-pioneer-red" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          </div>
          <p class="text-[10px] font-bold uppercase tracking-widest text-pioneer-red/80 group-[.is-active]:text-pioneer-red mb-1">AM-rijbewijs</p>
          <p class="font-display font-bold text-base md:text-lg text-pioneer-navy group-[.is-active]:text-white leading-tight mb-1">Categorie Am</p>
          <p class="text-asphalt text-xs group-[.is-active]:text-white/60">Scooter</p>
          <p class="mt-2.5 text-pioneer-navy font-semibold text-sm group-[.is-active]:text-white/80">Prijs op aanvraag</p>
        </button>

        <!-- C -->
        <button type="button" class="cat-card group relative flex flex-col items-center text-center bg-off-white border-2 border-asphalt-line rounded-xl sm:rounded-2xl p-3.5 sm:p-5 md:p-6 cursor-pointer transition-all duration-200 hover:border-pioneer-navy hover:shadow-lg hover:-translate-y-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-pioneer-red" data-cat="c" aria-pressed="false">
          <div class="w-full max-w-[100px] sm:max-w-[140px] md:max-w-[160px] mx-auto mb-3 sm:mb-4 text-pioneer-navy/70 group-[.is-active]:text-white/80">
            <svg viewBox="0 0 200 100" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full">
              <ellipse cx="100" cy="94" rx="84" ry="4" fill="currentColor" fill-opacity="0.06"/>
              <rect x="76" y="30" width="110" height="50" rx="3" fill="currentColor" fill-opacity="0.06" stroke="currentColor" stroke-width="2.5"/>
              <line x1="142" y1="30" x2="142" y2="80" stroke="currentColor" stroke-width="1.5" stroke-opacity="0.3"/>
              <rect x="14" y="30" width="64" height="50" rx="5" fill="currentColor" fill-opacity="0.1" stroke="currentColor" stroke-width="2.5"/>
              <rect x="20" y="36" width="52" height="26" rx="3" fill="currentColor" fill-opacity="0.2" stroke="currentColor" stroke-width="1.5"/>
              <path d="M14 30 C14 22 24 18 36 18 L76 20 L78 30 Z" fill="currentColor" fill-opacity="0.12" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
              <line x1="48" y1="30" x2="48" y2="80" stroke="currentColor" stroke-width="1.5" stroke-opacity="0.35"/>
              <rect x="10" y="66" width="12" height="14" rx="2" fill="currentColor" fill-opacity="0.45"/>
              <circle cx="50" cy="82" r="16" fill="currentColor" fill-opacity="0.07" stroke="currentColor" stroke-width="2.5"/>
              <circle cx="50" cy="82" r="8" fill="currentColor" fill-opacity="0.2"/>
              <circle cx="152" cy="82" r="16" fill="currentColor" fill-opacity="0.07" stroke="currentColor" stroke-width="2.5"/>
              <circle cx="152" cy="82" r="8" fill="currentColor" fill-opacity="0.2"/>
              <circle cx="170" cy="82" r="13" fill="currentColor" fill-opacity="0.04" stroke="currentColor" stroke-width="1.8" stroke-opacity="0.45"/>
              <line x1="76" y1="82" x2="132" y2="82" stroke="currentColor" stroke-width="2" stroke-opacity="0.18"/>
            </svg>
          </div>
          <div class="absolute top-3.5 right-3.5 opacity-0 group-[.is-active]:opacity-100 transition-opacity">
            <svg class="w-5 h-5 text-pioneer-red" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          </div>
          <p class="text-[10px] font-bold uppercase tracking-widest text-pioneer-red/80 group-[.is-active]:text-pioneer-red mb-1">C / CE-rijbewijs</p>
          <p class="font-display font-bold text-base md:text-lg text-pioneer-navy group-[.is-active]:text-white leading-tight mb-1">Categorie C</p>
          <p class="text-asphalt text-xs group-[.is-active]:text-white/60">C &amp; Ce</p>
          <p class="mt-2.5 text-pioneer-navy font-semibold text-sm group-[.is-active]:text-white/80">Prijs op aanvraag</p>
        </button>

        <!-- TAXI -->
        <button type="button" class="cat-card group relative flex flex-col items-center text-center bg-off-white border-2 border-asphalt-line rounded-xl sm:rounded-2xl p-3.5 sm:p-5 md:p-6 cursor-pointer transition-all duration-200 hover:border-pioneer-navy hover:shadow-lg hover:-translate-y-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-pioneer-red" data-cat="taxi" aria-pressed="false">
          <div class="w-full max-w-[100px] sm:max-w-[140px] md:max-w-[160px] mx-auto mb-3 sm:mb-4 text-pioneer-navy/70 group-[.is-active]:text-white/80">
            <svg viewBox="0 0 180 100" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full">
              <ellipse cx="90" cy="90" rx="70" ry="5" fill="currentColor" fill-opacity="0.07"/>
              <path d="M8 70 L8 55 C8 51 11 48 16 46 L44 36 C52 27 63 22 80 22 L108 22 C122 22 132 27 140 36 L160 46 C165 48 170 51 170 55 L170 70 Z" fill="currentColor" fill-opacity="0.08" stroke="currentColor" stroke-width="2.5" stroke-linejoin="round"/>
              <path d="M50 36 L58 23 L122 23 L143 36 L137 48 L56 48 Z" fill="currentColor" fill-opacity="0.18" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
              <rect x="76" y="12" width="28" height="11" rx="3" fill="currentColor" fill-opacity="0.45" stroke="currentColor" stroke-width="1.5"/>
              <rect x="80" y="15" width="20" height="4" rx="1" fill="currentColor" fill-opacity="0.2"/>
              <rect x="60" y="56" width="9" height="8" rx="1" fill="currentColor" fill-opacity="0.55"/>
              <rect x="71" y="56" width="9" height="8" rx="1" fill="currentColor" fill-opacity="0.25"/>
              <rect x="82" y="56" width="9" height="8" rx="1" fill="currentColor" fill-opacity="0.55"/>
              <rect x="93" y="56" width="9" height="8" rx="1" fill="currentColor" fill-opacity="0.25"/>
              <rect x="104" y="56" width="9" height="8" rx="1" fill="currentColor" fill-opacity="0.55"/>
              <rect x="115" y="56" width="9" height="8" rx="1" fill="currentColor" fill-opacity="0.25"/>
              <rect x="126" y="56" width="9" height="8" rx="1" fill="currentColor" fill-opacity="0.55"/>
              <line x1="96" y1="48" x2="96" y2="70" stroke="currentColor" stroke-width="1.5" stroke-opacity="0.3"/>
              <circle cx="42" cy="70" r="16" fill="currentColor" fill-opacity="0.07" stroke="currentColor" stroke-width="2.5"/>
              <circle cx="42" cy="70" r="7" fill="currentColor" fill-opacity="0.2"/>
              <circle cx="142" cy="70" r="16" fill="currentColor" fill-opacity="0.07" stroke="currentColor" stroke-width="2.5"/>
              <circle cx="142" cy="70" r="7" fill="currentColor" fill-opacity="0.2"/>
              <path d="M10 55 L17 49" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
              <rect x="165" y="50" width="6" height="10" rx="2" fill="currentColor" fill-opacity="0.6"/>
            </svg>
          </div>
          <div class="absolute top-3.5 right-3.5 opacity-0 group-[.is-active]:opacity-100 transition-opacity">
            <svg class="w-5 h-5 text-pioneer-red" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          </div>
          <p class="text-[10px] font-bold uppercase tracking-widest text-pioneer-red/80 group-[.is-active]:text-pioneer-red mb-1">Chauffeurskaart</p>
          <p class="font-display font-bold text-base md:text-lg text-pioneer-navy group-[.is-active]:text-white leading-tight mb-1">Taxi</p>
          <p class="text-asphalt text-xs group-[.is-active]:text-white/60">Taxichauffeur worden</p>
          <p class="mt-2.5 text-pioneer-navy font-semibold text-sm group-[.is-active]:text-white/80">Prijs op aanvraag</p>
        </button>

      </div>
    </div>
  </section>

  <!-- ══ STAP 2: SUB-CATEGORIE KIEZER ══ -->
  <section id="sub-picker" hidden class="py-8 bg-off-white border-b border-asphalt-line scroll-mt-20">
    <div class="max-w-[1280px] mx-auto px-5 sm:px-8 text-center">
      <p class="text-pioneer-red font-semibold text-xs uppercase tracking-[0.18em] mb-4 flex items-center justify-center gap-2">
        <span class="w-5 h-px bg-pioneer-red inline-block"></span>Stap 2
      </p>

      <!-- B sub-group -->
      <div class="sub-group" data-group="b">
        <h2 class="font-display font-bold text-xl md:text-2xl tracking-tight mb-5">Handgeschakeld of Automaat?</h2>
        <div class="flex flex-wrap justify-center gap-3">
          <button type="button" class="sub-card" data-sub="b-handgeschakeld">Handgeschakeld</button>
          <button type="button" class="sub-card" data-sub="b-automaat">Automaat</button>
        </div>
      </div>

      <!-- A sub-group -->
      <div class="sub-group" data-group="a">
        <h2 class="font-display font-bold text-xl md:text-2xl tracking-tight mb-5">Welke motorcategorie?</h2>
        <div class="flex flex-wrap justify-center gap-3">
          <button type="button" class="sub-card" data-sub="a-a1"><strong>A1</strong>&nbsp;· Lichte motor (tot 125cc)</button>
          <button type="button" class="sub-card" data-sub="a-a2"><strong>A2</strong>&nbsp;· Middencategorie (tot 35&nbsp;kW)</button>
          <button type="button" class="sub-card" data-sub="a-a"><strong>A</strong>&nbsp;· Onbeperkt</button>
        </div>
      </div>

      <!-- C sub-group -->
      <div class="sub-group" data-group="c">
        <h2 class="font-display font-bold text-xl md:text-2xl tracking-tight mb-5">C of CE?</h2>
        <div class="flex flex-wrap justify-center gap-3">
          <button type="button" class="sub-card" data-sub="c-c"><strong>C</strong>&nbsp;· Vrachtwagen (zonder aanhanger)</button>
          <button type="button" class="sub-card" data-sub="c-ce"><strong>CE</strong>&nbsp;· Vrachtwagen met aanhanger</button>
        </div>
      </div>
    </div>
  </section>

  <!-- ══ CONTENT ══ -->
  <div id="cat-content" class="scroll-mt-20">

    <!-- ── B — Handgeschakeld ── -->
    <div class="sub-section" data-sub="b-handgeschakeld">
      <section class="py-16 md:py-20 bg-off-white">
        <div class="max-w-[1280px] mx-auto px-5 sm:px-8">
          <div class="flex items-start gap-4 mb-3">
            <div class="w-12 h-12 rounded-xl bg-pioneer-red/8 flex items-center justify-center flex-shrink-0">
              <svg class="w-6 h-6 text-pioneer-red" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 6V4m0 2a2 2 0 100 4m0-4a2 2 0 110 4m-6 8a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4m6 6v10m6-2a2 2 0 100-4m0 4a2 2 0 110-4m0 4v2m0-6V4"/>
              </svg>
            </div>
            <div>
              <h2 class="font-display font-bold text-2xl md:text-3xl tracking-tight">Handgeschakeld</h2>
              <p class="text-asphalt text-sm mt-0.5">Categorie B — versnellingsbak</p>
            </div>
