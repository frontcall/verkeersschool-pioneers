              <rect x="116" y="68" width="12" height="4" rx="2" fill="#CDE0F5" stroke="#576DB8" stroke-width="1"/>
              <rect x="176" y="56" width="5" height="16" rx="2.5" fill="#BAD0F0" stroke="#576DB8" stroke-width="1.5"/>
              <rect x="17" y="56" width="4" height="16" rx="2" fill="#BAD0F0" stroke="#576DB8" stroke-width="1.2"/>
              <circle cx="52" cy="82" r="18" fill="#E8EFF9" stroke="#576DB8" stroke-width="2"/>
              <circle cx="52" cy="82" r="10" fill="#E8EFF9" stroke="#576DB8" stroke-width="1.2"/>
              <circle cx="52" cy="82" r="4" fill="#576DB8"/>
              <line x1="52" y1="72" x2="52" y2="78" stroke="#576DB8" stroke-width="1.2" stroke-opacity="0.38"/>
              <line x1="52" y1="86" x2="52" y2="92" stroke="#576DB8" stroke-width="1.2" stroke-opacity="0.38"/>
              <line x1="42" y1="82" x2="48" y2="82" stroke="#576DB8" stroke-width="1.2" stroke-opacity="0.38"/>
              <line x1="56" y1="82" x2="62" y2="82" stroke="#576DB8" stroke-width="1.2" stroke-opacity="0.38"/>
              <circle cx="154" cy="82" r="18" fill="#E8EFF9" stroke="#576DB8" stroke-width="2"/>
              <circle cx="154" cy="82" r="10" fill="#E8EFF9" stroke="#576DB8" stroke-width="1.2"/>
              <circle cx="154" cy="82" r="4" fill="#576DB8"/>
              <line x1="154" y1="72" x2="154" y2="78" stroke="#576DB8" stroke-width="1.2" stroke-opacity="0.38"/>
