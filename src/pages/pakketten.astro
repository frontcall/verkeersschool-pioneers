            <svg viewBox="0 0 200 110" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full">
              <ellipse cx="96" cy="104" rx="74" ry="4" fill="#A8C2E0" fill-opacity="0.35"/>
              <!-- Rear wheel -->
              <circle cx="152" cy="82" r="22" fill="#E8EFF9" stroke="#576DB8" stroke-width="4"/>
              <circle cx="152" cy="82" r="5" fill="#576DB8"/>
