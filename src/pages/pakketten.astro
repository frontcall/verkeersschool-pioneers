---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Pakketten & Prijzen"
  description="Rijlessen voor auto, motor, scooter, vrachtwagen en taxi bij Verkeersschool Pioneers. Transparante prijzen, geen verborgen kosten."
>

  <!-- ══ HERO ══ -->
  <section class="hero-bg text-white py-14 md:py-18 relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="orb-drift absolute -top-32 right-0 w-[520px] h-[520px] rounded-full" style="filter:blur(90px); background: radial-gradient(circle, rgba(214,40,57,0.45) 0%, transparent 65%);"></div>
      <div class="orb-drift-slow absolute bottom-0 -left-20 w-[380px] h-[380px] rounded-full" style="filter:blur(90px); background: radial-gradient(circle, rgba(42,67,116,0.55) 0%, transparent 65%);"></div>
    </div>
    <div class="relative z-10 max-w-[1280px] mx-auto px-5 sm:px-8">
      <p class="hero-item text-pioneer-red font-semibold text-xs uppercase tracking-[0.18em] mb-4 flex items-center gap-2" data-delay="1">
        <span class="w-5 h-px bg-pioneer-red inline-block"></span>Pakketten & Prijzen
      </p>
      <h1 class="hero-item font-display font-bold text-4xl md:text-5xl tracking-tight mb-3" data-delay="2">
        Kies jouw rijbewijs
      </h1>
      <p class="hero-item text-white/60 text-lg max-w-lg" data-delay="3">
        Transparante prijzen, geen verborgen kosten. Selecteer hieronder waarvoor je rijles wilt.
      </p>
    </div>
  </section>

  <!-- ══ STAP 1: CATEGORIE KIEZER ══ -->
  <section id="cat-picker" class="py-10 md:py-14 bg-white border-b border-asphalt-line">
    <div class="max-w-[1280px] mx-auto px-5 sm:px-8">

      <div class="reveal-item text-center mb-8">
        <p class="text-pioneer-red font-semibold text-xs uppercase tracking-[0.18em] mb-2 flex items-center justify-center gap-2">
          <span class="w-5 h-px bg-pioneer-red inline-block"></span>Stap 1
        </p>
        <h2 class="font-display font-bold text-2xl md:text-3xl tracking-tight">Waarvoor wil jij rijles?</h2>
      </div>

      <div class="grid grid-cols-2 sm:grid-cols-5 gap-4">

        <!-- B -->
        <button type="button" class="cat-card group relative flex flex-col items-center text-center bg-off-white border-2 border-asphalt-line rounded-xl sm:rounded-2xl p-3.5 sm:p-5 md:p-6 cursor-pointer transition-all duration-200 hover:border-pioneer-navy hover:shadow-lg hover:-translate-y-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-pioneer-red" data-cat="b" aria-pressed="false">
          <div class="w-full max-w-[100px] sm:max-w-[140px] md:max-w-[160px] mx-auto mb-3 sm:mb-4 text-pioneer-navy/70 group-[.is-active]:text-white/80">
            <svg viewBox="0 0 200 110" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full">
              <ellipse cx="100" cy="104" rx="76" ry="4.5" fill="currentColor" fill-opacity="0.06"/>
              <path d="M27 82 C24 82 22 78 22 72 L22 62 C22 54 26 48 34 45 L60 37 C65 24 76 19 92 19 L118 19 C134 19 144 24 152 36 L168 48 C172 54 176 60 176 68 L176 82 Z" fill="currentColor" fill-opacity="0.09" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
              <path d="M62 37 L70 20 L128 20 L148 36 L140 50 L68 50 Z" fill="currentColor" fill-opacity="0.22" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
              <line x1="104" y1="50" x2="104" y2="82" stroke="currentColor" stroke-width="1.5" stroke-opacity="0.22"/>
              <rect x="173" y="52" width="4" height="10" rx="2" fill="currentColor" fill-opacity="0.55"/>
              <rect x="21" y="52" width="3" height="10" rx="1.5" fill="currentColor" fill-opacity="0.45"/>
              <circle cx="52" cy="82" r="18" fill="currentColor" fill-opacity="0.07" stroke="currentColor" stroke-width="2"/>
              <circle cx="52" cy="82" r="7" fill="currentColor" fill-opacity="0.22"/>
              <circle cx="154" cy="82" r="18" fill="currentColor" fill-opacity="0.07" stroke="currentColor" stroke-width="2"/>
              <circle cx="154" cy="82" r="7" fill="currentColor" fill-opacity="0.22"/>
            </svg>
          </div>
          <div class="absolute top-3.5 right-3.5 opacity-0 group-[.is-active]:opacity-100 transition-opacity">
            <svg class="w-5 h-5 text-pioneer-red" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          </div>
          <p class="text-[10px] font-bold uppercase tracking-widest text-pioneer-red/80 group-[.is-active]:text-pioneer-red mb-1">B-rijbewijs</p>
          <p class="font-display font-bold text-base md:text-lg text-pioneer-navy group-[.is-active]:text-white leading-tight mb-1">Categorie B</p>
          <p class="text-asphalt text-xs group-[.is-active]:text-white/60">Schakel, Automaat &amp; Be</p>
          <p class="mt-2.5 text-pioneer-navy font-semibold text-sm group-[.is-active]:text-white/80">Vanaf &euro;&nbsp;1.049</p>
        </button>

        <!-- A -->
        <button type="button" class="cat-card group relative flex flex-col items-center text-center bg-off-white border-2 border-asphalt-line rounded-xl sm:rounded-2xl p-3.5 sm:p-5 md:p-6 cursor-pointer transition-all duration-200 hover:border-pioneer-navy hover:shadow-lg hover:-translate-y-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-pioneer-red" data-cat="a" aria-pressed="false">
          <div class="w-full max-w-[100px] sm:max-w-[140px] md:max-w-[160px] mx-auto mb-3 sm:mb-4 text-pioneer-navy/70 group-[.is-active]:text-white/80">
            <svg viewBox="0 0 200 118" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full">
              <ellipse cx="103" cy="112" rx="76" ry="4" fill="currentColor" fill-opacity="0.06"/>
              <!-- SWINGARM (behind wheels) -->
              <path d="M138 62 L152 84" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
              <!-- REAR WHEEL — sport alloy with rim ring, brake disc ring, hub, 6 spokes -->
              <circle cx="152" cy="88" r="24" fill="currentColor" fill-opacity="0.06" stroke="currentColor" stroke-width="2"/>
              <circle cx="152" cy="88" r="16" fill="none" stroke="currentColor" stroke-width="0.75" stroke-opacity="0.22"/>
              <circle cx="152" cy="88" r="10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-opacity="0.32"/>
              <circle cx="152" cy="88" r="5" fill="currentColor" fill-opacity="0.32"/>
              <line x1="152" y1="64" x2="152" y2="78" stroke="currentColor" stroke-width="2" stroke-opacity="0.24"/>
              <line x1="152" y1="98" x2="152" y2="112" stroke="currentColor" stroke-width="2" stroke-opacity="0.24"/>
              <line x1="128" y1="88" x2="142" y2="88" stroke="currentColor" stroke-width="2" stroke-opacity="0.24"/>
              <line x1="162" y1="88" x2="176" y2="88" stroke="currentColor" stroke-width="2" stroke-opacity="0.24"/>
              <line x1="135" y1="71" x2="145" y2="81" stroke="currentColor" stroke-width="1.5" stroke-opacity="0.18"/>
              <line x1="159" y1="95" x2="169" y2="105" stroke="currentColor" stroke-width="1.5" stroke-opacity="0.18"/>
              <!-- FRONT WHEEL — identical sport alloy style -->
              <circle cx="54" cy="88" r="24" fill="currentColor" fill-opacity="0.06" stroke="currentColor" stroke-width="2"/>
              <circle cx="54" cy="88" r="16" fill="none" stroke="currentColor" stroke-width="0.75" stroke-opacity="0.22"/>
              <circle cx="54" cy="88" r="10" fill="none" stroke="currentColor" stroke-width="1.5" stroke-opacity="0.32"/>
              <circle cx="54" cy="88" r="5" fill="currentColor" fill-opacity="0.32"/>
              <line x1="54" y1="64" x2="54" y2="78" stroke="currentColor" stroke-width="2" stroke-opacity="0.24"/>
              <line x1="54" y1="98" x2="54" y2="112" stroke="currentColor" stroke-width="2" stroke-opacity="0.24"/>
              <line x1="30" y1="88" x2="44" y2="88" stroke="currentColor" stroke-width="2" stroke-opacity="0.24"/>
              <line x1="64" y1="88" x2="78" y2="88" stroke="currentColor" stroke-width="2" stroke-opacity="0.24"/>
              <line x1="37" y1="71" x2="47" y2="81" stroke="currentColor" stroke-width="1.5" stroke-opacity="0.18"/>
              <line x1="61" y1="95" x2="71" y2="105" stroke="currentColor" stroke-width="1.5" stroke-opacity="0.18"/>
              <!-- EXHAUST HEADER PIPE (exits engine underside, curves rearward) -->
              <path d="M106 76 C120 86 134 86 150 80" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-opacity="0.36"/>
              <!-- ENGINE BLOCK — large exposed mass, three cooling-fin lines -->
              <path d="M88 52 L136 52 L140 76 L90 78 Z" fill="currentColor" fill-opacity="0.12" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
              <line x1="89" y1="58" x2="138" y2="57" stroke="currentColor" stroke-width="0.75" stroke-opacity="0.26"/>
              <line x1="89" y1="65" x2="138" y2="64" stroke="currentColor" stroke-width="0.75" stroke-opacity="0.26"/>
              <line x1="90" y1="72" x2="138" y2="71" stroke="currentColor" stroke-width="0.75" stroke-opacity="0.26"/>
              <!-- USD FRONT FORKS — thick stanchion tube + offset inner tube -->
              <path d="M76 46 L58 88" stroke="currentColor" stroke-width="4" stroke-linecap="round"/>
              <path d="M82 44 L64 86" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-opacity="0.34"/>
              <!-- UNIFIED BODY — tank + seat + tail as one clean silhouette -->
              <path d="M82 46 L86 22 C100 12 126 12 140 20 L152 28 C162 34 174 44 178 52 L178 60 C168 64 154 66 142 62 L136 52 L88 52 Z"
                    fill="currentColor" fill-opacity="0.18" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
              <!-- HEADLIGHT UNIT — angular pentagon (sport naked style) -->
              <path d="M66 52 L68 38 L80 36 L82 52 L76 58 Z"
                    fill="currentColor" fill-opacity="0.15" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
              <!-- HANDLEBARS — flat bar + stem -->
              <path d="M82 42 L92 34" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              <path d="M90 34 L110 34" stroke="currentColor" stroke-width="2.5" stroke-linecap="round"/>
              <!-- Rectangular mirror (sport style) -->
              <rect x="108" y="27" width="7" height="9" rx="1" fill="currentColor" fill-opacity="0.24" stroke="currentColor" stroke-width="1.2" transform="rotate(8 108 27)"/>
              <!-- TAILLIGHT -->
              <rect x="174" y="50" width="5" height="5" rx="1" fill="currentColor" fill-opacity="0.55"/>
            </svg>
          </div>
          <div class="absolute top-3.5 right-3.5 opacity-0 group-[.is-active]:opacity-100 transition-opacity">
            <svg class="w-5 h-5 text-pioneer-red" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          </div>
          <p class="text-[10px] font-bold uppercase tracking-widest text-pioneer-red/80 group-[.is-active]:text-pioneer-red mb-1">A-rijbewijs</p>
          <p class="font-display font-bold text-base md:text-lg text-pioneer-navy group-[.is-active]:text-white leading-tight mb-1">Categorie A</p>
          <p class="text-asphalt text-xs group-[.is-active]:text-white/60">A1, A2 &amp; A</p>
          <p class="mt-2.5 text-pioneer-red font-semibold text-sm group-[.is-active]:text-white/80">Neem contact op →</p>
        </button>

        <!-- Am -->
        <button type="button" class="cat-card group relative flex flex-col items-center text-center bg-off-white border-2 border-asphalt-line rounded-xl sm:rounded-2xl p-3.5 sm:p-5 md:p-6 cursor-pointer transition-all duration-200 hover:border-pioneer-navy hover:shadow-lg hover:-translate-y-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-pioneer-red" data-cat="am" aria-pressed="false">
          <div class="w-full max-w-[100px] sm:max-w-[140px] md:max-w-[160px] mx-auto mb-3 sm:mb-4 text-pioneer-navy/70 group-[.is-active]:text-white/80">
            <svg viewBox="0 0 200 118" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full">
              <ellipse cx="100" cy="110" rx="74" ry="4" fill="currentColor" fill-opacity="0.06"/>
              <!-- REAR WHEEL (small 12" alloy — distinctly smaller than motorcycle) -->
              <circle cx="150" cy="90" r="14" fill="currentColor" fill-opacity="0.07" stroke="currentColor" stroke-width="2"/>
              <circle cx="150" cy="90" r="6" fill="currentColor" fill-opacity="0.22"/>
              <line x1="150" y1="76" x2="150" y2="84" stroke="currentColor" stroke-width="1" stroke-opacity="0.30"/>
              <line x1="150" y1="96" x2="150" y2="104" stroke="currentColor" stroke-width="1" stroke-opacity="0.30"/>
              <line x1="136" y1="90" x2="144" y2="90" stroke="currentColor" stroke-width="1" stroke-opacity="0.30"/>
              <line x1="156" y1="90" x2="164" y2="90" stroke="currentColor" stroke-width="1" stroke-opacity="0.30"/>
              <!-- FRONT WHEEL (same small size) -->
              <circle cx="46" cy="90" r="14" fill="currentColor" fill-opacity="0.07" stroke="currentColor" stroke-width="2"/>
              <circle cx="46" cy="90" r="6" fill="currentColor" fill-opacity="0.22"/>
              <line x1="46" y1="76" x2="46" y2="84" stroke="currentColor" stroke-width="1" stroke-opacity="0.30"/>
              <line x1="46" y1="96" x2="46" y2="104" stroke="currentColor" stroke-width="1" stroke-opacity="0.30"/>
              <line x1="32" y1="90" x2="40" y2="90" stroke="currentColor" stroke-width="1" stroke-opacity="0.30"/>
              <line x1="52" y1="90" x2="60" y2="90" stroke="currentColor" stroke-width="1" stroke-opacity="0.30"/>
              <!-- FLOOR PLATFORM (low step-through, visible between the two body panels) -->
              <rect x="70" y="76" width="38" height="12" rx="2" fill="currentColor" fill-opacity="0.09" stroke="currentColor" stroke-width="1.5"/>
              <!-- LEGSHIELD — organic convex front apron, widest at mid-height -->
              <path d="M58 30 C50 26 34 38 30 54 C24 70 36 82 50 84 L70 84 L70 34 C68 30 62 26 58 30 Z"
                    fill="currentColor" fill-opacity="0.12" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
              <!-- Legshield pressed-steel ridge lines (iconic Vespa detail) -->
              <path d="M32 50 C40 50 54 50 68 52" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-opacity="0.34"/>
              <path d="M28 62 C36 62 52 62 68 64" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-opacity="0.34"/>
              <path d="M32 74 C40 74 54 74 68 76" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-opacity="0.34"/>
              <!-- REAR COWL — the large rounded signature Vespa mass, enclosing the engine -->
              <path d="M108 64 C106 48 114 28 128 20 C142 12 162 14 172 26 C180 36 182 54 180 70 C178 80 170 88 158 90 L142 90 L108 90 C106 80 106 72 108 64 Z"
                    fill="currentColor" fill-opacity="0.12" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
              <!-- SEAT — long saddle set into the top of the rear cowl -->
              <path d="M116 26 C120 18 156 16 168 26 C172 34 170 50 164 54 C152 60 122 60 116 54 C112 48 112 36 116 26 Z"
                    fill="currentColor" fill-opacity="0.22" stroke="currentColor" stroke-width="1.8" stroke-linejoin="round"/>
              <!-- Cowl accent panel crease -->
              <path d="M142 28 C162 34 178 58 174 78 C172 86 162 92 152 94" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" fill="none" stroke-opacity="0.26"/>
              <!-- FRONT FORK — only visible portion below legshield -->
              <path d="M50 82 L46 90" stroke="currentColor" stroke-width="3" stroke-linecap="round"/>
              <!-- HANDLEBAR STEM -->
              <path d="M62 28 L62 14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/>
              <!-- HANDLEBARS — Vespa ram's-horn style sweeping outward -->
              <path d="M62 14 C60 8 50 8 46 14" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M62 14 C64 8 74 8 78 14" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"/>
              <!-- Round mirrors at bar ends -->
              <circle cx="46" cy="14" r="4.5" fill="currentColor" fill-opacity="0.28" stroke="currentColor" stroke-width="1.5"/>
              <circle cx="78" cy="14" r="4.5" fill="currentColor" fill-opacity="0.28" stroke="currentColor" stroke-width="1.5"/>
              <!-- ROUND HEADLIGHT (on front of fork, top of legshield) -->
              <circle cx="36" cy="44" r="9" fill="currentColor" fill-opacity="0.14" stroke="currentColor" stroke-width="2"/>
              <circle cx="36" cy="44" r="5" fill="currentColor" fill-opacity="0.28"/>
              <!-- TAILLIGHT -->
              <rect x="175" y="32" width="5" height="8" rx="2" fill="currentColor" fill-opacity="0.45"/>
            </svg>
          </div>
          <div class="absolute top-3.5 right-3.5 opacity-0 group-[.is-active]:opacity-100 transition-opacity">
            <svg class="w-5 h-5 text-pioneer-red" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          </div>
          <p class="text-[10px] font-bold uppercase tracking-widest text-pioneer-red/80 group-[.is-active]:text-pioneer-red mb-1">AM-rijbewijs</p>
          <p class="font-display font-bold text-base md:text-lg text-pioneer-navy group-[.is-active]:text-white leading-tight mb-1">Categorie Am</p>
          <p class="text-asphalt text-xs group-[.is-active]:text-white/60">Scooter</p>
          <p class="mt-2.5 text-pioneer-red font-semibold text-sm group-[.is-active]:text-white/80">Neem contact op →</p>
        </button>

        <!-- C -->
        <button type="button" class="cat-card group relative flex flex-col items-center text-center bg-off-white border-2 border-asphalt-line rounded-xl sm:rounded-2xl p-3.5 sm:p-5 md:p-6 cursor-pointer transition-all duration-200 hover:border-pioneer-navy hover:shadow-lg hover:-translate-y-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-pioneer-red" data-cat="c" aria-pressed="false">
          <div class="w-full max-w-[100px] sm:max-w-[140px] md:max-w-[160px] mx-auto mb-3 sm:mb-4 text-pioneer-navy/70 group-[.is-active]:text-white/80">
            <svg viewBox="0 0 200 110" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full">
              <ellipse cx="100" cy="104" rx="88" ry="4.5" fill="currentColor" fill-opacity="0.06"/>
              <rect x="72" y="26" width="118" height="58" rx="3" fill="currentColor" fill-opacity="0.07" stroke="currentColor" stroke-width="2"/>
              <line x1="114" y1="26" x2="114" y2="84" stroke="currentColor" stroke-width="1" stroke-opacity="0.25"/>
              <line x1="152" y1="26" x2="152" y2="84" stroke="currentColor" stroke-width="1" stroke-opacity="0.25"/>
              <rect x="10" y="22" width="64" height="62" rx="5" fill="currentColor" fill-opacity="0.11" stroke="currentColor" stroke-width="2"/>
              <rect x="17" y="29" width="50" height="30" rx="3" fill="currentColor" fill-opacity="0.22" stroke="currentColor" stroke-width="1.5"/>
              <path d="M10 22 C10 16 20 12 32 12 L74 14 L74 22 Z" fill="currentColor" fill-opacity="0.14" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
              <rect x="7" y="70" width="12" height="14" rx="2" fill="currentColor" fill-opacity="0.38"/>
              <rect x="9" y="36" width="4" height="10" rx="2" fill="currentColor" fill-opacity="0.55"/>
              <circle cx="34" cy="86" r="14" fill="currentColor" fill-opacity="0.07" stroke="currentColor" stroke-width="2"/>
              <circle cx="34" cy="86" r="6" fill="currentColor" fill-opacity="0.20"/>
              <circle cx="68" cy="86" r="14" fill="currentColor" fill-opacity="0.07" stroke="currentColor" stroke-width="2"/>
              <circle cx="68" cy="86" r="6" fill="currentColor" fill-opacity="0.20"/>
              <circle cx="158" cy="86" r="14" fill="currentColor" fill-opacity="0.07" stroke="currentColor" stroke-width="2"/>
              <circle cx="158" cy="86" r="6" fill="currentColor" fill-opacity="0.20"/>
              <circle cx="178" cy="86" r="12" fill="currentColor" fill-opacity="0.04" stroke="currentColor" stroke-width="1.5" stroke-opacity="0.55"/>
            </svg>
          </div>
          <div class="absolute top-3.5 right-3.5 opacity-0 group-[.is-active]:opacity-100 transition-opacity">
            <svg class="w-5 h-5 text-pioneer-red" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5"><path stroke-linecap="round" stroke-linejoin="round" d="M5 13l4 4L19 7"/></svg>
          </div>
          <p class="text-[10px] font-bold uppercase tracking-widest text-pioneer-red/80 group-[.is-active]:text-pioneer-red mb-1">C / CE-rijbewijs</p>
          <p class="font-display font-bold text-base md:text-lg text-pioneer-navy group-[.is-active]:text-white leading-tight mb-1">Categorie C</p>
          <p class="text-asphalt text-xs group-[.is-active]:text-white/60">C &amp; Ce</p>
          <p class="mt-2.5 text-pioneer-red font-semibold text-sm group-[.is-active]:text-white/80">Neem contact op →</p>
        </button>

        <!-- TAXI -->
        <button type="button" class="cat-card group relative flex flex-col items-center text-center bg-off-white border-2 border-asphalt-line rounded-xl sm:rounded-2xl p-3.5 sm:p-5 md:p-6 cursor-pointer transition-all duration-200 hover:border-pioneer-navy hover:shadow-lg hover:-translate-y-1 focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-pioneer-red" data-cat="taxi" aria-pressed="false">
          <div class="w-full max-w-[100px] sm:max-w-[140px] md:max-w-[160px] mx-auto mb-3 sm:mb-4 text-pioneer-navy/70 group-[.is-active]:text-white/80">
            <svg viewBox="0 0 200 110" fill="none" xmlns="http://www.w3.org/2000/svg" class="w-full">
              <ellipse cx="100" cy="104" rx="76" ry="4.5" fill="currentColor" fill-opacity="0.06"/>
              <path d="M27 82 C24 82 22 78 22 72 L22 62 C22 54 26 48 34 45 L60 37 C65 24 76 19 92 19 L118 19 C134 19 144 24 152 36 L168 48 C172 54 176 60 176 68 L176 82 Z" fill="currentColor" fill-opacity="0.09" stroke="currentColor" stroke-width="2" stroke-linejoin="round"/>
              <path d="M62 37 L70 20 L128 20 L148 36 L140 50 L68 50 Z" fill="currentColor" fill-opacity="0.22" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/>
              <line x1="104" y1="50" x2="104" y2="82" stroke="currentColor" stroke-width="1.5" stroke-opacity="0.22"/>
