---
import Layout from '../layouts/Layout.astro';
import SectionDivider from '../components/SectionDivider.astro';

// Fase 3: Google Sheet koppeling wordt hier gebouwd.
// Dit is de statische shell voor Fase 1.
const categories = [
  { id: 'auto', label: 'Auto', icon: '🚗', sub: 'B-rijbewijs' },
  { id: 'motor', label: 'Motor', icon: '🏍️', sub: 'A-rijbewijs' },
  { id: 'scooter', label: 'Scooter', icon: '🛵', sub: 'AM-rijbewijs' },
  { id: 'vrachtwagen', label: 'Vrachtwagen', icon: '🚛', sub: 'C-rijbewijs' },
  { id: 'taxi', label: 'Taxi', icon: '🚕', sub: 'Taxipas' },
];
---

<Layout
  title="Pakketten & Prijzen"
  description="Bekijk alle rijlespakketten van Verkeersschool Pioneers — auto, motor, scooter, vrachtwagen en taxi. Transparante prijzen, geen verborgen kosten."
>
  <!-- Page header -->
  <section class="bg-pioneer-navy text-white py-16 md:py-20">
    <div class="max-w-[1280px] mx-auto px-5 sm:px-8">
      <p class="text-pioneer-red font-semibold text-sm uppercase tracking-widest mb-3">Pakketten & Prijzen</p>
      <h1 class="font-display font-bold text-4xl md:text-5xl tracking-tight mb-4">
        Kies jouw pakket
      </h1>
      <p class="text-white/65 text-lg max-w-lg">
        Transparante prijzen, geen verborgen kosten. Klik op een categorie om de pakketten te bekijken.
      </p>
    </div>
  </section>

  <!-- Category tabs -->
  <div class="sticky top-16 md:top-20 z-30 bg-white border-b border-asphalt-line shadow-sm">
    <div class="max-w-[1280px] mx-auto px-5 sm:px-8">
      <nav class="flex gap-1 overflow-x-auto py-3 scrollbar-hide" aria-label="Categorieën">
        {categories.map(({ id, label, icon }) => (
          <a
            href={`#${id}`}
            class="flex items-center gap-1.5 px-4 py-2 rounded-lg text-sm font-medium text-asphalt hover:text-pioneer-navy hover:bg-off-white whitespace-nowrap transition-colors flex-shrink-0"
          >
            <span>{icon}</span> {label}
          </a>
        ))}
      </nav>
    </div>
  </div>

  <!-- Pricing sections — gevuld via Google Sheet in Fase 3 -->
  <div id="pricing-container">
    {categories.map(({ id, label, icon, sub }) => (
      <section id={id} class="py-14 md:py-20 scroll-mt-32">
        <div class="max-w-[1280px] mx-auto px-5 sm:px-8">
          <div class="flex items-center gap-3 mb-8">
            <span class="text-3xl">{icon}</span>
            <div>
              <h2 class="font-display font-bold text-2xl md:text-3xl tracking-tight">{label}</h2>
              <p class="text-asphalt text-sm">{sub}</p>
            </div>
          </div>

          <!-- Loading state — wordt vervangen door echte data in Fase 3 -->
          <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
            <div class="bg-white rounded-2xl border border-asphalt-line p-6 animate-pulse">
              <div class="h-4 bg-asphalt-line rounded mb-3 w-2/3"></div>
              <div class="h-8 bg-asphalt-line rounded mb-2 w-1/2"></div>
              <div class="h-3 bg-asphalt-line rounded mb-1 w-full"></div>
              <div class="h-3 bg-asphalt-line rounded mb-4 w-4/5"></div>
              <div class="h-10 bg-asphalt-line rounded w-full"></div>
            </div>
          </div>

          <p class="text-asphalt text-sm mt-6 italic">
            Prijzen worden geladen vanuit ons prijzenoverzicht. Zie je niks? <a href="/contact" class="text-pioneer-red hover:underline">Neem contact op</a> voor de actuele prijzen.
          </p>
        </div>
        {id !== 'taxi' && <SectionDivider class="mt-14 md:mt-20" />}
      </section>
    ))}
  </div>

  <!-- FAQ placeholder -->
  <section class="bg-white py-14 md:py-20">
    <div class="max-w-[1280px] mx-auto px-5 sm:px-8">
      <h2 class="font-display font-bold text-2xl md:text-3xl tracking-tight mb-8">
        Veelgestelde vragen
      </h2>
      <!-- data-todo="faq-content-pending — Mahmood levert de antwoorden aan" -->
      <div class="space-y-4 max-w-2xl">
        {[
          'Zijn examenkosten inbegrepen in het pakket?',
          'Welke betaalmogelijkheden zijn er?',
          'Hoe lang duurt een rijles?',
          'Kan ik mijn pakket uitbreiden met extra lessen?',
          'In welke gebieden rijden jullie?',
        ].map((q) => (
          <details class="group bg-off-white rounded-xl border border-asphalt-line">
            <summary class="flex items-center justify-between gap-4 p-5 cursor-pointer font-semibold text-pioneer-navy list-none">
              {q}
              <svg class="w-4 h-4 text-asphalt flex-shrink-0 transition-transform group-open:rotate-180" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M19 9l-7 7-7-7"/>
              </svg>
            </summary>
            <div class="px-5 pb-5 text-asphalt text-sm leading-relaxed">
              <em class="text-asphalt/60">Antwoord volgt — wordt aangeleverd door Verkeersschool Pioneers.</em>
            </div>
          </details>
        ))}
      </div>
    </div>
  </section>
</Layout>
