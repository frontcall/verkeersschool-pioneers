---
import Layout from '../layouts/Layout.astro';
---

<Layout
  title="Algemene Voorwaarden"
  description="Algemene voorwaarden van Verkeersschool Pioneers."
>
  <section class="hero-bg text-white py-16 md:py-20 relative overflow-hidden">
    <div class="absolute inset-0 pointer-events-none" aria-hidden="true">
      <div class="orb-drift absolute -top-32 right-0 w-[520px] h-[520px] rounded-full" style="filter:blur(90px); background: radial-gradient(circle, rgba(214,40,57,0.45) 0%, transparent 65%);"></div>
    </div>
    <div class="relative z-10 max-w-[1280px] mx-auto px-5 sm:px-8">
      <p class="text-pioneer-red font-semibold text-xs uppercase tracking-[0.18em] mb-4">Juridisch</p>
      <h1 class="font-display font-bold text-4xl md:text-5xl tracking-tight mb-4">Algemene Voorwaarden</h1>
      <p class="text-white/65 text-lg max-w-lg">De volledige algemene voorwaarden van Verkeersschool Pioneers.</p>
    </div>
  </section>

  <section class="py-16 md:py-24">
    <div class="max-w-[800px] mx-auto px-5 sm:px-8">
      <div class="bg-white rounded-2xl border border-asphalt-line p-8 md:p-12 text-center">
        <div class="w-16 h-16 rounded-2xl bg-pioneer-navy/8 flex items-center justify-center mx-auto mb-6">
          <svg class="w-8 h-8 text-pioneer-navy" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
            <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/>
          </svg>
        </div>
        <h2 class="font-display font-bold text-2xl tracking-tight mb-3 text-pioneer-navy">Inhoud volgt binnenkort</h2>
        <p class="text-asphalt max-w-md mx-auto leading-relaxed">De algemene voorwaarden worden hier zo spoedig mogelijk gepubliceerd. Bij vragen kun je contact opnemen via <a href="mailto:info@verkeersschoolpioneers.nl" class="text-pioneer-red hover:underline">info@verkeersschoolpioneers.nl</a>.</p>
      </div>
    </div>
  </section>
</Layout>
