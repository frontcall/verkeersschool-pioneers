---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = 'Verkeersschool Pioneers in Breda — rijlessen voor auto, motor, scooter, vrachtwagen en taxi. Professioneel, persoonlijk en betaalbaar.',
  ogImage = '/og-default.jpg',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://verkeersschoolpioneers.nl');
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{title} | Verkeersschool Pioneers</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={`${title} | Verkeersschool Pioneers`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="nl_NL" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | Verkeersschool Pioneers`} />
    <meta name="twitter:description" content={description} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Structured Data: LocalBusiness -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "AutoDrivingSchool",
        "name": "Verkeersschool Pioneers",
        "url": "https://verkeersschoolpioneers.nl",
        "telephone": "+31643127001",
        "email": "info@rijschoolpioneers.nl",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Breda",
          "addressRegion": "Noord-Brabant",
          "addressCountry": "NL"
        },
        "areaServed": ["Breda","Etten-Leur","Roosendaal","Oosterhout","Rijsbergen","Zevenbergen","Chaam","Terheijden","Oudenbosch","Rijen"],
        "priceRange": "€€",
        "openingHours": "Mo-Su 08:00-21:00",
        "sameAs": [
          "https://wa.me/31643127001"
        ]
      }
    </script>
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <WhatsAppButton />

    <script>
      // Enable reveal animations and observe scroll items
      document.documentElement.classList.add('js-ready');

      function initReveal() {
        const items = document.querySelectorAll<HTMLElement>('.reveal-item:not(.is-revealed)');
        if (!items.length) return;
        const obs = new IntersectionObserver(
          (entries) => entries.forEach(e => {
            if (e.isIntersecting) {
              e.target.classList.add('is-revealed');
              obs.unobserve(e.target);
            }
          }),
          { threshold: 0.07, rootMargin: '0px 0px -24px 0px' }
        );
        items.forEach(el => obs.observe(el));
      }

      initReveal();
    </script>
  </body>
</html>
