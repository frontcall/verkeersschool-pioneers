---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import WhatsAppButton from '../components/WhatsAppButton.astro';
import RouteLine from '../components/RouteLine.astro';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
}

const {
  title,
  description = 'Verkeersschool Pioneers in Breda — rijlessen voor auto, motor, scooter, vrachtwagen en taxi. Professioneel, persoonlijk en betaalbaar.',
  ogImage = '/og-default.jpg',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site || 'https://verkeersschoolpioneers.nl');
---

<!doctype html>
<html lang="nl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover" />
    <meta name="generator" content={Astro.generator} />

    <!-- SEO -->
    <title>{title} | Verkeersschool Pioneers</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={`${title} | Verkeersschool Pioneers`} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="nl_NL" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} | Verkeersschool Pioneers`} />
    <meta name="twitter:description" content={description} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@400;500;600;700&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500;600&display=swap"
      rel="stylesheet"
    />

    <!-- Structured Data: LocalBusiness -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "AutoDrivingSchool",
        "name": "Verkeersschool Pioneers",
        "url": "https://verkeersschoolpioneers.nl",
        "telephone": "+31643127001",
        "email": "info@verkeersschoolpioneers.nl",
        "address": {
          "@type": "PostalAddress",
          "addressLocality": "Breda",
          "addressRegion": "Noord-Brabant",
          "addressCountry": "NL"
        },
        "areaServed": ["Breda","Etten-Leur","Roosendaal","Oosterhout","Rijsbergen","Zevenbergen","Chaam","Terheijden","Oudenbosch","Rijen"],
        "priceRange": "€€",
        "openingHours": "Mo-Su 08:00-21:00",
        "sameAs": [
          "https://wa.me/31643127001"
        ]
      }
    </script>
  </head>
  <body>
    <Header />
    <RouteLine />
    <main>
      <slot />
    </main>
    <Footer />
    <WhatsAppButton />

    <script>
      // Enable reveal animations and observe scroll items
      document.documentElement.classList.add('js-ready');

      function initReveal() {
        const items = document.querySelectorAll<HTMLElement>('.reveal-item:not(.is-revealed)');
        if (!items.length) return;
        const obs = new IntersectionObserver(
          (entries) => entries.forEach(e => {
            if (e.isIntersecting) {
              e.target.classList.add('is-revealed');
              obs.unobserve(e.target);
            }
          }),
          { threshold: 0.07, rootMargin: '0px 0px -24px 0px' }
        );
        items.forEach(el => obs.observe(el));
      }

      initReveal();

      // ── AMBIENT ORB INJECTION ──
      // Injects large blurred depth-glow orbs into every non-hero section
      (function injectSectionOrbs() {
        const sections = document.querySelectorAll<HTMLElement>('main section:not(.hero-bg)');

        const orbPairs = [
          // [posKey, posVal, size, color, blur, mouseSpeed]
          [
            { top: '-200px', right: '-140px', width: '560px', height: '560px',
              background: 'radial-gradient(circle, rgba(214,40,57,0.16) 0%, transparent 65%)', filter: 'blur(95px)' },
            { bottom: '-170px', left: '-110px', width: '480px', height: '480px',
              background: 'radial-gradient(circle, rgba(22,35,63,0.11) 0%, transparent 65%)', filter: 'blur(85px)' },
          ],
          [
            { top: '-180px', left: '-130px', width: '520px', height: '520px',
              background: 'radial-gradient(circle, rgba(22,35,63,0.12) 0%, transparent 65%)', filter: 'blur(90px)' },
            { bottom: '-160px', right: '-120px', width: '460px', height: '460px',
              background: 'radial-gradient(circle, rgba(214,40,57,0.15) 0%, transparent 65%)', filter: 'blur(85px)' },
          ],
        ];

        sections.forEach((section, i) => {
          if (getComputedStyle(section).position === 'static') {
            section.style.position = 'relative';
          }
          section.style.overflow = 'hidden';

          const pair = orbPairs[i % 2];

          pair.forEach((styles, j) => {
            const orb = document.createElement('div');
            orb.setAttribute('aria-hidden', 'true');
            Object.assign(orb.style, {
              position: 'absolute',
              borderRadius: '50%',
              pointerEvents: 'none',
              zIndex: '0',
              willChange: 'transform',
              transition: 'transform 1.4s cubic-bezier(0.16, 1, 0.3, 1)',
              ...styles,
            });
            orb.dataset.mouseSpeed = String(j === 0 ? 14 : 20);
            if (j === 0) section.insertBefore(orb, section.firstChild);
            else section.appendChild(orb);
          });

          // Lift real content above orbs
          Array.from(section.children).forEach(child => {
            const el = child as HTMLElement;
            if (!el.hasAttribute('aria-hidden') && getComputedStyle(el).position === 'static') {
              el.style.position = 'relative';
              el.style.zIndex = '1';
            }
          });
        });
      })();

      // ── MOUSE PARALLAX ──
      // Orbs with [data-mouse-speed] drift gently toward the cursor
      document.addEventListener('mousemove', (e: MouseEvent) => {
        const rx = e.clientX / window.innerWidth  - 0.5;
        const ry = e.clientY / window.innerHeight - 0.5;
        document.querySelectorAll<HTMLElement>('[data-mouse-speed]').forEach(orb => {
          const s = parseFloat(orb.dataset.mouseSpeed!);
          orb.style.transform = `translate(${rx * s}px, ${ry * s}px)`;
        });
      }, { passive: true });
    </script>
  </body>
</html>
