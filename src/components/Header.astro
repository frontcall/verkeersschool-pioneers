---
const pathname = Astro.url.pathname;
const isActive = (path: string) =>
  path === '/' ? pathname === '/' : pathname.startsWith(path);

const navItems = [
  { href: '/', label: 'Home' },
  { href: '/pakketten', label: 'Pakketten & Prijzen' },
  { href: '/over-ons', label: 'Over ons' },
  { href: '/reviews', label: 'Reviews' },
  { href: '/contact', label: 'Contact' },
];
---

<!-- Safe-area fill: vult de statusbalk/notch-zone op iOS -->
<div class="fixed top-0 left-0 right-0 bg-off-white z-[51]" style="height: env(safe-area-inset-top);"></div>

<header
  id="site-header"
  class="fixed left-0 right-0 z-50 bg-off-white border-b border-asphalt-line transition-all duration-300"
  style="top: env(safe-area-inset-top);"
>
  <div class="max-w-[1280px] mx-auto px-5 sm:px-8">
    <div class="flex items-center justify-between h-20 md:h-24">

      <!-- Logo — wit logo op witte balk, geen extra achtergrond nodig -->
      <a
        href="/"
        class="flex-shrink-0"
        aria-label="Verkeersschool Pioneers — naar de homepage"
      >
        <img
          src="/logo.jpg"
          alt="Verkeersschool Pioneers"
          class="w-52 md:w-64 h-auto object-contain"
        />
      </a>

      <!-- Desktop nav -->
      <nav class="hidden lg:flex items-center gap-1" aria-label="Hoofdnavigatie">
        {navItems.map(({ href, label, cta }) => (
          cta ? (
            <a
              href={href}
              class:list={[
                'ml-1 px-4 py-2 rounded-md text-sm font-semibold transition-all duration-150',
                isActive(href)
                  ? 'bg-pioneer-red text-white'
                  : 'text-pioneer-red border border-pioneer-red/30 hover:bg-pioneer-red hover:text-white hover:border-pioneer-red',
              ]}
              aria-current={isActive(href) ? 'page' : undefined}
            >
              {label}
            </a>
          ) : (
            <a
              href={href}
              class:list={[
                'px-4 py-2 rounded-md text-sm font-medium transition-colors duration-150',
                isActive(href)
                  ? 'text-pioneer-navy bg-pioneer-navy/8 font-semibold'
                  : 'text-asphalt hover:text-pioneer-navy hover:bg-pioneer-navy/5',
              ]}
              aria-current={isActive(href) ? 'page' : undefined}
            >
              {label}
            </a>
          )
        ))}
      </nav>

      <!-- Desktop CTA -->
      <div class="hidden lg:flex items-center gap-3">
        <a
          href="https://wa.me/31643127001?text=Hallo!%20Ik%20wil%20graag%20een%20gratis%20proefles%20plannen."
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 px-5 py-2.5 rounded-lg border-2 border-pioneer-red text-pioneer-red text-sm font-semibold transition-all duration-150 hover:bg-pioneer-red hover:text-white"
        >
          Proefles Inplannen
        </a>
      </div>

      <!-- Mobile hamburger -->
      <button
        id="menu-toggle"
        type="button"
        aria-expanded="false"
        aria-controls="mobile-menu"
        aria-label="Menu openen"
        class="lg:hidden flex flex-col justify-center items-center w-11 h-11 rounded-lg text-pioneer-navy hover:bg-pioneer-navy/5 transition-colors"
      >
        <span id="hamburger-icon" class="flex flex-col gap-1.5" aria-hidden="true">
          <span class="block w-5 h-0.5 bg-pioneer-navy transition-all duration-200 origin-center" id="bar1"></span>
          <span class="block w-5 h-0.5 bg-pioneer-navy transition-all duration-200" id="bar2"></span>
          <span class="block w-5 h-0.5 bg-pioneer-navy transition-all duration-200 origin-center" id="bar3"></span>
        </span>
      </button>
    </div>
  </div>
</header>

<!-- Mobile menu overlay -->
<div
  id="menu-overlay"
  class="fixed inset-0 z-40 bg-pioneer-navy/60 backdrop-blur-sm opacity-0 pointer-events-none transition-opacity duration-300 lg:hidden"
  aria-hidden="true"
></div>

<!-- Mobile menu panel -->
<nav
  id="mobile-menu"
  class="fixed top-0 right-0 bottom-0 z-50 w-72 bg-off-white border-l border-asphalt-line translate-x-full transition-transform duration-300 ease-in-out lg:hidden flex flex-col"
  aria-label="Mobiele navigatie"
>
  <div class="flex items-center justify-between p-5 border-b border-asphalt-line">
    <img
      src="/logo.jpg"
      alt="Verkeersschool Pioneers"
      class="h-9 w-auto object-contain"
    />
    <button
      id="menu-close"
      type="button"
      aria-label="Menu sluiten"
      class="flex items-center justify-center w-10 h-10 rounded-lg text-asphalt hover:text-pioneer-navy hover:bg-pioneer-navy/5 transition-colors"
    >
      <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
        <path stroke-linecap="round" stroke-linejoin="round" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>
  </div>

  <div class="flex-1 overflow-y-auto py-4 px-3">
    {navItems.map(({ href, label }) => (
      <a
        href={href}
        class:list={[
          'flex items-center min-h-[52px] px-4 py-3 rounded-lg text-base font-medium mb-1 transition-colors',
          isActive(href)
            ? 'text-pioneer-navy bg-pioneer-navy/8 font-semibold'
            : 'text-asphalt hover:text-pioneer-navy hover:bg-pioneer-navy/5',
        ]}
        aria-current={isActive(href) ? 'page' : undefined}
      >
        {label}
      </a>
    ))}
  </div>

  <div class="p-4 border-t border-asphalt-line">
    <a
      href="https://wa.me/31643127001?text=Hallo!%20Ik%20wil%20graag%20een%20gratis%20proefles%20plannen."
      target="_blank"
      rel="noopener noreferrer"
      class="flex items-center justify-center gap-2 w-full py-3.5 rounded-lg border-2 border-pioneer-red text-pioneer-red font-semibold transition-colors hover:bg-pioneer-red hover:text-white"
    >
      Proefles Inplannen
    </a>
  </div>
</nav>

<!-- Spacer — hoogte gelijk aan header inclusief safe area -->
<div class="h-20 md:h-24 lg:h-28" style="padding-top: env(safe-area-inset-top);"></div>

<script>
  const header = document.getElementById('site-header')!;
  const toggle = document.getElementById('menu-toggle')!;
  const closeBtn = document.getElementById('menu-close')!;
  const menu = document.getElementById('mobile-menu')!;
  const overlay = document.getElementById('menu-overlay')!;
  const bar1 = document.getElementById('bar1')!;
  const bar2 = document.getElementById('bar2')!;
  const bar3 = document.getElementById('bar3')!;

  // Versterkte schaduw bij scrollen
  const updateHeader = () => {
    if (window.scrollY > 8) {
      header.classList.add('shadow-md');
    } else {
      header.classList.remove('shadow-md');
    }
  };
  window.addEventListener('scroll', updateHeader, { passive: true });
  updateHeader();

  function openMenu() {
    menu.classList.replace('translate-x-full', 'translate-x-0');
    overlay.classList.remove('opacity-0', 'pointer-events-none');
    toggle.setAttribute('aria-expanded', 'true');
    toggle.setAttribute('aria-label', 'Menu sluiten');
    bar1.style.transform = 'rotate(45deg) translate(3px, 3px)';
    bar2.style.opacity = '0';
    bar3.style.transform = 'rotate(-45deg) translate(3px, -3px)';
    document.body.style.overflow = 'hidden';
  }

  function closeMenu() {
    menu.classList.replace('translate-x-0', 'translate-x-full');
    overlay.classList.add('opacity-0', 'pointer-events-none');
    toggle.setAttribute('aria-expanded', 'false');
    toggle.setAttribute('aria-label', 'Menu openen');
    bar1.style.transform = '';
    bar2.style.opacity = '1';
    bar3.style.transform = '';
    document.body.style.overflow = '';
  }

  toggle.addEventListener('click', () => {
    const isOpen = toggle.getAttribute('aria-expanded') === 'true';
    isOpen ? closeMenu() : openMenu();
  });

  closeBtn.addEventListener('click', closeMenu);
  overlay.addEventListener('click', closeMenu);
  menu.querySelectorAll('a').forEach(link => link.addEventListener('click', closeMenu));

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && toggle.getAttribute('aria-expanded') === 'true') {
      closeMenu();
      toggle.focus();
    }
  });
</script>
