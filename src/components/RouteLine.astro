---
// Route-lijn signatuurelement
// A scroll-driven SVG road path that draws itself as the user scrolls.
// Visible on xl+ screens as a fixed left-side decoration.
---

<div
  id="route-line-wrap"
  class="fixed left-0 top-0 bottom-0 w-16 z-20 pointer-events-none hidden xl:block"
  aria-hidden="true"
>
  <svg
    id="route-svg"
    viewBox="0 0 64 800"
    preserveAspectRatio="xMidYMid meet"
    class="absolute inset-0 w-full h-full"
    xmlns="http://www.w3.org/2000/svg"
  >
    <defs>
      <linearGradient id="rl-grad" x1="0" y1="0" x2="0" y2="1">
        <stop offset="0%"   stop-color="#1E3358" stop-opacity="0.25"/>
        <stop offset="50%"  stop-color="#2A4374" stop-opacity="0.40"/>
        <stop offset="100%" stop-color="#D62839" stop-opacity="0.55"/>
      </linearGradient>
      <filter id="rl-glow" x="-100%" y="-20%" width="300%" height="140%">
        <feGaussianBlur stdDeviation="2.5" result="blur"/>
        <feMerge><feMergeNode in="blur"/><feMergeNode in="SourceGraphic"/></feMerge>
      </filter>
    </defs>

    <!-- Faint track (always visible) -->
    <path
      id="rl-track"
      d="M32,0 C20,100 44,150 32,250 C20,350 44,400 32,500 C20,600 44,650 32,800"
      fill="none"
      stroke="#1E3358"
      stroke-width="2"
      stroke-opacity="0.06"
      stroke-linecap="round"
    />

    <!-- Animated draw-on path -->
    <path
      id="rl-path"
      d="M32,0 C20,100 44,150 32,250 C20,350 44,400 32,500 C20,600 44,650 32,800"
      fill="none"
      stroke="url(#rl-grad)"
      stroke-width="2.5"
      stroke-linecap="round"
      filter="url(#rl-glow)"
      style="will-change: stroke-dashoffset;"
    />

    <!-- Waypoint dots -->
    <g id="rl-dots" opacity="0">
      <circle cx="32" cy="0"   r="3.5" fill="#1E3358" opacity="0.3"/>
      <circle cx="32" cy="250" r="3.5" fill="#2A4374" opacity="0"/>
      <circle cx="32" cy="500" r="3.5" fill="#2A4374" opacity="0"/>
      <circle cx="32" cy="800" r="3.5" fill="#D62839" opacity="0"/>
    </g>

    <!-- Travelling dot (tip of the drawn line) -->
    <circle id="rl-tip" cx="32" cy="0" r="4" fill="#D62839" opacity="0" filter="url(#rl-glow)"/>
  </svg>
</div>

<script>
(function () {
  const path   = document.getElementById('rl-path')    as SVGPathElement | null;
  const tip    = document.getElementById('rl-tip')     as SVGCircleElement | null;
  const dots   = document.getElementById('rl-dots')    as SVGGElement | null;
  const wrap   = document.getElementById('route-line-wrap');
  if (!path || !tip || !dots || !wrap) return;

  // Only activate on xl+ (1280px)
  const mq = window.matchMedia('(min-width: 1280px)');
  if (!mq.matches) return;

  const totalLen = path.getTotalLength();
  path.style.strokeDasharray  = String(totalLen);
  path.style.strokeDashoffset = String(totalLen);

  const dotEls = dots.querySelectorAll<SVGCircleElement>('circle');
  dots.setAttribute('opacity', '1');

  const tick = () => {
    const docH = document.documentElement.scrollHeight - window.innerHeight;
    const ratio = docH > 0 ? Math.min(window.scrollY / docH, 1) : 0;

    // Draw the line
    const drawn = ratio * totalLen;
    path.style.strokeDashoffset = String(totalLen - drawn);

    // Move the tip dot
    const pt = path.getPointAtLength(drawn);
    tip.setAttribute('cx', String(pt.x));
    tip.setAttribute('cy', String(pt.y));
    tip.setAttribute('opacity', drawn > 10 ? '1' : '0');

    // Reveal waypoint dots as user passes them
    dotEls.forEach(dot => {
      const cy = parseFloat(dot.getAttribute('cy') || '0');
      const dotRatio = cy / 800;          // 800 = viewBox height
      const appeared = ratio >= dotRatio - 0.02;
      dot.setAttribute('opacity', appeared ? '0.55' : '0');
    });
  };

  window.addEventListener('scroll', tick, { passive: true });
  tick();
})();
</script>
