# Kopieer dit bestand naar `.env` en vul de echte waarden in.
# `.env` staat in .gitignore — nooit committen.
# Dezelfde waarden ook instellen op Netlify → Site settings → Environment variables.

# ── Edward (SEO content tool) ─────────────────────────────────────────────
# Signing secret voor de blog-webhook op /api/edward-webhook.
# Moet exact overeenkomen met het secret dat in Edward is ingesteld.
EDWARD_WEBHOOK_SECRET=whsec_replace_me

# Absolute site-URL, gebruikt om post_url in de webhook-response te bouwen.
EDWARD_SITE_URL=https://verkeersschoolpioneers.nl

# Optioneel — alleen nodig voor het verouderde /.netlify/functions/edward-publish
# endpoint (statische sleutel-auth). Laat leeg om dat endpoint dicht te houden.
# EDWARD_KEY=

# ── Google Sheets ─────────────────────────────────────────────────────────
# Google Sheet CSV URL — Prijzen
# Kopieer uit Bestand → Delen → Publiceren op internet → CSV (gid van het prijzen-tabblad)
PUBLIC_PRICING_SHEET_URL=https://docs.google.com/spreadsheets/d/e/2PACX-1vStrLqZP2MU6OqwVJxMl-FRGcra88ZoBKDc4YneREvkscFLSBtxsgQFjJvAlE-d_K4sxdl-3kKr9tzL/pub?gid=1809349212&single=true&output=csv

# Google Sheet CSV URL — Vacatures
PUBLIC_VACATURES_SHEET_URL=https://docs.google.com/spreadsheets/d/e/2PACX-1vStrLqZP2MU6OqwVJxMl-FRGcra88ZoBKDc4YneREvkscFLSBtxsgQFjJvAlE-d_K4sxdl-3kKr9tzL/pub?gid=540205886&single=true&output=csv
